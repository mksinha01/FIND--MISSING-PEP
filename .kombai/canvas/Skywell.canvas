    "var_ff9d62b4627a": {
      "type": "variant",
      "label": "dashboards_ios_22",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 430,
        "h": 932
      },
      "html": "<style>\n    :root {\n    --accent: #0f8a6a;\n    --accent-deep: #0a5f4c;\n    --accent-soft: #def9ef;\n    --ink: #0f211a;\n    --ink-2: #385248;\n    --muted: #758f85;\n    --line: #e5eeeb;\n    --line-strong: #d3deda;\n    --surface: #ffffff;\n    --page: #f9fcfb;\n    --r-card: 18px;\n    --r-pill: 999px;\n    --shadow-card: 0 1px 2px rgba(15, 33, 26, .04), 0 8px 24px -18px rgba(15, 33, 26, .22);\n    --shadow-banner: 0 14px 32px -20px rgba(10, 95, 76, .55);\n    --ease: cubic-bezier(.16, 1, .3, 1);\n    --font: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  .device,\n  .device * {\n    box-sizing: border-box;\n  }\n\n  .device {\n    flex: 0 0 430px;\n    width: 430px;\n    height: 932px;\n    overflow: hidden;\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    background: var(--page);\n    border: 0;\n    border-radius: 0;\n    box-shadow: none;\n    color: var(--ink);\n    font-family: var(--font);\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .statusbar {\n    height: 54px;\n    flex: 0 0 54px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 14px 30px 0 34px;\n  }\n\n  .sb-time {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n    color: var(--ink);\n    font-size: 17px;\n    font-weight: 640;\n    letter-spacing: -.2px;\n  }\n\n  .sb-right {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .appbar {\n    flex: 0 0 auto;\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    padding: 6px 20px 14px;\n  }\n\n  .avatar {\n    width: 36px;\n    height: 36px;\n    flex: 0 0 36px;\n    position: relative;\n    overflow: hidden;\n    border-radius: 11px;\n    background: linear-gradient(150deg, #dbeae5, #bed8ce);\n    box-shadow: 0 0 0 2px var(--accent), 0 0 0 3px rgba(255, 255, 255, .9);\n  }\n\n  .avatar img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .appbar h1 {\n    flex: 1 1 auto;\n    margin: 0;\n    text-align: center;\n    font-size: 21px;\n    font-weight: 700;\n    letter-spacing: -.45px;\n  }\n\n  .appbar-actions {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    flex: 0 0 auto;\n  }\n\n  .icon-btn {\n    width: 32px;\n    height: 32px;\n    padding: 0;\n    display: grid;\n    place-items: center;\n    border: 0;\n    border-radius: var(--r-pill);\n    background: none;\n    color: var(--ink);\n    cursor: pointer;\n    transition: transform .35s var(--ease), background-color .35s var(--ease);\n  }\n\n  .icon-btn:hover {\n    background: rgba(15, 33, 26, .05);\n    transform: translateY(-1px);\n  }\n\n  .icon-btn:active {\n    transform: scale(.94);\n  }\n\n  .tabs {\n    flex: 0 0 auto;\n    display: flex;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .tab {\n    flex: 1 1 0;\n    min-width: 0;\n    position: relative;\n    padding: 10px 0 13px;\n    border: 0;\n    background: none;\n    color: var(--muted);\n    cursor: pointer;\n    font-family: inherit;\n    font-size: 19px;\n    font-weight: 600;\n    letter-spacing: -.3px;\n    transition: color .35s var(--ease);\n  }\n\n  .tab.is-active {\n    color: var(--ink);\n    font-weight: 700;\n  }\n\n  .tab.is-active::after {\n    content: \"\";\n    position: absolute;\n    left: 14%;\n    right: 14%;\n    bottom: -1px;\n    height: 3px;\n    border-radius: 3px 3px 0 0;\n    background: var(--accent);\n  }\n\n  .tab:hover {\n    color: var(--ink-2);\n  }\n\n  .screen {\n    flex: 1 1 auto;\n    min-height: 0;\n    overflow-x: hidden;\n    overflow-y: auto;\n    display: flex;\n    flex-direction: column;\n    padding: 20px 24px 0;\n  }\n\n  .focus {\n    padding: 16px 18px 14px;\n    border: 1px solid var(--line-strong);\n    border-radius: var(--r-card);\n    background: var(--surface);\n    box-shadow: var(--shadow-card);\n  }\n\n  .focus-top {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n  }\n\n  .focus-label {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    color: var(--ink-2);\n    font-size: 14px;\n    font-weight: 560;\n    letter-spacing: -.1px;\n  }\n\n  .focus h2 {\n    margin: 5px 0 0;\n    font-size: 26px;\n    font-weight: 760;\n    letter-spacing: -.7px;\n    line-height: 1.1;\n  }\n\n  .focus .icon-btn {\n    margin: -4px -6px 0 auto;\n    color: var(--ink-2);\n  }\n\n  .track {\n    height: 6px;\n    margin: 16px 0 12px;\n    border-radius: 3px;\n    background-image: repeating-linear-gradient(to right, var(--line-strong) 0 12px, transparent 12px 18px);\n  }\n\n  .focus-meta {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    font-size: 14px;\n  }\n\n  .focus-meta .left {\n    color: var(--muted);\n    font-weight: 500;\n  }\n\n  .focus-meta .right {\n    color: var(--ink);\n    font-weight: 700;\n    letter-spacing: -.2px;\n  }\n\n  .recap {\n    position: relative;\n    overflow: hidden;\n    height: 96px;\n    flex: 0 0 96px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-top: 18px;\n    padding: 0 20px;\n    isolation: isolate;\n    border-radius: 14px;\n    background: linear-gradient(105deg, #05372c 0%, #07463800 60%), #063a2e;\n    box-shadow: var(--shadow-banner);\n    color: #fff;\n  }\n\n  .recap-art {\n    position: absolute;\n    z-index: -2;\n    inset: 0;\n    display: block;\n    width: 100%;\n    height: 100%;\n  }\n\n  .recap::after {\n    content: \"\";\n    position: absolute;\n    z-index: -1;\n    inset: 0;\n    background-image: radial-gradient(rgba(255, 255, 255, .11) .6px, transparent .7px), radial-gradient(rgba(0, 0, 0, .13) .6px, transparent .7px);\n    background-position: 0 0, 2px 3px;\n    background-size: 4px 4px, 5px 5px;\n    mix-blend-mode: overlay;\n  }\n\n  .recap-veil {\n    position: absolute;\n    z-index: -1;\n    inset: 0;\n    background: linear-gradient(96deg, rgba(4, 42, 33, .94) 6%, rgba(4, 42, 33, .55) 40%, rgba(4, 42, 33, 0) 66%);\n  }\n\n  .recap-copy h3 {\n    margin: 0;\n    font-size: 23px;\n    font-weight: 760;\n    letter-spacing: -.6px;\n    text-shadow: 0 1px 12px rgba(3, 34, 27, .35);\n  }\n\n  .recap-copy p {\n    margin: 3px 0 0;\n    color: rgba(255, 255, 255, .92);\n    font-size: 14px;\n    font-weight: 640;\n    letter-spacing: -.1px;\n  }\n\n  .play {\n    width: 50px;\n    height: 50px;\n    flex: 0 0 50px;\n    display: grid;\n    place-items: center;\n    border: 0;\n    border-radius: var(--r-pill);\n    background: #fff;\n    color: #083b30;\n    cursor: pointer;\n    box-shadow: 0 6px 18px -8px rgba(3, 34, 27, .6);\n    transition: transform .4s var(--ease);\n  }\n\n  .play:hover {\n    transform: scale(1.05);\n  }\n\n  .play:active {\n    transform: scale(.95);\n  }\n\n  .chip-row {\n    margin-top: 20px;\n  }\n\n  .chip {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 8px 18px 8px 14px;\n    border: 1.5px solid var(--accent);\n    border-radius: var(--r-pill);\n    background: var(--surface);\n    color: var(--accent);\n    cursor: pointer;\n    font-family: inherit;\n    font-size: 16px;\n    font-weight: 640;\n    letter-spacing: -.2px;\n    transition: background-color .35s var(--ease), transform .35s var(--ease);\n  }\n\n  .chip:hover {\n    background: var(--accent-soft);\n  }\n\n  .chip:active {\n    transform: scale(.97);\n  }\n\n  .week-title {\n    margin: 20px 0 0;\n    font-size: 22px;\n    font-weight: 760;\n    letter-spacing: -.55px;\n  }\n\n  .stats {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 12px;\n    margin-top: 14px;\n  }\n\n  .stat dt {\n    color: var(--muted);\n    font-size: 14px;\n    font-weight: 520;\n    letter-spacing: -.1px;\n  }\n\n  .stat dd {\n    margin: 4px 0 0;\n    font-size: 22px;\n    font-weight: 740;\n    letter-spacing: -.6px;\n  }\n\n  .chart-label {\n    margin: 22px 0 6px;\n    color: var(--ink-2);\n    font-size: 14px;\n    font-weight: 520;\n  }\n\n  .chart {\n    display: block;\n    width: 100%;\n    height: 132px;\n  }\n\n  .grid-line {\n    stroke: var(--line);\n    stroke-width: 1;\n  }\n\n  .axis-line {\n    stroke: var(--line-strong);\n    stroke-width: 1;\n  }\n\n  .now-line {\n    stroke: #253f35;\n    stroke-width: 2;\n  }\n\n  .series {\n    fill: none;\n    stroke: var(--accent);\n    stroke-width: 2.4;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .series-fill {\n    fill: rgba(15, 138, 106, .16);\n  }\n\n  .dot {\n    fill: var(--surface);\n    stroke: var(--accent);\n    stroke-width: 2.2;\n  }\n\n  .dot-now {\n    fill: var(--accent);\n    stroke: none;\n  }\n\n  .dot-now-halo {\n    fill: rgba(15, 138, 106, .22);\n  }\n\n  .y-label {\n    fill: var(--ink-2);\n    font-family: var(--font);\n    font-size: 12.5px;\n    font-weight: 560;\n  }\n\n  .x-label {\n    fill: var(--muted);\n    font-family: var(--font);\n    font-size: 12.5px;\n    font-weight: 600;\n    letter-spacing: .4px;\n  }\n\n  .cta {\n    display: block;\n    width: 100%;\n    margin-top: 8px;\n    margin-bottom: 14px;\n    padding: 15px 0;\n    border: 0;\n    border-radius: var(--r-pill);\n    background: var(--accent);\n    color: #fff;\n    cursor: pointer;\n    font-family: inherit;\n    font-size: 17px;\n    font-weight: 700;\n    letter-spacing: -.25px;\n    box-shadow: 0 10px 24px -14px rgba(10, 95, 76, .85);\n    transition: transform .4s var(--ease), background-color .4s var(--ease);\n  }\n\n  .cta:hover {\n    background: var(--accent-deep);\n    transform: translateY(-1px);\n  }\n\n  .cta:active {\n    transform: translateY(0) scale(.99);\n  }\n\n  .tabbar {\n    flex: 0 0 auto;\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    padding: 10px 6px 8px;\n    border-top: 1px solid var(--line);\n    background: rgba(249, 252, 251, .86);\n    backdrop-filter: saturate(180%) blur(18px);\n    -webkit-backdrop-filter: saturate(180%) blur(18px);\n  }\n\n  .nav {\n    display: flex;\n    align-items: center;\n    flex-direction: column;\n    gap: 5px;\n    padding: 0;\n    border: 0;\n    background: none;\n    color: var(--ink);\n    cursor: pointer;\n    font-family: inherit;\n    font-size: 12.5px;\n    font-weight: 620;\n    letter-spacing: -.1px;\n    transition: transform .35s var(--ease), color .35s var(--ease);\n  }\n\n  .nav:hover {\n    transform: translateY(-1px);\n  }\n\n  .nav-ico {\n    position: relative;\n    height: 28px;\n    display: grid;\n    place-items: center;\n  }\n\n  .nav.is-active {\n    color: var(--accent);\n  }\n\n  .badge {\n    position: absolute;\n    top: -4px;\n    right: -11px;\n    min-width: 19px;\n    height: 19px;\n    padding: 0 5px;\n    border-radius: var(--r-pill);\n    background: #c2452f;\n    color: #fff;\n    font-size: 11.5px;\n    font-weight: 700;\n    line-height: 19px;\n    text-align: center;\n    box-shadow: 0 0 0 2px var(--page);\n  }\n\n  .home-indicator {\n    flex: 0 0 22px;\n    display: grid;\n    place-items: center;\n    background: rgba(249, 252, 251, .86);\n  }\n\n  .home-indicator span {\n    display: block;\n    width: 140px;\n    height: 5px;\n    border-radius: 3px;\n    background: #0c221a;\n    opacity: .85;\n  }\n</style>\n<div class=\"device\" data-kid=\"1\" data-name=\"device screen wrapper\">\n    <div class=\"statusbar\" data-kid=\"1-1\" data-name=\"status bar\">\n        <div class=\"sb-time\" data-kid=\"1-1-1\" data-name=\"time display\">\n            9:41\n            <svg aria-hidden=\"true\" data-kid=\"1-1-1-1\" data-name=\"arrow icon\" fill=\"currentColor\" height=\"13\" viewbox=\"0 0 24 24\" width=\"13\">\n                <path d=\"M21.3 2.7 2.9 10.4c-1 .4-.9 1.9.2 2.1l7 1.6 1.6 7c.2 1.1 1.7 1.2 2.1.2l7.7-18.4c.4-.8-.4-1.6-1.2-1.2z\">\n                </path>\n            </svg>\n        </div>\n        <div class=\"sb-right\" data-kid=\"1-1-2\" data-name=\"network and status icons\">\n            <svg aria-hidden=\"true\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\" fill=\"currentColor\" height=\"12\" viewbox=\"0 0 18 12\" width=\"18\">\n                <rect height=\"4\" rx=\"1\" width=\"3\" x=\"0\" y=\"8\">\n                </rect>\n                <rect height=\"6.5\" rx=\"1\" width=\"3\" x=\"5\" y=\"5.5\">\n                </rect>\n                <rect height=\"9\" rx=\"1\" width=\"3\" x=\"10\" y=\"3\">\n                </rect>\n                <rect height=\"12\" rx=\"1\" width=\"3\" x=\"15\" y=\"0\">\n                </rect>\n            </svg>\n            <svg aria-hidden=\"true\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon\" fill=\"currentColor\" height=\"12\" viewbox=\"0 0 17 12\" width=\"17\">\n                <path d=\"M8.5 11.6 6.3 9.1a3.3 3.3 0 0 1 4.4 0l-2.2 2.5zM4.4 7 2.9 5.3a8.4 8.4 0 0 1 11.2 0L12.6 7a6.2 6.2 0 0 0-8.2 0zM1.2 3.4-.2 1.8a12.7 12.7 0 0 1 17.4 0l-1.4 1.6a10.6 10.6 0 0 0-14.6 0z\">\n                </path>\n            </svg>\n            <svg aria-hidden=\"true\" data-kid=\"1-1-2-3\" data-name=\"battery charge icon\" height=\"13\" viewbox=\"0 0 26 13\" width=\"26\">\n                <rect fill=\"none\" height=\"11.8\" rx=\"3.6\" stroke=\"currentColor\" stroke-opacity=\".38\" stroke-width=\"1.1\" width=\"21.5\" x=\".6\" y=\".6\">\n                </rect>\n                <rect fill=\"currentColor\" height=\"8.6\" rx=\"2.3\" width=\"18.3\" x=\"2.2\" y=\"2.2\">\n                </rect>\n                <path d=\"M23.6 4.3c1.3.4 1.3 4 0 4.4V4.3z\" fill=\"currentColor\" fill-opacity=\".45\">\n                </path>\n            </svg>\n        </div>\n    </div>\n    <header class=\"appbar\" data-kid=\"1-2\" data-name=\"application header\">\n        <div class=\"avatar\" data-kid=\"1-2-1\" data-name=\"user profile avatar container\">\n            <img alt=\"Portrait by Thanh Xuan Nguyen Ly on Pexels\" data-kid=\"1-2-1-1\" data-name=\"user profile image\" decoding=\"async\" height=\"200\" loading=\"lazy\" src=\"https://images.pexels.com/photos/20051635/pexels-photo-20051635.jpeg?auto=compress&cs=tinysrgb&w=200&q=80\" width=\"200\"/>\n        </div>\n        <h1 data-kid=\"1-2-2\" data-name=\"application title header\">\n            Overview\n        </h1>\n        <div class=\"appbar-actions\" data-kid=\"1-2-3\" data-name=\"application actions container\">\n            <button aria-label=\"Add a session\" class=\"icon-btn\" data-kid=\"1-2-3-1\" data-name=\"add session button\">\n                <svg data-kid=\"1-2-3-1-1\" data-name=\"plus sign icon\" fill=\"none\" height=\"27\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"27\">\n                    <circle cx=\"12\" cy=\"12\" r=\"9.2\">\n                    </circle>\n                    <path d=\"M12 7.6v8.8M7.6 12h8.8\">\n                    </path>\n                </svg>\n            </button>\n            <button aria-label=\"Settings\" class=\"icon-btn\" data-kid=\"1-2-3-2\" data-name=\"settings button\">\n                <svg data-kid=\"1-2-3-2-1\" data-name=\"gear settings icon\" fill=\"none\" height=\"26\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"26\">\n                    <path d=\"M12 15.1a3.1 3.1 0 1 0 0-6.2 3.1 3.1 0 0 0 0 6.2z\">\n                    </path>\n                    <path d=\"m19.5 13.6.1-1.6-.1-1.6 1.7-1.3-1.6-2.8-2 .7-2.7-1.6L14.5 3h-3.2l-.4 2.4-2.7 1.6-2-.7-1.6 2.8 1.7 1.3-.1 1.6.1 1.6-1.7 1.3 1.6 2.8 2-.7 2.7 1.6.4 2.4h3.2l.4-2.4 2.7-1.6 2 .7 1.6-2.8-1.7-1.3z\">\n                    </path>\n                </svg>\n            </button>\n        </div>\n    </header>\n    <nav class=\"tabs\" data-kid=\"1-3\" data-name=\"tab navigation\">\n        <button class=\"tab is-active\" data-kid=\"1-3-1\" data-name=\"progress tab button\">\n            Progress\n        </button>\n        <button class=\"tab\" data-kid=\"1-3-2\" data-name=\"sessions tab button\">\n            Sessions\n        </button>\n    </nav>\n    <main class=\"screen\" data-kid=\"1-4\" data-name=\"main content scroll area\">\n        <section class=\"focus\" data-kid=\"1-4-1\" data-name=\"focus goal section\">\n            <div class=\"focus-top\" data-kid=\"1-4-1-1\" data-name=\"focus header area\">\n                <div data-kid=\"1-4-1-1-1\" data-name=\"focus label and heading group\">\n                    <div class=\"focus-label\" data-kid=\"1-4-1-1-1-1\" data-name=\"focus section label\">\n                        <svg aria-hidden=\"true\" data-kid=\"1-4-1-1-1-1-1\" data-name=\"flame icon\" fill=\"none\" height=\"18\" viewbox=\"0 0 24 24\" width=\"18\">\n                            <path d=\"M4 3.2h16v11.1c0 3-2.9 4.6-8 6.5-5.1-1.9-8-3.5-8-6.5V3.2z\" fill=\"var(--accent)\">\n                            </path>\n                            <path d=\"M13.4 6.6 9 13.1h2.9l-1.3 4.6 4.4-6.7h-2.9l1.3-4.4z\" fill=\"#fff\">\n                            </path>\n                        </svg>\n                        Your focus\n                    </div>\n                    <h2 data-kid=\"1-4-1-1-1-2\" data-name=\"focus title heading\">\n                        Move daily\n                    </h2>\n                </div>\n                <button aria-label=\"Edit focus\" class=\"icon-btn\" data-kid=\"1-4-1-1-2\" data-name=\"edit focus button\">\n                    <svg data-kid=\"1-4-1-1-2-1\" data-name=\"pencil edit icon\" fill=\"none\" height=\"21\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\" width=\"21\">\n                        <path d=\"m15.4 4.6 4 4L8.9 19.1l-5 1 1-5L15.4 4.6z\">\n                        </path>\n                    </svg>\n                </button>\n            </div>\n            <div class=\"track\" data-kid=\"1-4-1-2\" data-name=\"goal progress track graphic\" role=\"presentation\">\n            </div>\n            <div class=\"focus-meta\" data-kid=\"1-4-1-3\" data-name=\"goal meta details\">\n                <span class=\"left\" data-kid=\"1-4-1-3-1\" data-name=\"time remaining text\">\n                    7 months left\n                </span>\n                <span class=\"right\" data-kid=\"1-4-1-3-2\" data-name=\"target date text\">\n                    Dec 31, 2026\n                </span>\n            </div>\n        </section>\n        <section class=\"recap\" data-kid=\"1-4-2\" data-name=\"season recap banner\">\n            <svg aria-hidden=\"true\" class=\"recap-art\" data-kid=\"1-4-2-1\" data-name=\"recap background artwork\" preserveaspectratio=\"none\" viewbox=\"0 0 382 96\">\n                <defs>\n                    <lineargradient id=\"ribbonA\" x1=\"0\" x2=\"1\" y1=\"0\" y2=\"1\">\n                        <stop offset=\"0\" stop-color=\"#0e7f64\">\n                        </stop>\n                        <stop offset=\"1\" stop-color=\"#35dcaa\">\n                        </stop>\n                    </lineargradient>\n                    <lineargradient id=\"ribbonB\" x1=\"0\" x2=\"1\" y1=\"1\" y2=\"0\">\n                        <stop offset=\"0\" stop-color=\"#0a5c4a\">\n                        </stop>\n                        <stop offset=\"1\" stop-color=\"#1cb98c\">\n                        </stop>\n                    </lineargradient>\n                </defs>\n                <rect fill=\"#053225\" height=\"96\" width=\"382\">\n                </rect>\n                <path d=\"M92 -46 C 214 -6, 150 74, 268 140\" fill=\"none\" stroke=\"url(#ribbonA)\" stroke-linecap=\"round\" stroke-width=\"66\">\n                </path>\n                <path d=\"M188 -34 C 292 12, 244 66, 400 46\" fill=\"none\" opacity=\".92\" stroke=\"url(#ribbonB)\" stroke-linecap=\"round\" stroke-width=\"40\">\n                </path>\n                <path d=\"M250 108 C 300 62, 330 44, 402 26\" fill=\"none\" opacity=\".55\" stroke=\"#3ff0bb\" stroke-linecap=\"round\" stroke-width=\"15\">\n                </path>\n                <path d=\"M148 -20 C 206 22, 178 60, 226 118\" fill=\"none\" opacity=\".5\" stroke=\"#04302a\" stroke-width=\"10\">\n                </path>\n            </svg>\n            <span class=\"recap-veil\" data-kid=\"1-4-2-2\" data-name=\"recap gradient veil\">\n            </span>\n            <div class=\"recap-copy\" data-kid=\"1-4-2-3\" data-name=\"recap text info\">\n                <h3 data-kid=\"1-4-2-3-1\" data-name=\"recap title\">\n                    Season Recap\n                </h3>\n                <p data-kid=\"1-4-2-3-2\" data-name=\"recap date subtitle\">\n                    May 2026 · Preview\n                </p>\n            </div>\n            <button aria-label=\"Play your season recap\" class=\"play\" data-kid=\"1-4-2-4\" data-name=\"recap play button\">\n                <svg aria-hidden=\"true\" data-kid=\"1-4-2-4-1\" data-name=\"play triangle icon\" fill=\"currentColor\" height=\"19\" viewbox=\"0 0 24 24\" width=\"19\">\n                    <path d=\"M7.5 4.6v14.8L20 12 7.5 4.6z\">\n                    </path>\n                </svg>\n            </button>\n        </section>\n        <div class=\"chip-row\" data-kid=\"1-4-3\" data-name=\"category chip row\">\n            <button class=\"chip\" data-kid=\"1-4-3-1\" data-name=\"activity type chip\">\n                <svg aria-hidden=\"true\" data-kid=\"1-4-3-1-1\" data-name=\"running shoe icon\" fill=\"none\" height=\"21\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\" width=\"21\">\n                    <path d=\"M2.8 18.4h17.4a1 1 0 0 0 1-1v-.5c0-.8-.6-1.5-1.4-1.6a13.4 13.4 0 0 1-5.5-1.8l-3.1-1.9-2.6 1.9H4.6a1.8 1.8 0 0 0-1.8 1.8z\">\n                    </path>\n                    <path d=\"M7.9 13.5 9.4 15M10.5 11.5 12 13.1\">\n                    </path>\n                </svg>\n                Run\n            </button>\n        </div>\n        <h2 class=\"week-title\" data-kid=\"1-4-4\" data-name=\"week title heading\">\n            This week\n        </h2>\n        <dl class=\"stats\" data-kid=\"1-4-5\" data-name=\"weekly statistics grid\">\n            <div class=\"stat\" data-kid=\"1-4-5-1\" data-name=\"distance statistic container\">\n                <dt data-kid=\"1-4-5-1-1\" data-name=\"distance label\">\n                    Distance\n                </dt>\n                <dd data-kid=\"1-4-5-1-2\" data-name=\"distance value\">\n                    3.42 km\n                </dd>\n            </div>\n            <div class=\"stat\" data-kid=\"1-4-5-2\" data-name=\"time statistic container\">\n                <dt data-kid=\"1-4-5-2-1\" data-name=\"time label\">\n                    Time\n                </dt>\n                <dd data-kid=\"1-4-5-2-2\" data-name=\"time value\">\n                    19m 47s\n                </dd>\n            </div>\n            <div class=\"stat\" data-kid=\"1-4-5-3\" data-name=\"elevation statistic container\">\n                <dt data-kid=\"1-4-5-3-1\" data-name=\"elevation label\">\n                    Elev gain\n                </dt>\n                <dd data-kid=\"1-4-5-3-2\" data-name=\"elevation value\">\n                    28 m\n                </dd>\n            </div>\n        </dl>\n        <p class=\"chart-label\" data-kid=\"1-4-6\" data-name=\"chart description label\">\n            Past 12 weeks\n        </p>\n        <svg aria-label=\"Weekly distance over the past 12 weeks, rising to 3.42 kilometres this week\" class=\"chart\" data-kid=\"1-4-7\" data-name=\"weekly progress line chart\" role=\"img\" viewbox=\"0 0 382 132\">\n            <line class=\"grid-line\" x1=\"0\" x2=\"316\" y1=\"14\" y2=\"14\">\n            </line>\n            <line class=\"grid-line\" x1=\"0\" x2=\"316\" y1=\"57\" y2=\"57\">\n            </line>\n            <line class=\"axis-line\" x1=\"0\" x2=\"316\" y1=\"100\" y2=\"100\">\n            </line>\n            <path class=\"series-fill\" d=\"M288 100 L316 26.5 L316 100 Z\">\n            </path>\n            <path class=\"series\" d=\"M8 100 H28