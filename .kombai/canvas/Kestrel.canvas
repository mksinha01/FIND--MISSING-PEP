        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n.fi-device{--cream:#F8F3F0;--cream-deep:#EFE6E0;--paper:#FFFCFA;--blue:#014BAA;--blue-dark:#07336F;--ink:#17263B;--muted:#667487;--line:#DED6D1;--green:#178461;--green-soft:#E8F5EF;--amber:#A8630C;--amber-soft:#FFF2D8;--red:#B84354;--red-soft:#FCECEE;--sky:#E8F0FA;width:min(100%,393px);height:min(884px,100vh);min-height:760px;margin:0 auto;display:flex;flex-direction:column;position:relative;overflow:hidden;background:var(--cream);color:var(--ink);font-family:'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;font-size:14px;line-height:1.45;box-shadow:0 18px 55px #13294a18;}\n.fi-device button,.fi-device textarea{font:inherit;}\n.fi-status{height:34px;flex:none;padding:6px 20px 2px;display:flex;align-items:center;justify-content:space-between;color:#314157;font-size:11px;font-weight:700;}\n.fi-status-icons{display:flex;gap:7px;align-items:center;font-size:14px;}\n.fi-topbar{min-height:55px;flex:none;padding:0 14px;display:flex;align-items:center;gap:8px;background:var(--paper);border-bottom:1px solid #eae2dc;}\n.fi-back{width:38px;height:38px;display:grid;place-items:center;background:transparent;border:0;border-radius:10px;color:var(--blue-dark);font-size:20px;}\n.fi-title{min-width:0;flex:1;font-size:16px;line-height:1.2;font-weight:800;letter-spacing:-.035em;color:var(--blue-dark);}\n.fi-map{display:inline-flex;min-height:38px;align-items:center;justify-content:center;gap:5px;padding:0 9px;border:1px solid #B6CCE8;border-radius:10px;background:#EEF4FB;color:var(--blue);font-size:10px;font-weight:750;white-space:nowrap;}\n.fi-map i{font-size:15px;}\n.fi-scroll{min-height:0;flex:1;overflow-y:auto;overscroll-behavior:contain;padding:12px 14px 22px;scrollbar-width:none;}\n.fi-scroll::-webkit-scrollbar{display:none;}\n.fi-case{padding:13px 14px 11px;border-radius:15px;background:var(--blue);color:var(--cream);box-shadow:0 4px 12px #014baa20;}\n.fi-case-top,.fi-case-bottom,.fi-row-head,.fi-section-head{display:flex;align-items:center;justify-content:space-between;gap:8px;}\n.fi-demo{display:inline-flex;align-items:center;gap:5px;padding:4px 6px;border:1px solid #ffffff70;border-radius:5px;color:#FFF9F5;font-size:8px;font-weight:800;letter-spacing:.055em;}\n.fi-case-state{font-size:9px;font-weight:700;color:#F6DDD0;text-align:right;}\n.fi-person{margin-top:8px;font-size:20px;font-weight:800;line-height:1.15;letter-spacing:-.04em;}\n.fi-case-hint{margin-top:3px;color:#F8F3F0D9;font-size:10px;}\n.fi-case-bottom{padding-top:9px;margin-top:10px;border-top:1px solid #ffffff40;font-size:10px;}\n.fi-case-link{display:flex;align-items:center;gap:4px;color:#FFF9F4;font-size:10px;font-weight:750;white-space:nowrap;}\n.fi-review-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin:14px 1px 10px;}\n.fi-review-name{font-size:15px;font-weight:800;letter-spacing:-.03em;color:var(--blue-dark);}\n.fi-sub{margin-top:2px;color:var(--muted);font-size:10px;}\n.fi-status-chip{flex:none;padding:5px 7px;border-radius:7px;border:1px solid #D6CDD0;background:#F1ECEB;color:#5F5360;font-size:9px;font-weight:800;white-space:nowrap;}\n.fi-panel{background:var(--paper);border:1px solid var(--line);border-radius:13px;}\n.fi-score{display:flex;align-items:center;gap:11px;padding:11px 12px;}\n.fi-score-value{width:49px;height:49px;flex:none;display:grid;place-items:center;border-radius:13px;background:var(--sky);color:var(--blue);font-size:16px;font-weight:800;letter-spacing:-.05em;}\n.fi-score-copy{min-width:0;flex:1;}\n.fi-score-title{font-size:12px;font-weight:800;color:var(--blue-dark);}\n.fi-score-detail{margin-top:2px;color:var(--muted);font-size:9px;}\n.fi-score-caveat{margin-top:4px;color:#765313;font-size:9px;line-height:1.35;}\n.fi-section{margin-top:13px;}\n.fi-section-head{margin:0 1px 7px;}\n.fi-section-title{font-size:12px;font-weight:800;color:var(--blue-dark);}\n.fi-tag{padding:3px 5px;border:1px solid #CFBBAE;border-radius:5px;color:#78502E;font-size:8px;font-weight:800;letter-spacing:.025em;white-space:nowrap;}\n.fi-pair{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px;}\n.fi-image-card{min-width:0;padding:6px 6px 7px;background:var(--paper);border:1px solid var(--line);border-radius:12px;}\n.fi-photo{position:relative;width:100%;aspect-ratio:1 / 1;overflow:hidden;border-radius:8px;background:var(--cream-deep);}\n.fi-photo img{display:block;width:100%;height:100%;object-fit:cover;}\n.fi-photo-label{position:absolute;right:4px;bottom:4px;left:4px;padding:4px 3px;border-radius:5px;background:#10233bdd;color:#fff9f4;text-align:center;font-size:7px;font-weight:800;line-height:1.2;}\n.fi-image-title{margin:6px 1px 1px;font-size:9px;font-weight:800;line-height:1.3;color:var(--ink);}\n.fi-image-detail{margin:0 1px;color:var(--muted);font-size:8px;line-height:1.3;}\n.fi-integrity{display:flex;align-items:flex-start;gap:6px;margin-top:7px;padding:8px 9px;border:1px solid #E6D2AB;border-radius:9px;background:#FFF6E4;color:#70501F;font-size:9px;line-height:1.38;}\n.fi-integrity i{flex:none;font-size:14px;color:#A8630C;}\n.fi-media{padding:10px 11px;background:var(--paper);border:1px solid var(--line);border-radius:12px;}\n.fi-media-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:7px;}\n.fi-media-name{font-size:11px;font-weight:800;color:var(--blue-dark);}\n.fi-media-meta{font-size:8px;color:var(--muted);font-weight:700;white-space:nowrap;}\n.fi-clip-area{min-height:61px;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 9px;border:1px dashed #B9B1AB;border-radius:9px;background:#F6F0EC;}\n.fi-unavailable{color:var(--muted);font-size:9px;line-height:1.35;}\n.fi-controls{display:flex;gap:5px;flex:none;}\n.fi-control{height:31px;display:flex;align-items:center;gap:4px;padding:0 7px;border:1px solid #D5CBC4;border-radius:8px;background:#F1EAE5;color:#89909A;font-size:8px;font-weight:700;}\n.fi-control i{font-size:13px;}\n.fi-caption{margin-top:5px;color:var(--muted);font-size:8px;line-height:1.35;}\n.fi-scene{min-height:84px;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:10px;border:1px dashed #C4B8B0;border-radius:9px;background:#F7F2EF;}\n.fi-scene-icon{margin-bottom:3px;color:#718096;font-size:19px;}\n.fi-scene strong{font-size:9px;color:var(--ink);}\n.fi-scene span{margin-top:2px;color:var(--muted);font-size:8px;}\n.fi-fullscreen{min-height:32px;margin-top:7px;padding:0 8px;border:1px solid #D5CBC4;border-radius:8px;background:#F5EEEA;color:#747F90;font-size:9px;font-weight:700;}\n.fi-details{padding:8px 11px;background:var(--paper);border:1px solid var(--line);border-radius:12px;}\n.fi-data-row{display:grid;grid-template-columns:112px minmax(0,1fr);gap:6px;align-items:start;padding:7px 0;border-bottom:1px solid #EEE7E1;}\n.fi-data-row:last-of-type{border-bottom:0;}\n.fi-data-label{color:var(--muted);font-size:9px;}\n.fi-data-value{color:#34465E;font-size:9px;font-weight:650;text-align:right;overflow-wrap:anywhere;}\n.fi-data-value.is-unavailable{color:#8B929D;font-weight:500;}\n.fi-tech{padding:8px 0 1px;border-top:1px solid #EEE7E1;color:var(--blue);font-size:9px;font-weight:750;}\n.fi-tech summary{cursor:pointer;}\n.fi-tech p{margin:6px 0 1px;color:var(--muted);font-size:9px;line-height:1.4;}\n.fi-notes-label{display:block;margin-bottom:6px;color:var(--blue-dark);font-size:11px;font-weight:800;}\n.fi-notes{width:100%;min-height:58px;padding:9px 10px;resize:vertical;border:1px solid #D7CBC3;border-radius:9px;background:var(--paper);color:var(--ink);outline:none;font-family:inherit;font-size:10px;line-height:1.4;}\n.fi-notes::placeholder{color:#858C97;}\n.fi-notes:focus{border-color:var(--blue);box-shadow:0 0 0 2px #014baa20;}\n.fi-notes-hint{margin-top:4px;color:var(--muted);font-size:8px;}\n.fi-outcome{margin-top:10px;padding:10px 11px;border-radius:11px;border:1px solid #D8DDE5;background:#F1F3F5;}\n.fi-outcome-title{margin-bottom:6px;color:var(--blue-dark);font-size:10px;font-weight:800;}\n.fi-outcome-row{display:flex;align-items:flex-start;gap:6px;margin:4px 0;color:#48586C;font-size:8px;line-height:1.38;}\n.fi-outcome-row i{flex:none;font-size:12px;}\n.fi-outcome-row.ok i{color:var(--green);}.fi-outcome-row.no i{color:var(--red);}\n.fi-dock{flex:none;padding:8px 12px calc(8px + env(safe-area-inset-bottom));background:var(--paper);border-top:1px solid #E6DDD7;}\n.fi-dock-note{display:flex;align-items:center;gap:5px;margin:0 1px 7px;color:#73531F;font-size:8px;line-height:1.3;}\n.fi-dock-note i{flex:none;color:#A8630C;font-size:13px;}\n.fi-actions{display:grid;grid-template-columns:1fr 1.1fr;gap:8px;}\n.fi-action{min-height:43px;padding:6px 7px;display:flex;align-items:center;justify-content:center;gap:4px;border-radius:10px;font-size:9px;font-weight:800;line-height:1.2;text-align:center;}\n.fi-action i{font-size:14px;flex:none;}\n.fi-reject{border:1px solid #C86A76;background:#FFF9F8;color:#A73C4B;}\n.fi-confirm{border:1px solid #178461;background:#178461;color:#fff;}\n.fi-nav{height:22px;flex:none;display:grid;place-items:center;background:var(--paper);}\n.fi-nav span{width:105px;height:4px;border-radius:5px;background:#5D6671;opacity:.65;}\n.fi-scrim{display:none;position:absolute;inset:0;z-index:5;align-items:flex-end;justify-content:center;padding:12px;background:#17263B8C;}\n.fi-scrim.open{display:flex;}\n.fi-dialog{width:100%;padding:15px 15px 13px;border:1px solid #DCD4CE;border-radius:18px 18px 15px 15px;background:var(--paper);box-shadow:0 15px 38px #14213a33;}\n.fi-grabber{width:34px;height:4px;margin:0 auto 12px;border-radius:5px;background:#C9BEB6;}\n.fi-dialog-title{font-size:15px;font-weight:800;letter-spacing:-.025em;color:var(--blue-dark);}\n.fi-dialog-copy{margin-top:6px;color:#4D5D70;font-size:10px;line-height:1.45;}\n.fi-dialog-note{margin-top:9px;padding:9px 10px;border:1px solid #C6DDCF;border-radius:9px;background:var(--green-soft);color:#275E47;font-size:9px;line-height:1.4;}\n.fi-dialog-note.reject{border-color:#E7C6CC;background:var(--red-soft);color:#823B47;}\n.fi-dialog-note.demo{border-color:#E6D2AB;background:#FFF6E4;color:#70501F;}\n.fi-dialog-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px;}\n.fi-dialog-button{height:40px;border-radius:9px;font-size:10px;font-weight:800;}\n.fi-cancel{border:1px solid #CFC5BE;background:#F6F0EC;color:#34465E;}\n.fi-submit{border:1px solid #178461;background:#178461;color:#fff;opacity:.48;}\n.fi-submit.reject{border-color:#B84354;background:#B84354;}\n.fi-submit:disabled{cursor:not-allowed;}\n.fi-demo{font-size:9px}.fi-case-state,.fi-case-hint,.fi-case-bottom,.fi-case-link,.fi-sub,.fi-status-chip,.fi-score-title,.fi-score-detail,.fi-score-caveat,.fi-section-title,.fi-image-title,.fi-image-detail,.fi-integrity,.fi-media-name,.fi-media-meta,.fi-unavailable,.fi-caption,.fi-scene strong,.fi-scene span,.fi-fullscreen,.fi-data-label,.fi-data-value,.fi-tech,.fi-tech p,.fi-notes-label,.fi-notes,.fi-notes-hint,.fi-outcome-title,.fi-outcome-row,.fi-dock-note,.fi-action,.fi-dialog-title,.fi-dialog-copy,.fi-dialog-note,.fi-dialog-button,.fi-control,.fi-tag,.fi-photo-label{font-size:10px}\n.fi-review-name{font-size:16px}.fi-notes-label{font-size:12px}.fi-score-value{font-size:14px}.fi-action{min-height:48px}.fi-dialog-button{height:44px}\n@media(max-height:760px){.fi-device{min-height:700px}.fi-scroll{padding-top:9px}.fi-case{padding-top:10px;padding-bottom:9px}.fi-section{margin-top:10px}}\n</style>\n<div aria-label=\"Forensic Inspector mobile preview\" class=\"fi-device\" data-kid=\"1\" data-name=\"forensic inspector mobile preview container\">\n    <div class=\"fi-status\" data-kid=\"1-1\" data-name=\"status bar\">\n        <span data-kid=\"1-1-1\" data-name=\"status bar clock\">\n            9:41\n        </span>\n        <span class=\"fi-status-icons\" data-kid=\"1-1-2\" data-name=\"status bar system icons\">\n            <i class=\"mdi mdi-signal-cellular-3\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\">\n            </i>\n            <i class=\"mdi mdi-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi icon\">\n            </i>\n            <i class=\"mdi mdi-battery-70\" data-kid=\"1-1-2-3\" data-name=\"battery icon\">\n            </i>\n        </span>\n    </div>\n    <header class=\"fi-topbar\" data-kid=\"1-2\" data-name=\"top app bar\">\n        <button aria-label=\"Back\" class=\"fi-back\" data-kid=\"1-2-1\" data-name=\"back navigation button\">\n            <i class=\"mdi mdi-arrow-left\" data-kid=\"1-2-1-1\" data-name=\"left arrow back icon\">\n            </i>\n        </button>\n        <div class=\"fi-title\" data-kid=\"1-2-2\" data-name=\"app title text\">\n            Forensic Inspector\n        </div>\n        <button aria-label=\"View movement map\" class=\"fi-map\" data-kid=\"1-2-3\" data-name=\"view movement map button\">\n            <i class=\"mdi mdi-map-marker-path\" data-kid=\"1-2-3-1\" data-name=\"map path icon\">\n            </i>\n            <span data-kid=\"1-2-3-2\" data-name=\"movement map button label\">\n                Movement map\n            </span>\n        </button>\n    </header>\n    <main class=\"fi-scroll\" data-kid=\"1-3\" data-name=\"scrollable main content\">\n        <section aria-label=\"Demo case identity\" class=\"fi-case\" data-kid=\"1-3-1\" data-name=\"demo case identity banner\">\n            <div class=\"fi-case-top\" data-kid=\"1-3-1-1\" data-name=\"demo banner top row\">\n                <span class=\"fi-demo\" data-kid=\"1-3-1-1-1\" data-name=\"demo preview training badge\">\n                    <i class=\"mdi mdi-school-outline\" data-kid=\"1-3-1-1-1-1\" data-name=\"training school icon\">\n                    </i>\n                    DEMO PREVIEW · TRAINING ONLY\n                </span>\n                <span class=\"fi-case-state\" data-kid=\"1-3-1-1-2\" data-name=\"no live record state label\">\n                    NO LIVE RECORD\n                </span>\n            </div>\n            <div class=\"fi-person\" data-kid=\"1-3-1-2\" data-name=\"sample case headline\">\n                Sample case\n            </div>\n            <div class=\"fi-case-hint\" data-kid=\"1-3-1-3\" data-name=\"case identity unavailable hint\">\n                Case identity unavailable in this preview\n            </div>\n            <div class=\"fi-case-bottom\" data-kid=\"1-3-1-4\" data-name=\"demo banner bottom row\">\n                <span data-kid=\"1-3-1-4-1\" data-name=\"case status demo text\">\n                    Case status · Not in demo record\n                </span>\n                <span class=\"fi-case-link\" data-kid=\"1-3-1-4-2\" data-name=\"view full case link\">\n                    View full case\n                    <i class=\"mdi mdi-arrow-right\" data-kid=\"1-3-1-4-2-1\" data-name=\"right arrow link icon\">\n                    </i>\n                </span>\n            </div>\n        </section>\n        <div class=\"fi-review-head\" data-kid=\"1-3-2\" data-name=\"review header row\">\n            <div data-kid=\"1-3-2-1\" data-name=\"review title block\">\n                <div class=\"fi-review-name\" data-kid=\"1-3-2-1-1\" data-name=\"sighting review heading\">\n                    Sighting review\n                </div>\n                <div class=\"fi-sub\" data-kid=\"1-3-2-1-2\" data-name=\"review subtitle\">\n                    Review the available match evidence\n                </div>\n            </div>\n            <span class=\"fi-status-chip\" data-kid=\"1-3-2-2\" data-name=\"pending status chip\">\n                Review status unavailable\n            </span>\n        </div>\n        <div aria-label=\"Similarity score unavailable\" class=\"fi-panel fi-score\" data-kid=\"1-3-3\" data-name=\"face similarity score panel\">\n            <div class=\"fi-score-value\" data-kid=\"1-3-3-1\" data-name=\"similarity score value placeholder\">\n                N/A\n            </div>\n            <div class=\"fi-score-copy\" data-kid=\"1-3-3-2\" data-name=\"face similarity description card\">\n                <div class=\"fi-score-title\" data-kid=\"1-3-3-2-1\" data-name=\"face similarity section title\">\n                    Face similarity\n                </div>\n                <div class=\"fi-score-detail\" data-kid=\"1-3-3-2-2\" data-name=\"similarity score detail text\">\n                    ArcFace cosine similarity · score unavailable\n                </div>\n                <div class=\"fi-score-caveat\" data-kid=\"1-3-3-2-3\" data-name=\"similarity review caveat text\">\n                    Use similarity as a review lead, not proof of identity.\n                </div>\n            </div>\n        </div>\n        <section class=\"fi-section\" data-kid=\"1-3-4\" data-name=\"face comparison section\">\n            <div class=\"fi-section-head\" data-kid=\"1-3-4-1\" data-name=\"face comparison section header\">\n                <div class=\"fi-section-title\" data-kid=\"1-3-4-1-1\" data-name=\"face comparison title\">\n                    Face comparison\n                </div>\n                <span class=\"fi-tag\" data-kid=\"1-3-4-1-2\" data-name=\"demo fixtures only tag\">\n                    DEMO FIXTURES ONLY\n                </span>\n            </div>\n            <div class=\"fi-pair\" data-kid=\"1-3-4-2\" data-name=\"face comparison image pair grid\">\n                <div class=\"fi-image-card\" data-kid=\"1-3-4-2-1\" data-name=\"reference face image card\">\n                    <div class=\"fi-photo\" data-kid=\"1-3-4-2-1-1\" data-name=\"reference face photo container\">\n                        <img alt=\"Repository test portrait, not case evidence\" data-kid=\"1-3-4-2-1-1-1\" data-name=\"reference face test image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/test_image/image.png\"/>\n                        <span class=\"fi-photo-label\" data-kid=\"1-3-4-2-1-1-2\" data-name=\"reference photo demo label\">\n                            DEMO SOURCE · NOT CASE EVIDENCE\n                        </span>\n                    </div>\n                    <div class=\"fi-image-title\" data-kid=\"1-3-4-2-1-2\" data-name=\"reference face image title\">\n                        Enrolled reference slot\n                    </div>\n                    <div class=\"fi-image-detail\" data-kid=\"1-3-4-2-1-3\" data-name=\"reference face image detail\">\n                        Test portrait · no case record\n                    </div>\n                </div>\n                <div class=\"fi-image-card\" data-kid=\"1-3-4-2-2\" data-name=\"cctv face crop image card\">\n                    <div class=\"fi-photo\" data-kid=\"1-3-4-2-2-1\" data-name=\"cctv crop photo container\">\n                        <img alt=\"Aligned test crop, not CCTV evidence\" data-kid=\"1-3-4-2-2-1-1\" data-name=\"cctv aligned test crop image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/test_image/image_aligned_112x112.jpg\"/>\n                        <span class=\"fi-photo-label\" data-kid=\"1-3-4-2-2-1-2\" data-name=\"cctv crop alignment label\">\n                            ALIGNMENT TEST · NOT CCTV\n                        </span>\n                    </div>\n                    <div class=\"fi-image-title\" data-kid=\"1-3-4-2-2-2\" data-name=\"cctv crop image title\">\n                        CCTV crop slot\n                    </div>\n                    <div class=\"fi-image-detail\" data-kid=\"1-3-4-2-2-3\" data-name=\"cctv crop image detail\">\n                        112 × 112 aligned test crop\n                    </div>\n                </div>\n            </div>\n            <div class=\"fi-integrity\" data-kid=\"1-3-4-3\" data-name=\"face integrity warning banner\">\n                <i class=\"mdi mdi-alert-circle-outline\" data-kid=\"1-3-4-3-1\" data-name=\"warning circle icon\">\n                </i>\n                <span data-kid=\"1-3-4-3-2\" data-name=\"integrity warning text\">\n                    These repository fixtures are not a real reference-to-CCTV match. No sighting or scene evidence is included.\n                </span>\n            </div>\n        </section>\n        <section class=\"fi-section\" data-kid=\"1-3-5\" data-name=\"cctv clip section\">\n            <div class=\"fi-media\" data-kid=\"1-3-5-1\" data-name=\"cctv clip media panel\">\n                <div class=\"fi-media-bar\" data-kid=\"1-3-5-1-1\" data-name=\"cctv clip media header\">\n                    <span class=\"fi-media-name\" data-kid=\"1-3-5-1-1-1\" data-name=\"cctv clip media title\">\n                        5-second CCTV clip\n                    </span>\n                    <span class=\"fi-media-meta\" data-kid=\"1-3-5-1-1-2\" data-name=\"clip optional tag\">\n                        OPTIONAL\n                    </span>\n                </div>\n                <div class=\"fi-clip-area\" data-kid=\"1-3-5-1-2\" data-name=\"cctv clip content area\">\n                    <span class=\"fi-unavailable\" data-kid=\"1-3-5-1-2-1\" data-name=\"clip unavailable text\">\n                        No demo clip attached.\n                        <br data-kid=\"1-3-5-1-2-1-1\"/>\n                        Playback is unavailable.\n                    </span>\n                    <div class=\"fi-controls\" data-kid=\"1-3-5-1-2-2\" data-name=\"clip playback controls\">\n                        <button aria-label=\"Play unavailable\" class=\"fi-control\" data-kid=\"1-3-5-1-2-2-1\" data-name=\"play button (disabled)\" disabled=\"\">\n                            <i class=\"mdi mdi-play\" data-kid=\"1-3-5-1-2-2-1-1\" data-name=\"play icon\">\n                            </i>\n                            Play\n                        </button>\n                        <button aria-label=\"Replay unavailable\" class=\"fi-control\" data-kid=\"1-3-5-1-2-2-2\" data-name=\"replay button (disabled)\" disabled=\"\">\n                            <i class=\"mdi mdi-replay\" data-kid=\"1-3-5-1-2-2-2-1\" data-name=\"replay icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"fi-caption\" data-kid=\"1-3-5-1-3\" data-name=\"clip playback caption\">\n                    When available: explicit play, pause and replay · never autoplay\n                </div>\n            </div>\n        </section>\n        <section class=\"fi-section\" data-kid=\"1-3-6\" data-name=\"full scene section\">\n            <div class=\"fi-media\" data-kid=\"1-3-6-1\" data-name=\"full scene media panel\">\n                <div class=\"fi-media-bar\" data-kid=\"1-3-6-1-1\" data-name=\"full scene media header\">\n                    <span class=\"fi-media-name\" data-kid=\"1-3-6-1-1-1\" data-name=\"full scene media title\">\n                        Full CCTV scene\n                    </span>\n                    <span class=\"fi-media-meta\" data-kid=\"1-3-6-1-1-2\" data-name=\"full scene resolution tag\">\n                        1080p · OPTIONAL\n                    </span>\n                </div>\n                <div class=\"fi-scene\" data-kid=\"1-3-6-1-2\" data-name=\"full scene placeholder\">\n                    <i class=\"mdi mdi-image-off-outline fi-scene-icon\" data-kid=\"1-3-6-1-2-1\" data-name=\"scene not available icon\">\n                    </i>\n                    <strong data-kid=\"1-3-6-1-2-2\" data-name=\"scene unavailable heading\">\n                        No demo CCTV scene available\n                    </strong>\n                    <span data-kid=\"1-3-6-1-2-3\" data-name=\"scene unavailable detail\">\n                        Full-frame evidence is not included in this preview.\n                    </span>\n                </div>\n                <button class=\"fi-fullscreen\" data-kid=\"1-3-6-1-3\" data-name=\"view full scene button (disabled)\" disabled=\"\">\n                    <i class=\"mdi mdi-fullscreen\" data-kid=\"1-3-6-1-3-1\" data-name=\"fullscreen icon\">\n                    </i>\n                    View full scene · unavailable\n                </button>\n            </div>\n        </section>\n        <section class=\"fi-section\" data-kid=\"1-3-7\" data-name=\"camera details section\">\n            <div class=\"fi-section-head\" data-kid=\"1-3-7-1\" data-name=\"camera details section header\">\n                <span class=\"fi-section-title\" data-kid=\"1-3-7-1-1\" data-name=\"camera details title\">\n                    Camera details\n                </span>\n            </div>\n            <div class=\"fi-details\" data-kid=\"1-3-7-2\" data-name=\"camera details list panel\">\n                <div class=\"fi-data-row\" data-kid=\"1-3-7-2-1\" data-name=\"camera location data row\">\n                    <span class=\"fi-data-label\" data-kid=\"1-3-7-2-1-1\" data-name=\"camera location label\">\n                        Camera location\n                    </span>\n                    <span class=\"fi-data-value is-unavailable\" data-kid=\"1-3-7-2-1-2\" data-name=\"camera location value\">\n                        Not in demo record\n                    </span>\n                </div>\n                <div class=\"fi-data-row\" data-kid=\"1-3-7-2-2\" data-name=\"detected timestamp data row\">\n                    <span class=\"fi-data-label\" data-kid=\"1-3-7-2-2-1\" data-name=\"detected timestamp label\">\n                        Detected timestamp\n                    </span>\n                    <span class=\"fi-data-value is-unavailable\" data-kid=\"1-3-7-2-2-2\" data-name=\"detected timestamp value\">\n                        Not in demo record\n                    </span>\n                </div>\n                <div class=\"fi-data-row\" data-kid=\"1-3-7-2-3\" data-name=\"gps coordinates data row\">\n                    <span class=\"fi-data-label\" data-kid=\"1-3-7-2-3-1\" data-name=\"gps coordinates label\">\n                        GPS coordinates\n                    </span>\n                    <span class=\"fi-data-value is-unavailable\" data-kid=\"1-3-7-2-3-2\" data-name=\"gps coordinates value\">\n                        Not in demo record\n                    </span>\n                </div>\n                <div class=\"fi-data-row\" data-kid=\"1-3-7-2-4\" data-name=\"matched frames data row\">\n                    <span class=\"fi-data-label\" data-kid=\"1-3-7-2-4-1\" data-name=\"matched frames label\">\n                        Matched frames\n                    </span>\n                    <span class=\"fi-data-value is-unavailable\" data-kid=\"1-3-7-2-4-2\" data-name=\"matched frames value\">\n                        Not in demo record\n                    </span>\n                </div>\n                <details class=\"fi-tech\" data-kid=\"1-3-7-2-5\" data-name=\"technical identifiers disclosure\">\n                    <summary data-kid=\"1-3-7-2-5-1\" data-name=\"technical identifiers summary header\">\n                        Technical identifiers\n                    </summary>\n                    <p data-kid=\"1-3-7-2-5-2\" data-name=\"technical identifiers description\">\n                        Camera ID, CCTV agent ID and sighting ID are not present in this demo.\n                    </p>\n                </details>\n            </div>\n        </section>\n        <section class=\"fi-section\" data-kid=\"1-3-8\" data-name=\"review notes section\">\n            <label class=\"fi-notes-label\" data-kid=\"1-3-8-1\" data-name=\"review notes label\" for=\"fi-notes\">\n                Review notes\n                <span data-kid=\"1-3-8-1-1\" data-name=\"review notes optional tag\" style=\"font-weight:500;color:#667487\">\n                    (optional)\n                </span>\n            </label>\n            <textarea class=\"fi-notes\" data-kid=\"1-3-8-2\" data-name=\"review notes input field\" id=\"fi-notes\" placeholder=\"Add observations to support your decision…\"></textarea>\n            <div class=\"fi-notes-hint\" data-kid=\"1-3-8-3\" data-name=\"review notes saving hint\">\n                Notes are saved with the confirmed or rejected disposition.\n            </div>\n        </section>\n        <section class=\"fi-outcome\" data-kid=\"1-3-9\" data-name=\"after review outcome panel\">\n            <div class=\"fi-outcome-title\" data-kid=\"1-3-9-1\" data-name=\"after review title\">\n                After review\n            </div>\n            <div class=\"fi-outcome-row ok\" data-kid=\"1-3-9-2\" data-name=\"confirmed outcome row\">\n                <i class=\"mdi mdi-check-circle-outline\" data-kid=\"1-3-9-2-1\" data-name=\"confirmed checkmark icon\">\n                </i>\n                <span data-kid=\"1-3-9-2-2\" data-name=\"confirmed outcome text\">\n                    <strong data-kid=\"1-3-9-2-2-1\" data-name=\"confirmed keyword label\">\n                        Confirmed:\n                    </strong>\n                    the case is marked FOUND and the active search closes.\n                </span>\n            </div>\n            <div class=\"fi-outcome-row no\" data-kid=\"1-3-9-3\" data-name=\"rejected outcome row\">\n                <i class=\"mdi mdi-close-circle-outline\" data-kid=\"1-3-9-3-1\" data-name=\"rejected close-circle icon\">\n                </i>\n                <span data-kid=\"1-3-9-3-2\" data-name=\"rejected outcome text\">\n                    <strong data-kid=\"1-3-9-3-2-1\" data-name=\"rejected keyword label\">\n                        Rejected:\n                    </strong>\n                    false positive is recorded; the case remains active.\n                </span>\n            </div>\n            <div class=\"fi-caption\" data-kid=\"1-3-9-4\" data-name=\"outcome caption\">\n                The saved review note appears with the recorded result.\n            </div>\n        </section>\n    </main>\n    <footer class=\"fi-dock\" data-kid=\"1-4\" data-name=\"action dock\">\n        <div class=\"fi-dock-note\" data-kid=\"1-4-1\" data-name=\"action dock demo note\">\n            <i class=\"mdi mdi-information-outline\" data-kid=\"1-4-1-1\" data-name=\"action dock info icon\">\n            </i>\n            <span data-kid=\"1-4-1-2\" data-name=\"action dock demo note text\">\n                Demo only · these actions cannot change a live record.\n            </span>\n        </div>\n        <div class=\"fi-actions\" data-kid=\"1-4-2\" data-name=\"action dock button grid\">\n            <button class=\"fi-action fi-reject\" data-kid=\"1-4-2-1\" data-name=\"reject false positive action button\" onclick=\"openFiReview('reject')\">\n                <i class=\"mdi mdi-close-circle-outline\" data-kid=\"1-4-2-1-1\" data-name=\"reject close-circle icon\">\n                </i>\n                Reject false positive\n            </button>\n            <button class=\"fi-action fi-confirm\" data-kid=\"1-4-2-2\" data-name=\"confirm match action button\" onclick=\"openFiReview('confirm')\">\n                <i class=\"mdi mdi-check-circle-outline\" data-kid=\"1-4-2-2-1\" data-name=\"confirm checkmark icon\">\n                </i>\n                Confirm match\n            </button>\n        </div>\n    </footer>\n    <div class=\"fi-nav\" data-kid=\"1-5\" data-name=\"navigation indicator bar\">\n        <span data-kid=\"1-5-1\" data-name=\"home indicator line\">\n        </span>\n    </div>\n    <div class=\"fi-scrim\" data-kid=\"1-6\" data-name=\"review dialog scrim overlay\" id=\"fi-scrim\" onclick=\"if(event.target===this)closeFiReview()\" role=\"presentation\">\n        <section aria-labelledby=\"fi-dialog-title\" aria-modal=\"true\" class=\"fi-dialog\" data-kid=\"1-6-1\" data-name=\"review confirmation dialog\" role=\"dialog\">\n            <div class=\"fi-grabber\" data-kid=\"1-6-1-1\" data-name=\"dialog grabber handle\">\n            </div>\n            <div class=\"fi-dialog-title\" data-dynamic=\"true\" data-kid=\"1-6-1-2\" data-name=\"dialog title\" data-reason=\"text rewritten by openFiReview script depending on action type\" id=\"fi-dialog-title\">\n                Confirm this match?\n            </div>\n            <div class=\"fi-dialog-copy\" data-dynamic=\"true\" data-kid=\"1-6-1-3\" data-name=\"dialog copy text\" data-reason=\"text rewritten by openFiReview script depending on action type\" id=\"fi-dialog-copy\">\n                This screen is a design preview. No live sighting is loaded, and no case will be changed.\n            </div>\n            <div class=\"fi-dialog-note demo\" data-dynamic=\"true\" data-kid=\"1-6-1-4\" data-name=\"dialog contextual note\" data-reason=\"text and class rewritten by openFiReview script depending on action type\" id=\"fi-dialog-note\">\n                In the real app, confirmation marks this case FOUND and closes the active search.\n            </div>\n            <div class=\"fi-dialog-actions\" data-kid=\"1-6-1-5\" data-name=\"dialog action button grid\">\n                <button class=\"fi-dialog-button fi-cancel\" data-kid=\"1-6-1-5-1\" data-name=\"dialog go back cancel button\" onclick=\"closeFiReview()\">\n                    Go back\n                </button>\n                <button class=\"fi-dialog-button fi-submit\" data-dynamic=\"true\" data-kid=\"1-6-1-5-2\" data-name=\"dialog demo disabled submit button\" data-reason=\"text and class rewritten by openFiReview script depending on action type\" disabled=\"\" id=\"fi-dialog-action\">\n                    Demo only · disabled\n                </button>\n            </div>\n        </section>\n    </div>\n</div>\n<script>\n    function openFiReview(kind){const reject=kind==='reject';const scrim=document.getElementById('fi-scrim');const title=document.getElementById('fi-dialog-title');const copy=document.getElementById('fi-dialog-copy');const note=document.getElementById('fi-dialog-note');const action=document.getElementById('fi-dialog-action');title.textContent=reject?'Reject this false positive?':'Confirm this match?';copy.textContent=reject?'In the real app, rejection records the sighting as a false positive; the case remains active.':'This screen is a design preview. No live sighting is loaded, and no case will be changed.';note.textContent=reject?'No live record can be changed in this demo.':'In the real app, confirmation marks this case FOUND and closes the active search.';note.className=reject?'fi-dialog-note reject':'fi-dialog-note demo';action.textContent=reject?'Reject · demo disabled':'Confirm · demo disabled';action.className=reject?'fi-dialog-button fi-submit reject':'fi-dialog-button fi-submit';scrim.classList.add('open');}\nfunction closeFiReview(){document.getElementById('fi-scrim').classList.remove('open');}\n</script>\n",
      "comments": [],
      "created": "2026-10-13T10:39:32.155487+00:00",
      "modified": "2026-10-13T10:56:44.138130+00:00",
