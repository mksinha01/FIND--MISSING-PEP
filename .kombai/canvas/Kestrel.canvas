        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css\");\n.login-design{--cream:#F8F3F0;--paper:#fffdfa;--blue:#014BAA;--blue-deep:#07356f;--ink:#1a2530;--muted:#66717b;--line:#e5ddd6;--blue-wash:#eaf1fb;--success:#23785d;--error:#a94343;min-height:100vh;width:min(100%,393px);margin:0 auto;padding:24px 22px 25px;background:var(--cream);color:var(--ink);font-family:'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;line-height:1.45;display:flex;flex-direction:column;}\n.login-design *{box-sizing:border-box;}\n.brand-row{display:flex;align-items:center;gap:11px;margin:2px 0 24px;}\n.brand-mark{width:42px;height:42px;border-radius:13px;background:var(--blue);color:var(--cream);display:grid;place-items:center;font-size:19px;box-shadow:0 5px 12px #014baa24;}\n.brand-copy{display:flex;flex-direction:column;gap:1px;}\n.brand-name{font-size:12px;font-weight:800;letter-spacing:.035em;color:var(--blue-deep);}\n.brand-caption{font-size:10px;font-weight:600;color:#777e84;letter-spacing:.01em;}\n.hero{position:relative;overflow:hidden;border-radius:20px;background:var(--blue);color:var(--cream);padding:19px 20px 18px;margin-bottom:23px;}\n.hero:after{content:'';position:absolute;width:126px;height:126px;border:1px solid #ffffff26;border-radius:50%;right:-43px;top:-63px;box-shadow:0 0 0 14px #ffffff0b,0 0 0 29px #ffffff08;pointer-events:none;}\n.hero-kicker{font-size:10px;line-height:1.25;font-weight:700;letter-spacing:.045em;opacity:.84;margin-bottom:8px;}\n.hero-title{max-width:290px;font-size:22px;line-height:1.16;letter-spacing:-.04em;font-weight:800;}\n.hero-copy{max-width:285px;margin-top:7px;color:#f8f3f0e8;font-size:11px;line-height:1.45;font-weight:500;}\n.signin-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;margin:0 1px 12px;}\n.signin-title{font-size:21px;letter-spacing:-.04em;line-height:1.2;font-weight:800;}\n.signin-subtitle{margin-top:4px;color:var(--muted);font-size:11px;line-height:1.45;}\n.mode-switch{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;background:#efe8e1;border:1px solid #e7ded7;border-radius:12px;margin-bottom:15px;}\n.mode-button{min-height:38px;border:0;border-radius:9px;background:transparent;color:#68727c;font:600 12px 'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;cursor:pointer;}\n.mode-button.is-active{background:var(--paper);color:var(--blue);box-shadow:0 1px 4px #2b2e3410;}\n.form{display:flex;flex-direction:column;gap:12px;}\n.field-group{display:flex;flex-direction:column;gap:6px;}\n.field-label{color:#2b3540;font-size:11px;font-weight:700;}\n.input-wrap{display:flex;align-items:center;gap:9px;min-height:47px;padding:0 12px;border:1px solid #dcd5ce;border-radius:11px;background:var(--paper);color:var(--blue);}\n.input-wrap:focus-within{border-color:var(--blue);box-shadow:0 0 0 3px #014baa1a;}\n.input-wrap>i{font-size:17px;color:#78848d;flex:none;}\n.input-wrap input{min-width:0;width:100%;border:0;outline:0;background:transparent;color:var(--ink);font:500 12px 'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;}\n.input-wrap input::placeholder{color:#92999e;opacity:1;}\n.visibility{width:33px;height:35px;flex:none;border:0;border-radius:8px;background:transparent;color:#697680;font-size:16px;cursor:pointer;}\n.forgot-row{display:flex;justify-content:flex-end;margin-top:-2px;}\n.link-button{border:0;background:transparent;color:var(--blue);font:700 11px 'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;cursor:pointer;padding:4px 1px;}\n.primary-button{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:48px;margin-top:1px;border:1px solid var(--blue);border-radius:11px;background:var(--blue);color:var(--cream);font:700 13px 'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;cursor:pointer;box-shadow:0 5px 12px #014baa20;}\n.primary-button:active{background:var(--blue-deep);}\n.primary-button i{font-size:16px;}\n.account-prompt{margin:1px 0 0;text-align:center;color:#606a74;font-size:11px;}\n.account-prompt button{padding:0 2px;border:0;background:transparent;color:var(--blue);font:700 11px 'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;cursor:pointer;}\n.google-divider{display:flex;align-items:center;gap:10px;margin:16px 0 10px;color:#81878c;font-size:10px;font-weight:600;}\n.google-divider:before,.google-divider:after{content:'';height:1px;flex:1;background:#e1d9d1;}\n.google-button{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;min-height:45px;border:1px solid #dcd5ce;border-radius:11px;background:var(--paper);color:#29333d;font:650 12px 'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;cursor:pointer;}\n.google-button i{font-size:17px;color:#4285f4;}\n.demo-block{margin-top:16px;border-top:1px solid #e6ddd5;padding-top:13px;}\n.demo-block summary{list-style:none;display:flex;align-items:center;gap:8px;min-height:37px;color:#48545e;font-size:11px;font-weight:700;cursor:pointer;}\n.demo-block summary::-webkit-details-marker{display:none;}\n.demo-block summary:after{content:'+';margin-left:auto;color:var(--blue);font-size:18px;line-height:1;font-weight:500;}\n.demo-block[open] summary:after{content:'−';}\n.demo-pill{padding:3px 6px;border-radius:5px;background:#e9edf2;color:#586674;font-size:8px;font-weight:800;letter-spacing:.06em;}\n.demo-list{display:grid;gap:8px;padding:6px 0 0;}\n.demo-option{display:flex;align-items:center;gap:10px;width:100%;min-height:53px;padding:8px 10px;border:1px solid #e1d8d0;border-radius:11px;background:#fffdfa;color:var(--ink);text-align:left;cursor:pointer;}\n.demo-option:hover{border-color:#93acd1;background:#fdfbf9;}\n.demo-icon{width:33px;height:33px;flex:none;border-radius:9px;background:var(--blue-wash);color:var(--blue);display:grid;place-items:center;font-size:16px;}\n.demo-text{display:flex;flex:1;min-width:0;flex-direction:column;gap:1px;}\n.demo-role{font-size:11px;font-weight:700;}\n.demo-hint{font-size:9px;color:#757e86;}\n.demo-arrow{color:#617080;font-size:15px;}\n.footnote{margin:auto 0 0;padding-top:17px;text-align:center;color:#81888d;font-size:9px;line-height:1.45;}\n#name-group[hidden]{display:none;}\n@media(max-height:790px){.login-design{min-height:790px;padding-top:19px}.brand-row{margin-bottom:17px}.hero{padding:16px 18px;margin-bottom:18px}.footnote{padding-top:12px}}\n</style>\n<main aria-label=\"Find Missing Pep sign in\" class=\"login-design\" data-kid=\"1\" data-name=\"find missing pep sign-in page container\">\n    <div class=\"brand-row\" data-kid=\"1-1\" data-name=\"brand header row\">\n        <div aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1\" data-name=\"blue brand logo tile\">\n            <i class=\"mdi mdi-account-search-outline\" data-kid=\"1-1-1-1\" data-name=\"account search icon in brand logo\">\n            </i>\n        </div>\n        <div class=\"brand-copy\" data-kid=\"1-1-2\" data-name=\"brand text block\">\n            <div class=\"brand-name\" data-kid=\"1-1-2-1\" data-name=\"brand name text\">\n                FIND-MISSING-PEP\n            </div>\n            <div class=\"brand-caption\" data-kid=\"1-1-2-2\" data-name=\"brand tagline text\">\n                Missing person support\n            </div>\n        </div>\n    </div>\n    <section aria-label=\"About the app\" class=\"hero\" data-kid=\"1-2\" data-name=\"hero section describing the app\">\n        <div class=\"hero-kicker\" data-kid=\"1-2-1\" data-name=\"hero audience kicker text\">\n            FOR FAMILIES · SEARCH TEAMS · OFFICERS\n        </div>\n        <div class=\"hero-title\" data-kid=\"1-2-2\" data-name=\"hero headline text\">\n            A clearer path from report to search.\n        </div>\n        <div class=\"hero-copy\" data-kid=\"1-2-3\" data-name=\"hero description text\">\n            Report a missing person, follow case updates and review possible sightings.\n        </div>\n    </section>\n    <div class=\"signin-head\" data-kid=\"1-3\" data-name=\"sign-in heading row\">\n        <div data-kid=\"1-3-1\" data-name=\"sign-in heading text block\">\n            <div class=\"signin-title\" data-dynamic=\"true\" data-kid=\"1-3-1-1\" data-name=\"sign-in headline title\" data-reason=\"title text replaced by setMode script based on active mode\" id=\"form-title\">\n                Welcome back\n            </div>\n            <div class=\"signin-subtitle\" data-dynamic=\"true\" data-kid=\"1-3-1-2\" data-name=\"sign-in supporting subtitle\" data-reason=\"subtitle text replaced by setMode script based on active mode\" id=\"form-subtitle\">\n                Sign in to continue to your cases and search tools.\n            </div>\n        </div>\n    </div>\n    <div aria-label=\"Choose account action\" class=\"mode-switch\" data-kid=\"1-4\" data-name=\"sign in / create account mode switcher\" role=\"tablist\">\n        <button aria-selected=\"true\" class=\"mode-button is-active\" data-kid=\"1-4-1\" data-name=\"sign in mode tab button\" id=\"mode-signin\" onclick=\"setMode('signin')\" role=\"tab\" type=\"button\">\n            Sign in\n        </button>\n        <button aria-selected=\"false\" class=\"mode-button\" data-kid=\"1-4-2\" data-name=\"create account mode tab button\" id=\"mode-create\" onclick=\"setMode('create')\" role=\"tab\" type=\"button\">\n            Create account\n        </button>\n    </div>\n    <form class=\"form\" data-kid=\"1-5\" data-name=\"authentication form\" onsubmit=\"event.preventDefault();\">\n        <div class=\"field-group\" data-dynamic=\"true\" data-kid=\"1-5-1\" data-name=\"full name field group\" data-reason=\"visibility toggled by setMode script\" hidden=\"\" id=\"name-group\">\n            <label class=\"field-label\" data-kid=\"1-5-1-1\" data-name=\"full name field label\" for=\"full-name\">\n                Full name\n            </label>\n            <div class=\"input-wrap\" data-kid=\"1-5-1-2\" data-name=\"full name input container\">\n                <i aria-hidden=\"true\" class=\"mdi mdi-account-outline\" data-kid=\"1-5-1-2-1\" data-name=\"account icon for name field\">\n                </i>\n                <input autocomplete=\"name\" data-kid=\"1-5-1-2-2\" data-name=\"full name text input field\" id=\"full-name\" name=\"name\" placeholder=\"Enter your name\" type=\"text\"/>\n            </div>\n        </div>\n        <div class=\"field-group\" data-kid=\"1-5-2\" data-name=\"email field group\">\n            <label class=\"field-label\" data-kid=\"1-5-2-1\" data-name=\"email field label\" for=\"email\">\n                Email address\n            </label>\n            <div class=\"input-wrap\" data-kid=\"1-5-2-2\" data-name=\"email input container\">\n                <i aria-hidden=\"true\" class=\"mdi mdi-email-outline\" data-kid=\"1-5-2-2-1\" data-name=\"email icon\">\n                </i>\n                <input autocomplete=\"email\" data-kid=\"1-5-2-2-2\" data-name=\"email input field\" id=\"email\" name=\"email\" placeholder=\"you@example.com\" type=\"email\"/>\n            </div>\n        </div>\n        <div class=\"field-group\" data-kid=\"1-5-3\" data-name=\"password field group\">\n            <label class=\"field-label\" data-kid=\"1-5-3-1\" data-name=\"password field label\" for=\"password\">\n                Password\n            </label>\n            <div class=\"input-wrap\" data-kid=\"1-5-3-2\" data-name=\"password input container\">\n                <i aria-hidden=\"true\" class=\"mdi mdi-lock-outline\" data-kid=\"1-5-3-2-1\" data-name=\"lock icon at password field\">\n                </i>\n                <input autocomplete=\"current-password\" data-kid=\"1-5-3-2-2\" data-name=\"password input field\" id=\"password\" name=\"password\" placeholder=\"Enter your password\" type=\"password\"/>\n                <button aria-label=\"Show password\" class=\"visibility\" data-kid=\"1-5-3-2-3\" data-name=\"show/hide password toggle button\" onclick=\"togglePassword(this)\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"mdi mdi-eye-outline\" data-dynamic=\"true\" data-kid=\"1-5-3-2-3-1\" data-name=\"eye icon for password visibility toggle\" data-reason=\"icon replaced by togglePassword script depending on visibility state\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <div class=\"forgot-row\" data-dynamic=\"true\" data-kid=\"1-5-4\" data-name=\"forgot password row\" data-reason=\"visibility toggled by setMode script\" id=\"forgot-row\">\n            <button aria-label=\"Open forgot password route\" class=\"link-button\" data-kid=\"1-5-4-1\" data-name=\"forgot password link button\" type=\"button\">\n                Forgot password?\n            </button>\n        </div>\n        <button class=\"primary-button\" data-dynamic=\"true\" data-kid=\"1-5-5\" data-name=\"primary submit button\" data-reason=\"title and icon rewritten each time setMode runs\" id=\"submit-button\" type=\"submit\">\n            Sign in\n            <i aria-hidden=\"true\" class=\"mdi mdi-arrow-right\" data-kid=\"1-5-5-1\" data-name=\"arrow right icon in submit button\">\n            </i>\n        </button>\n        <p class=\"account-prompt\" data-dynamic=\"true\" data-kid=\"1-5-6\" data-name=\"new account prompt text\" data-reason=\"visibility toggled by setMode script\" id=\"account-prompt\">\n            New to the app?\n            <button data-kid=\"1-5-6-1\" data-name=\"create account inline button\" onclick=\"setMode('create')\" type=\"button\">\n                Create an account\n            </button>\n        </p>\n    </form>\n    <div class=\"google-divider\" data-kid=\"1-6\" data-name=\"divider labeled Or use another method\">\n        Or use another method\n    </div>\n    <button class=\"google-button\" data-kid=\"1-7\" data-name=\"continue with Google button\" type=\"button\">\n        <i aria-hidden=\"true\" class=\"mdi mdi-google\" data-kid=\"1-7-1\" data-name=\"google icon\">\n        </i>\n        Continue with Google\n    </button>\n    <details class=\"demo-block\" data-kid=\"1-8\" data-name=\"demo accounts collapsible section\">\n        <summary data-kid=\"1-8-1\" data-name=\"demo access collapsible summary\">\n            Demo access\n            <span class=\"demo-pill\" data-kid=\"1-8-1-1\" data-name=\"test accounts badge\">\n                TEST ACCOUNTS\n            </span>\n        </summary>\n        <div class=\"demo-list\" data-kid=\"1-8-2\" data-name=\"demo account list\">\n            <button aria-label=\"Open demo account for police officer, control room\" class=\"demo-option\" data-kid=\"1-8-2-1\" data-name=\"officer demo account option card\" type=\"button\">\n                <span aria-hidden=\"true\" class=\"demo-icon\" data-kid=\"1-8-2-1-1\" data-name=\"officer icon tile\">\n                    <i class=\"mdi mdi-shield-account-outline\" data-kid=\"1-8-2-1-1-1\" data-name=\"shield account icon\">\n                    </i>\n                </span>\n                <span class=\"demo-text\" data-kid=\"1-8-2-1-2\" data-name=\"officer role text block\">\n                    <span class=\"demo-role\" data-kid=\"1-8-2-1-2-1\" data-name=\"officer role heading\">\n                        Police officer · Control room\n                    </span>\n                    <span class=\"demo-hint\" data-kid=\"1-8-2-1-2-2\" data-name=\"officer demo hint\">\n                        Demo account · review tools\n                    </span>\n                </span>\n                <i aria-hidden=\"true\" class=\"mdi mdi-arrow-right demo-arrow\" data-kid=\"1-8-2-1-3\" data-name=\"arrow icon on demo card\">\n                </i>\n            </button>\n            <button aria-label=\"Open demo account for citizen reporter\" class=\"demo-option\" data-kid=\"1-8-2-2\" data-name=\"citizen demo account option card\" type=\"button\">\n                <span aria-hidden=\"true\" class=\"demo-icon\" data-kid=\"1-8-2-2-1\" data-name=\"heart account icon tile\">\n                    <i class=\"mdi mdi-account-heart-outline\" data-kid=\"1-8-2-2-1-1\" data-name=\"account heart icon\">\n                    </i>\n                </span>\n                <span class=\"demo-text\" data-kid=\"1-8-2-2-2\" data-name=\"citizen role text block\">\n                    <span class=\"demo-role\" data-kid=\"1-8-2-2-2-1\" data-name=\"citizen role heading\">\n                        Citizen reporter\n                    </span>\n                    <span class=\"demo-hint\" data-kid=\"1-8-2-2-2-2\" data-name=\"citizen demo hint\">\n                        Demo account · report and case updates\n                    </span>\n                </span>\n                <i aria-hidden=\"true\" class=\"mdi mdi-arrow-right demo-arrow\" data-kid=\"1-8-2-2-3\" data-name=\"arrow icon on demo card\">\n                </i>\n            </button>\n        </div>\n    </details>\n    <footer class=\"footnote\" data-kid=\"1-9\" data-name=\"footer audience footnote\">\n        For families, community reporters and search teams.\n    </footer>\n</main>\n<script>\n    function setMode(mode){\n const create=mode==='create';\n document.getElementById('mode-signin').classList.toggle('is-active',!create);\n document.getElementById('mode-create').classList.toggle('is-active',create);\n document.getElementById('mode-signin').setAttribute('aria-selected',String(!create));\n document.getElementById('mode-create').setAttribute('aria-selected',String(create));\n document.getElementById('form-title').textContent=create?'Create your account':'Welcome back';\n document.getElementById('form-subtitle').textContent=create?'Create an account to submit reports and follow cases.':'Sign in to continue to your cases and search tools.';\n document.getElementById('name-group').hidden=!create;\n document.getElementById('forgot-row').hidden=create;\n document.getElementById('submit-button').innerHTML=(create?'Create account':'Sign in')+' <i class=\"mdi mdi-arrow-right\" aria-hidden=\"true\"></i>';\n document.getElementById('account-prompt').hidden=create;\n document.getElementById('password').autocomplete=create?'new-password':'current-password';\n}\nfunction togglePassword(button){\n const input=document.getElementById('password');\n const show=input.type==='password';\n input.type=show?'text':'password';\n button.setAttribute('aria-label',show?'Hide password':'Show password');\n button.innerHTML='<i class=\"mdi '+(show?'mdi-eye-off-outline':'mdi-eye-outline')+'\" aria-hidden=\"true\"></i>';\n}\n</script>\n",
      "comments": [],
      "created": "2026-10-13T10:39:13.574093+00:00",
      "modified": "2026-10-13T10:40:05.382497+00:00",
