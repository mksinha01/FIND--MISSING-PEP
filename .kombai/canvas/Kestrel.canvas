    },
    "var_27974468e6a6": {
      "type": "variant",
      "label": "Sightings Feed — Blue & Cream",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5990,
        "y": 0,
        "w": 393,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n.sightings-device{width:100%;height:852px;max-width:393px;margin:0 auto;display:flex;flex-direction:column;overflow:hidden;background:#f8f3f0;color:#17212b;font-family:'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;font-size:14px;line-height:1.4;}\n.sightings-device button{font:inherit;color:inherit;cursor:pointer;}\n.sightings-device button:focus-visible{outline:3px solid #014baa;outline-offset:2px;}\n.status-bar{height:27px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 20px;color:#11263e;background:#f8f3f0;font-size:12px;font-weight:700;}\n.status-right{display:flex;align-items:center;gap:7px;color:#253b53;font-size:13px;}\n.topbar{height:61px;flex:none;display:flex;align-items:center;gap:10px;padding:0 16px;background:#f8f3f0;border-bottom:1px solid #e7ddd6;}\n.back-btn,.utility-btn{width:40px;height:40px;border:0;border-radius:12px;background:transparent;display:grid;place-items:center;color:#15324f;font-size:20px;}\n.topbar-title{flex:1;min-width:0;font-size:17px;line-height:1.2;font-weight:750;letter-spacing:-.035em;color:#102d4b;}\n.topbar-actions{display:flex;align-items:center;gap:2px;}\n.report-btn{height:38px;padding:0 10px;border:0;border-radius:11px;background:#014baa;color:#fff!important;font-size:11px;font-weight:700;display:flex;align-items:center;gap:4px;white-space:nowrap;}\n.report-btn i{font-size:15px;}\n.utility-btn{width:36px;height:38px;font-size:18px;}\n.feed-scroll{min-height:0;flex:1;overflow-y:auto;overscroll-behavior:contain;padding:15px 16px 18px;scrollbar-width:none;}\n.feed-scroll::-webkit-scrollbar{display:none;}\n.intro{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:13px;}\n.intro-copy{min-width:0;}\n.intro-title{font-size:20px;line-height:1.16;font-weight:780;letter-spacing:-.045em;color:#102d4b;}\n.intro-sub{margin-top:5px;color:#596978;font-size:12px;line-height:1.45;max-width:270px;}\n.demo-stamp{flex:none;padding:5px 7px;margin-top:2px;border-radius:7px;background:#e3edf8;color:#014baa;border:1px solid #c8daed;font-size:9px;letter-spacing:.03em;font-weight:800;}\n.honesty-note{display:flex;align-items:flex-start;gap:7px;padding:9px 10px;margin-bottom:15px;background:#edf3f8;border-radius:10px;color:#3c5268;font-size:11px;line-height:1.4;}\n.honesty-note i{color:#014baa;font-size:15px;flex:none;margin-top:1px;}\n.filter-title{font-size:12px;color:#5b6671;font-weight:650;margin:0 0 7px 1px;}\n.filters{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:15px;}\n.filter{height:43px;padding:0 9px;border:1px solid #ded5ce;border-radius:11px;background:#fffdfb;display:flex;align-items:center;justify-content:center;gap:5px;color:#485563;font-size:11px;font-weight:650;white-space:nowrap;}\n.filter i{font-size:14px;}\n.filter.is-selected{color:#fff;background:#014baa;border-color:#014baa;}\n.filter .filter-count{font-size:10px;opacity:.75;font-weight:600;}\n.list-heading{display:flex;align-items:center;justify-content:space-between;gap:8px;padding-bottom:8px;border-bottom:1px solid #ded5ce;margin-bottom:1px;}\n.list-title{font-size:14px;font-weight:750;letter-spacing:-.02em;color:#192f47;}\n.list-count{font-size:10px;color:#667382;}\n.record{padding:13px 0 12px;border-bottom:1px solid #ded5ce;}\n.record.pending{padding:12px 10px 11px;margin:7px -10px 0;border-radius:13px;background:#fff9ed;border-bottom:1px solid #ead8b2;}\n.record-top{display:flex;align-items:flex-start;gap:10px;}\n.photo-placeholder{width:62px;height:66px;flex:none;border:1px solid #d6cfc8;border-radius:10px;background:#eee7df;color:#61748a;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:2px;}\n.photo-placeholder i{font-size:21px;color:#47617e;line-height:1;}\n.photo-placeholder span{font-size:8px;line-height:1.15;font-weight:750;letter-spacing:.025em;}\n.record-main{min-width:0;flex:1;}\n.identity-row{display:flex;align-items:flex-start;justify-content:space-between;gap:6px;}\n.person-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px;line-height:1.3;font-weight:750;color:#172f49;}\n.score{flex:none;text-align:right;color:#014baa;font-weight:800;font-size:15px;line-height:1.1;}\n.score-label{display:block;margin-top:3px;font-size:10px;font-weight:600;color:#586b7e;}\n.status{display:inline-flex;align-items:center;gap:5px;max-width:100%;min-height:25px;padding:4px 8px;margin-top:6px;border-radius:7px;font-size:11px;line-height:1.1;font-weight:750;white-space:nowrap;}\n.status:before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor;flex:none;}\n.status.pending{color:#875500;background:#f8e8c4;}\n.status.confirmed{color:#256848;background:#dcede1;}\n.status.rejected{color:#a13f4d;background:#f5dfe1;}\n.metadata{display:flex;flex-direction:column;gap:3px;margin-top:7px;color:#425466;font-size:11px;line-height:1.3;}\n.meta-line{display:flex;align-items:flex-start;gap:5px;min-width:0;}\n.meta-line i{flex:none;font-size:13px;color:#536b83;line-height:1.25;}\n.meta-value{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}\n.frame-count{color:#3c5267;font-size:11px;font-weight:650;}\n.review-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:10px 0 0 72px;}\n.record.pending .review-row{margin-left:72px;}\n.review-button{min-height:40px;padding:0 10px;border:1px solid #014baa;border-radius:9px;background:#fff;color:#014baa;font-size:11px;font-weight:750;display:inline-flex;align-items:center;justify-content:center;gap:5px;}\n.review-button i{font-size:14px;}\n.record.pending .review-button{background:#014baa;color:#fff;}\n.review-hint{min-width:0;color:#71808e;font-size:9px;line-height:1.25;}\n.score-caveat{padding:9px 10px;margin:13px 0 0;border-radius:9px;background:#edf2f6;color:#4f6173;font-size:10px;line-height:1.45;}\n.score-caveat strong{color:#233d58;}\n.state-preview{padding-top:14px;margin-top:14px;border-top:1px solid #ded5ce;}\n.state-title{font-size:11px;font-weight:750;color:#5e6974;margin-bottom:7px;}\n.state-line{display:flex;align-items:center;gap:7px;padding:6px 0;color:#64717e;font-size:9px;line-height:1.3;}\n.state-icon{width:18px;height:18px;flex:none;display:grid;place-items:center;border-radius:6px;background:#eee8e2;color:#6e7d8c;font-size:11px;}\n.state-line strong{color:#31485f;font-weight:700;}\n.bottom-nav{height:65px;flex:none;display:grid;grid-template-columns:repeat(4,1fr);align-items:center;padding:3px 9px 0;background:#fffdfb;border-top:1px solid #e7ddd6;}\n.nav-item{height:52px;border:0;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;color:#707d89;font-size:9px;font-weight:600;}\n.nav-item i{font-size:19px;line-height:1.1;}\n.nav-item.active{color:#014baa;font-weight:800;}\n.nav-indicator{width:18px;height:2px;margin-top:1px;border-radius:2px;background:#014baa;}\n.android-bar{height:21px;flex:none;background:#fffdfb;display:grid;place-items:center;}\n.android-bar span{width:108px;height:4px;border-radius:4px;background:#26384d;opacity:.42;}\n@media(max-height:760px){.sightings-device{height:760px}.feed-scroll{padding-top:11px}.state-preview{margin-top:9px}}\n</style>\n<div class=\"sightings-device\" data-kid=\"1\" data-name=\"phone-shaped app mockup container\">\n    <div class=\"status-bar\" data-kid=\"1-1\" data-name=\"device status bar\">\n        <span data-kid=\"1-1-1\" data-name=\"status bar clock time\">\n            9:41\n        </span>\n        <span class=\"status-right\" data-kid=\"1-1-2\" data-name=\"status bar system icons cluster\">\n            <i class=\"mdi mdi-signal-cellular-3\" data-kid=\"1-1-2-1\" data-name=\"simulated cellular signal icon\">\n            </i>\n            <i class=\"mdi mdi-wifi\" data-kid=\"1-1-2-2\" data-name=\"simulated wifi icon\">\n            </i>\n            <i class=\"mdi mdi-battery-70\" data-kid=\"1-1-2-3\" data-name=\"simulated battery level icon\">\n            </i>\n        </span>\n    </div>\n    <header class=\"topbar\" data-kid=\"1-2\" data-name=\"top app header bar\">\n        <button aria-label=\"Back\" class=\"back-btn\" data-kid=\"1-2-1\" data-name=\"back navigation button\">\n            <i class=\"mdi mdi-arrow-left\" data-kid=\"1-2-1-1\" data-name=\"left arrow back icon\">\n            </i>\n        </button>\n        <div class=\"topbar-title\" data-kid=\"1-2-2\" data-name=\"top bar page title\">\n            CCTV sightings\n        </div>\n        <div class=\"topbar-actions\" data-kid=\"1-2-3\" data-name=\"top bar action buttons container\">\n            <button aria-label=\"Refresh sightings\" class=\"utility-btn\" data-kid=\"1-2-3-2\" data-name=\"refresh sightings button\">\n                <i class=\"mdi mdi-refresh\" data-kid=\"1-2-3-2-1\" data-name=\"refresh circular arrow icon\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"feed-scroll\" data-kid=\"1-3\" data-name=\"scrollable feed content area\">\n        <section class=\"intro\" data-kid=\"1-3-1\" data-name=\"feed intro header\">\n            <div class=\"intro-copy\" data-kid=\"1-3-1-1\" data-name=\"intro heading block\">\n                <div class=\"intro-title\" data-kid=\"1-3-1-1-1\" data-name=\"feed section headline\">\n                    Review sightings\n                </div>\n                <div class=\"intro-sub\" data-kid=\"1-3-1-1-2\" data-name=\"feed section explanatory subtitle\">\n                    Similarity is a review signal, not identity confirmation.\n                </div>\n            </div>\n            <span class=\"demo-stamp\" data-kid=\"1-3-1-2\" data-name=\"demo data badge\">\n                DEMO DATA\n            </span>\n        </section>\n        <div class=\"honesty-note\" data-kid=\"1-3-2\" data-name=\"honesty disclaimer note\">\n            <i class=\"mdi mdi-information-outline\" data-kid=\"1-3-2-1\" data-name=\"information icon\">\n            </i>\n            <span data-kid=\"1-3-2-2\" data-name=\"disclaimer note text\">\n                Sample feed · no CCTV images available.\n            </span>\n        </div>\n        <div class=\"filter-title\" data-kid=\"1-3-3\" data-name=\"filter label title\">\n            Filter by review status\n        </div>\n        <nav aria-label=\"Filter sightings by status\" class=\"filters\" data-kid=\"1-3-4\" data-name=\"status filter button grid\">\n            <button aria-pressed=\"true\" class=\"filter is-selected\" data-kid=\"1-3-4-1\" data-name=\"All filter button\">\n                <i class=\"mdi mdi-format-list-bulleted\" data-kid=\"1-3-4-1-1\" data-name=\"list icon\">\n                </i>\n                All Matches\n            </button>\n            <button aria-pressed=\"false\" class=\"filter\" data-kid=\"1-3-4-2\" data-name=\"Pending Review filter button\">\n                <i class=\"mdi mdi-clock-outline\" data-kid=\"1-3-4-2-1\" data-name=\"clock icon\">\n                </i>\n                Pending Review\n            </button>\n            <button aria-pressed=\"false\" class=\"filter\" data-kid=\"1-3-4-3\" data-name=\"Confirmed filter button\">\n                <i class=\"mdi mdi-check-circle-outline\" data-kid=\"1-3-4-3-1\" data-name=\"check circle icon\">\n                </i>\n                Confirmed\n            </button>\n            <button aria-pressed=\"false\" class=\"filter\" data-kid=\"1-3-4-4\" data-name=\"Rejected false alarm filter button\">\n                <i class=\"mdi mdi-close-circle-outline\" data-kid=\"1-3-4-4-1\" data-name=\"X circle icon\">\n                </i>\n                Rejected · False Alarm\n            </button>\n        </nav>\n        <div class=\"list-heading\" data-kid=\"1-3-5\" data-name=\"list header with count\">\n            <div class=\"list-title\" data-kid=\"1-3-5-1\" data-name=\"list header title\">\n                Sightings\n            </div>\n            <div class=\"list-count\" data-kid=\"1-3-5-2\" data-name=\"demo record count label\">\n                3 demo records\n            </div>\n        </div>\n        <article aria-label=\"Demo pending sighting. Tap Review sighting to inspect.\" class=\"record pending\" data-kid=\"1-3-6\" data-name=\"pending review sighting card\">\n            <div class=\"record-top\" data-kid=\"1-3-6-1\" data-name=\"sighting card top row\">\n                <div aria-label=\"Demo image unavailable, not evidence\" class=\"photo-placeholder\" data-kid=\"1-3-6-1-1\" data-name=\"missing CCTV image placeholder\">\n                    <i class=\"mdi mdi-image-off-outline\" data-kid=\"1-3-6-1-1-1\" data-name=\"camera off icon\">\n                    </i>\n                    <span data-kid=\"1-3-6-1-1-2\" data-name=\"no cctv image placeholder label\">\n                        NO CCTV\n                        <br data-kid=\"1-3-6-1-1-2-1\" data-name=\"line break\"/>\n                        IMAGE\n                    </span>\n                </div>\n                <div class=\"record-main\" data-kid=\"1-3-6-1-2\" data-name=\"sighting record details block\">\n                    <div class=\"identity-row\" data-kid=\"1-3-6-1-2-1\" data-name=\"identity and score row\">\n                        <div class=\"person-name\" data-kid=\"1-3-6-1-2-1-1\" data-name=\"identified person name\">\n                            Ananya Sharma\n                        </div>\n                        <div class=\"score\" data-kid=\"1-3-6-1-2-1-2\" data-name=\"similarity score display\">\n                            82%\n                            <span class=\"score-label\" data-kid=\"1-3-6-1-2-1-2-1\" data-name=\"score descriptor label\">\n                                sample similarity\n                            </span>\n                        </div>\n                    </div>\n                    <span class=\"status pending\" data-kid=\"1-3-6-1-2-2\" data-name=\"pending review status pill\">\n                        Pending review\n                    </span>\n                    <div class=\"metadata\" data-kid=\"1-3-6-1-2-3\" data-name=\"metadata lines block\">\n                        <div class=\"meta-line\" data-kid=\"1-3-6-1-2-3-1\" data-name=\"location metadata line\">\n                            <i class=\"mdi mdi-map-marker-outline\" data-kid=\"1-3-6-1-2-3-1-1\" data-name=\"map pin icon\">\n                            </i>\n                            <span class=\"meta-value\" data-kid=\"1-3-6-1-2-3-1-2\" data-name=\"camera location value\">\n                                Demo Camera 12 · Transit entrance\n                            </span>\n                        </div>\n                        <div class=\"meta-line\" data-kid=\"1-3-6-1-2-3-2\" data-name=\"timestamp metadata line\">\n                            <i class=\"mdi mdi-clock-outline\" data-kid=\"1-3-6-1-2-3-2-1\" data-name=\"clock icon\">\n                            </i>\n                            <span class=\"meta-value\" data-kid=\"1-3-6-1-2-3-2-2\" data-name=\"sighting timestamp value\">\n                                12 Oct 2026 · 10:42 AM · sample time\n                            </span>\n                        </div>\n                        <div class=\"meta-line\" data-kid=\"1-3-6-1-2-3-3\" data-name=\"frame count metadata line\">\n                            <i class=\"mdi mdi-chart-timeline-variant\" data-kid=\"1-3-6-1-2-3-3-1\" data-name=\"timeline chart icon\">\n                            </i>\n                            <span class=\"frame-count\" data-kid=\"1-3-6-1-2-3-3-2\" data-name=\"consecutive frame count value\">\n                                5 consecutive frames · sample count\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"review-row\" data-kid=\"1-3-6-2\" data-name=\"review action row\">\n                <span class=\"review-hint\" data-kid=\"1-3-6-2-1\" data-name=\"review hint text\">\n                    Needs analyst review\n                </span>\n                <button aria-label=\"Review sighting for Ananya Sharma\" class=\"review-button\" data-kid=\"1-3-6-2-2\" data-name=\"review sighting call-to-action button\">\n                    Review sighting\n                    <i class=\"mdi mdi-arrow-right\" data-kid=\"1-3-6-2-2-1\" data-name=\"forward arrow icon\">\n                    </i>\n                </button>\n            </div>\n        </article>\n        <article aria-label=\"Demo confirmed sighting\" class=\"record\" data-kid=\"1-3-7\" data-name=\"confirmed sighting card\">\n            <div class=\"record-top\" data-kid=\"1-3-7-1\" data-name=\"confirmed sighting top row\">\n                <div aria-label=\"Demo image unavailable, not evidence\" class=\"photo-placeholder\" data-kid=\"1-3-7-1-1\" data-name=\"missing CCTV image placeholder\">\n                    <i class=\"mdi mdi-image-off-outline\" data-kid=\"1-3-7-1-1-1\" data-name=\"camera off icon\">\n                    </i>\n                    <span data-kid=\"1-3-7-1-1-2\" data-name=\"no cctv image placeholder label\">\n                        NO CCTV\n                        <br data-kid=\"1-3-7-1-1-2-1\" data-name=\"line break\"/>\n                        IMAGE\n                    </span>\n                </div>\n                <div class=\"record-main\" data-kid=\"1-3-7-1-2\" data-name=\"confirmed sighting details block\">\n                    <div class=\"identity-row\" data-kid=\"1-3-7-1-2-1\" data-name=\"identity and score row\">\n                        <div class=\"person-name\" data-kid=\"1-3-7-1-2-1-1\" data-name=\"identified person name\">\n                            Rohan Mehta\n                        </div>\n                        <div class=\"score\" data-kid=\"1-3-7-1-2-1-2\" data-name=\"similarity score display\">\n                            91%\n                            <span class=\"score-label\" data-kid=\"1-3-7-1-2-1-2-1\" data-name=\"score descriptor label\">\n                                sample similarity\n                            </span>\n                        </div>\n                    </div>\n                    <span class=\"status confirmed\" data-kid=\"1-3-7-1-2-2\" data-name=\"confirmed status pill\">\n                        Confirmed\n                    </span>\n                    <div class=\"metadata\" data-kid=\"1-3-7-1-2-3\" data-name=\"metadata lines block\">\n                        <div class=\"meta-line\" data-kid=\"1-3-7-1-2-3-1\" data-name=\"location metadata line\">\n                            <i class=\"mdi mdi-map-marker-outline\" data-kid=\"1-3-7-1-2-3-1-1\" data-name=\"map pin icon\">\n                            </i>\n                            <span class=\"meta-value\" data-kid=\"1-3-7-1-2-3-1-2\" data-name=\"camera location value\">\n                                Demo Camera 04 · City centre\n                            </span>\n                        </div>\n                        <div class=\"meta-line\" data-kid=\"1-3-7-1-2-3-2\" data-name=\"timestamp metadata line\">\n                            <i class=\"mdi mdi-clock-outline\" data-kid=\"1-3-7-1-2-3-2-1\" data-name=\"clock icon\">\n                            </i>\n                            <span class=\"meta-value\" data-kid=\"1-3-7-1-2-3-2-2\" data-name=\"sighting timestamp value\">\n                                12 Oct 2026 · 9:18 AM · sample time\n                            </span>\n                        </div>\n                        <div class=\"meta-line\" data-kid=\"1-3-7-1-2-3-3\" data-name=\"frame count metadata line\">\n                            <i class=\"mdi mdi-chart-timeline-variant\" data-kid=\"1-3-7-1-2-3-3-1\" data-name=\"timeline chart icon\">\n                            </i>\n                            <span class=\"frame-count\" data-kid=\"1-3-7-1-2-3-3-2\" data-name=\"consecutive frame count value\">\n                                4 consecutive frames · sample count\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"review-row\" data-kid=\"1-3-7-2\" data-name=\"review action row\">\n                <span class=\"review-hint\" data-kid=\"1-3-7-2-1\" data-name=\"review hint text\">\n                    Open recorded disposition\n                </span>\n                <button aria-label=\"Review sighting for Rohan Mehta\" class=\"review-button\" data-kid=\"1-3-7-2-2\" data-name=\"review sighting call-to-action button\">\n                    Review sighting\n                    <i class=\"mdi mdi-arrow-right\" data-kid=\"1-3-7-2-2-1\" data-name=\"forward arrow icon\">\n                    </i>\n                </button>\n            </div>\n        </article>\n        <article aria-label=\"Demo rejected false alarm sighting\" class=\"record\" data-kid=\"1-3-8\" data-name=\"rejected sighting card\">\n            <div class=\"record-top\" data-kid=\"1-3-8-1\" data-name=\"rejected sighting top row\">\n                <div aria-label=\"Demo image unavailable, not evidence\" class=\"photo-placeholder\" data-kid=\"1-3-8-1-1\" data-name=\"missing CCTV image placeholder\">\n                    <i class=\"mdi mdi-image-off-outline\" data-kid=\"1-3-8-1-1-1\" data-name=\"camera off icon\">\n                    </i>\n                    <span data-kid=\"1-3-8-1-1-2\" data-name=\"no cctv image placeholder label\">\n                        NO CCTV\n                        <br data-kid=\"1-3-8-1-1-2-1\" data-name=\"line break\"/>\n                        IMAGE\n                    </span>\n                </div>\n                <div class=\"record-main\" data-kid=\"1-3-8-1-2\" data-name=\"rejected sighting details block\">\n                    <div class=\"identity-row\" data-kid=\"1-3-8-1-2-1\" data-name=\"identity and score row\">\n                        <div class=\"person-name\" data-kid=\"1-3-8-1-2-1-1\" data-name=\"identified person name\">\n                            Meera Nair\n                        </div>\n                        <div class=\"score\" data-kid=\"1-3-8-1-2-1-2\" data-name=\"similarity score display\">\n                            61%\n                            <span class=\"score-label\" data-kid=\"1-3-8-1-2-1-2-1\" data-name=\"score descriptor label\">\n                                sample similarity\n                            </span>\n                        </div>\n                    </div>\n                    <span class=\"status rejected\" data-kid=\"1-3-8-1-2-2\" data-name=\"rejected false alarm status pill\">\n                        Rejected · false alarm\n                    </span>\n                    <div class=\"metadata\" data-kid=\"1-3-8-1-2-3\" data-name=\"metadata lines block\">\n                        <div class=\"meta-line\" data-kid=\"1-3-8-1-2-3-1\" data-name=\"location metadata line\">\n                            <i class=\"mdi mdi-map-marker-outline\" data-kid=\"1-3-8-1-2-3-1-1\" data-name=\"map pin icon\">\n                            </i>\n                            <span class=\"meta-value\" data-kid=\"1-3-8-1-2-3-1-2\" data-name=\"camera location value\">\n                                Demo Camera 08 · Platform corridor\n                            </span>\n                        </div>\n                        <div class=\"meta-line\" data-kid=\"1-3-8-1-2-3-2\" data-name=\"timestamp metadata line\">\n                            <i class=\"mdi mdi-clock-outline\" data-kid=\"1-3-8-1-2-3-2-1\" data-name=\"clock icon\">\n                            </i>\n                            <span class=\"meta-value\" data-kid=\"1-3-8-1-2-3-2-2\" data-name=\"sighting timestamp value\">\n                                11 Oct 2026 · 7:06 PM · sample time\n                            </span>\n                        </div>\n                        <div class=\"meta-line\" data-kid=\"1-3-8-1-2-3-3\" data-name=\"frame count metadata line\">\n                            <i class=\"mdi mdi-chart-timeline-variant\" data-kid=\"1-3-8-1-2-3-3-1\" data-name=\"timeline chart icon\">\n                            </i>\n                            <span class=\"frame-count\" data-kid=\"1-3-8-1-2-3-3-2\" data-name=\"consecutive frame count value\">\n                                2 consecutive frames · sample count\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"review-row\" data-kid=\"1-3-8-2\" data-name=\"review action row\">\n                <span class=\"review-hint\" data-kid=\"1-3-8-2-1\" data-name=\"review hint text\">\n                    Open recorded disposition\n                </span>\n                <button aria-label=\"Review sighting for Meera Nair\" class=\"review-button\" data-kid=\"1-3-8-2-2\" data-name=\"review sighting call-to-action button\">\n                    Review sighting\n                    <i class=\"mdi mdi-arrow-right\" data-kid=\"1-3-8-2-2-1\" data-name=\"forward arrow icon\">\n                    </i>\n                </button>\n            </div>\n        </article>\n        <div class=\"score-caveat\" data-kid=\"1-3-9\" data-name=\"score caveat disclaimer\">\n            <strong data-kid=\"1-3-9-1\" data-name=\"caveat emphasized statement\">\n                Similarity does not confirm identity.\n            </strong>\n            Analysts review the face crop, full scene and context before recording a disposition.\n        </div>\n        <section aria-label=\"Alternative feed states\" class=\"state-preview\" data-kid=\"1-3-10\" data-name=\"alternative feed states preview\">\n            <div class=\"state-title\" data-kid=\"1-3-10-1\" data-name=\"states preview title\">\n                Other feed states\n            </div>\n            <div class=\"state-line\" data-kid=\"1-3-10-2\" data-name=\"loading state row\">\n                <span class=\"state-icon\" data-kid=\"1-3-10-2-1\" data-name=\"loading icon chip\">\n                    <i class=\"mdi mdi-loading\" data-kid=\"1-3-10-2-1-1\" data-name=\"loading spinner icon\">\n                    </i>\n                </span>\n                <span data-kid=\"1-3-10-2-2\" data-name=\"loading state description\">\n                    <strong data-kid=\"1-3-10-2-2-1\" data-name=\"loading state term\">\n                        Loading:\n                    </strong>\n                    show compact row placeholders while records load.\n                </span>\n            </div>\n            <div class=\"state-line\" data-kid=\"1-3-10-3\" data-name=\"filtered empty state row\">\n                <span class=\"state-icon\" data-kid=\"1-3-10-3-1\" data-name=\"filter off icon chip\">\n                    <i class=\"mdi mdi-filter-off-outline\" data-kid=\"1-3-10-3-1-1\" data-name=\"filter off icon\">\n                    </i>\n                </span>\n                <span data-kid=\"1-3-10-3-2\" data-name=\"empty state description\">\n                    <strong data-kid=\"1-3-10-3-2-1\" data-name=\"empty state term\">\n                        No filtered results:\n                    </strong>\n                    “No rejected sightings” with a clear-filter action.\n                </span>\n            </div>\n            <div class=\"state-line\" data-kid=\"1-3-10-4\" data-name=\"refresh error state row\">\n                <span class=\"state-icon\" data-kid=\"1-3-10-4-1\" data-name=\"cloud alert icon chip\">\n                    <i class=\"mdi mdi-cloud-alert-outline\" data-kid=\"1-3-10-4-1-1\" data-name=\"cloud alert icon\">\n                    </i>\n                </span>\n                <span data-kid=\"1-3-10-4-2\" data-name=\"error state description\">\n                    <strong data-kid=\"1-3-10-4-2-1\" data-name=\"error state term\">\n                        Refresh error:\n                    </strong>\n                    keep saved rows visible and offer Retry.\n                </span>\n            </div>\n        </section>\n    </main>\n    <nav aria-label=\"Main navigation\" class=\"bottom-nav\" data-kid=\"1-4\" data-name=\"bottom main navigation bar\">\n        <button class=\"nav-item\" data-kid=\"1-4-1\" data-name=\"home nav item\">\n            <i class=\"mdi mdi-home-outline\" data-kid=\"1-4-1-1\" data-name=\"home icon\">\n            </i>\n            <span data-kid=\"1-4-1-2\" data-name=\"home nav label\">\n                Home\n            </span>\n        </button>\n        <button class=\"nav-item\" data-kid=\"1-4-2\" data-name=\"cases nav item\">\n            <i class=\"mdi mdi-folder-account-outline\" data-kid=\"1-4-2-1\" data-name=\"folder with person icon\">\n            </i>\n            <span data-kid=\"1-4-2-2\" data-name=\"cases nav label\">\n                Cases\n            </span>\n        </button>\n        <button aria-current=\"page\" class=\"nav-item active\" data-kid=\"1-4-3\" data-name=\"sightings nav item active\">\n            <i class=\"mdi mdi-cctv\" data-kid=\"1-4-3-1\" data-name=\"CCTV camera icon\">\n            </i>\n            <span data-kid=\"1-4-3-2\" data-name=\"sightings nav label\">\n                Sightings\n            </span>\n            <span class=\"nav-indicator\" data-kid=\"1-4-3-3\" data-name=\"active tab indicator bar\">\n            </span>\n        </button>\n        <button class=\"nav-item\" data-kid=\"1-4-4\" data-name=\"notifications nav item\">\n            <i class=\"mdi mdi-bell-outline\" data-kid=\"1-4-4-1\" data-name=\"bell notification icon\">\n            </i>\n            <span data-kid=\"1-4-4-2\" data-name=\"notifications nav label\">\n                Notifications\n            </span>\n        </button>\n    </nav>\n    <div class=\"android-bar\" data-kid=\"1-5\" data-name=\"android gesture navigation bar\">\n        <span data-kid=\"1-5-1\" data-name=\"gesture navigation pill\">\n        </span>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-13T10:40:00.185758+00:00",
      "modified": "2026-10-13T10:57:49.995478+00:00",
      "id": "var_27974468e6a6",
