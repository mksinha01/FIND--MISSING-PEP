      "contentHeight": 884
    },
    "var_5d1d4791fd43": {
      "type": "variant",
      "label": "Profile — Blue & Cream",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4511,
        "y": 0,
        "w": 393,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n.profile-phone{--cream:#F8F3F0;--paper:#FFFDFC;--ink:#1B2533;--muted:#667180;--quiet:#82909E;--line:#E8DDD5;--blue:#014BAA;--blue-deep:#013B86;--blue-pale:#EAF1FA;--red:#B94750;--red-pale:#F9EBE9;width:min(100%,393px);height:852px;min-height:720px;margin:0 auto;display:flex;flex-direction:column;overflow:hidden;background:var(--cream);color:var(--ink);font-family:'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;font-size:14px;line-height:1.45;box-shadow:0 20px 65px rgba(35,43,53,.14);position:relative}.profile-phone button{font:inherit;color:inherit}.status-bar{height:32px;flex:none;padding:5px 21px 2px;display:flex;align-items:center;justify-content:space-between;color:var(--ink);font-size:12px;font-weight:700}.status-symbols{display:flex;align-items:center;gap:6px;font-size:15px;color:#233345}.toolbar{height:58px;flex:none;display:flex;align-items:center;gap:10px;padding:0 17px;border-bottom:1px solid #e8ddd5;background:rgba(255,253,252,.76)}.back{width:40px;height:40px;display:grid;place-items:center;border:0;background:transparent;border-radius:12px;color:var(--ink);font-size:21px}.toolbar-title{font-size:18px;font-weight:750;letter-spacing:-.035em;flex:1}.toolbar-action{border:0;background:transparent;color:var(--blue);font-size:12px;font-weight:700;padding:8px 4px}.scroll-content{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:18px 18px 20px;scrollbar-width:none}.scroll-content::-webkit-scrollbar{display:none}.intro{margin:2px 0 14px}.intro h1{margin:0;font-size:24px;line-height:1.2;font-weight:800;letter-spacing:-.045em;color:var(--ink)}.intro p{margin:5px 0 0;color:var(--muted);font-size:12px;line-height:1.5}.identity{background:var(--blue);color:var(--cream);border-radius:20px;padding:17px 17px 16px;position:relative;overflow:hidden}.identity-top{display:flex;align-items:center;gap:13px}.avatar{width:58px;height:58px;flex:none;border-radius:50%;display:grid;place-items:center;background:#F8F3F0;color:var(--blue);border:2px solid rgba(255,255,255,.72);font-size:18px;font-weight:800;letter-spacing:-.05em}.identity-copy{min-width:0;flex:1}.demo-label{display:inline-flex;align-items:center;gap:5px;padding:3px 7px;border:1px solid rgba(255,255,255,.38);border-radius:6px;color:#fff;font-size:9px;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.identity-name{font-size:18px;font-weight:750;line-height:1.2;letter-spacing:-.03em;margin-top:6px}.identity-email{font-size:11px;color:#E7EFFB;margin-top:3px;overflow-wrap:anywhere}.identity-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:15px;padding-top:12px;border-top:1px solid rgba(255,255,255,.24)}.role-copy{font-size:10px;color:#E7EFFB}.role-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.32);border-radius:8px;color:#fff;font-size:10px;font-weight:800;letter-spacing:.045em;white-space:nowrap}.role-chip i{font-size:13px}.section{margin-top:20px}.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:9px}.section-title{margin:0;font-size:15px;font-weight:750;letter-spacing:-.025em;color:var(--ink)}.section-hi{font-family:'Noto Sans Devanagari','Plus Jakarta Sans',sans-serif;font-size:12px;font-weight:600;color:var(--muted)}.section-help{margin:0 0 11px;color:var(--muted);font-size:11px;line-height:1.5}.lang-options{display:grid;grid-template-columns:1fr 1fr;gap:9px}.lang-option{position:relative;display:flex;min-width:0;min-height:72px;align-items:center;gap:9px;padding:10px 10px;border-radius:14px;border:1px solid var(--line);background:var(--paper);text-align:left;cursor:pointer}.lang-option.selected{border:1.5px solid var(--blue);background:var(--blue-pale);box-shadow:0 0 0 2px rgba(1,75,170,.07)}.radio{width:18px;height:18px;flex:none;border:1.5px solid #9BA5AF;border-radius:50%;display:grid;place-items:center;background:var(--paper)}.selected .radio{border-color:var(--blue)}.radio-dot{width:8px;height:8px;border-radius:50%;background:transparent}.selected .radio-dot{background:var(--blue)}.lang-copy{min-width:0;display:flex;flex-direction:column;gap:2px}.lang-primary{font-size:12px;font-weight:750;color:var(--ink)}.lang-secondary{font-family:'Noto Sans Devanagari','Plus Jakarta Sans',sans-serif;font-size:11px;color:var(--muted);line-height:1.35}.lang-code{font-size:9px;color:var(--quiet);font-weight:700;letter-spacing:.04em}.language-note{margin:9px 1px 0;color:var(--muted);font-size:10px;line-height:1.5}.language-note strong{font-weight:700;color:#485565}.setting-disclosure{margin-top:21px;border:1px solid var(--line);border-radius:15px;background:var(--paper);overflow:hidden}.setting-disclosure summary{list-style:none;display:flex;align-items:center;gap:11px;padding:13px 14px;cursor:pointer}.setting-disclosure summary::-webkit-details-marker{display:none}.settings-icon{width:34px;height:34px;flex:none;border-radius:10px;background:#F0E8E1;color:#42546A;display:grid;place-items:center;font-size:17px}.setting-title{min-width:0;flex:1}.setting-title strong{display:block;font-size:12px;font-weight:750;color:var(--ink)}.setting-title span{display:block;margin-top:2px;font-size:10px;color:var(--muted)}.disclosure-chevron{color:var(--blue);font-size:18px;transition:transform .18s ease}.setting-disclosure[open] .disclosure-chevron{transform:rotate(180deg)}.diagnostic-list{padding:0 14px 10px 59px}.diagnostic-row{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:8px 0;border-top:1px solid #F0E9E4}.diagnostic-label{font-size:10px;color:var(--muted)}.diagnostic-value{max-width:64%;text-align:right;color:var(--ink);font-size:10px;font-weight:650;line-height:1.4;overflow-wrap:anywhere}.signout-area{margin-top:17px;padding:13px 14px;border-top:1px solid var(--line);display:flex;align-items:center;gap:12px}.signout-copy{min-width:0;flex:1}.signout-copy strong{display:block;color:var(--ink);font-size:12px;font-weight:750}.signout-copy span{display:block;margin-top:3px;color:var(--muted);font-size:10px;line-height:1.4}.signout-button{min-height:42px;display:flex;align-items:center;justify-content:center;gap:6px;padding:0 12px;border:1px solid #E5BABB;border-radius:11px;background:var(--paper);color:var(--red)!important;font-size:11px;font-weight:750;white-space:nowrap;cursor:pointer}.signout-button i{font-size:15px}.nav-bar{height:62px;flex:none;padding:5px 13px 1px;display:grid;grid-template-columns:repeat(4,1fr);align-items:center;background:var(--paper);border-top:1px solid var(--line)}.nav-item{height:48px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;color:#6C7682;text-decoration:none;font-size:9px;font-weight:600}.nav-item i{font-size:19px}.nav-item.active{color:var(--blue);font-weight:750}.nav-item.active .nav-icon{width:42px;height:25px;display:grid;place-items:center;border-radius:14px;background:var(--blue-pale);font-size:18px}.gesture-bar{height:21px;flex:none;background:var(--paper);display:grid;place-items:center}.gesture-bar span{width:104px;height:4px;border-radius:9px;background:#293444;opacity:.48}.scrim{position:absolute;inset:0;z-index:5;display:none;align-items:flex-end;justify-content:center;padding:12px;background:rgba(27,37,51,.36)}.scrim.open{display:flex}.dialog{width:100%;max-width:365px;padding:20px 18px 16px;border:1px solid #E7DCD4;border-radius:20px;background:var(--paper);box-shadow:0 22px 58px rgba(35,43,53,.22)}.grabber{width:34px;height:4px;margin:0 auto 16px;border-radius:9px;background:#D4C7BE}.dialog-title{font-size:17px;font-weight:800;letter-spacing:-.03em;color:var(--ink)}.dialog-copy{margin-top:7px;color:var(--muted);font-size:12px;line-height:1.55}.dialog-note{margin-top:12px;padding:10px 11px;border-radius:10px;background:var(--red-pale);color:#713840;font-size:11px;line-height:1.45}.dialog-actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:16px}.dialog-button{min-height:44px;border-radius:11px;font-size:12px;font-weight:750;cursor:pointer}.dialog-cancel{border:1px solid var(--line);background:#fff;color:#475464}.dialog-confirm{border:1px solid var(--red);background:var(--red);color:#fff}.profile-phone button:focus-visible,.setting-disclosure summary:focus-visible{outline:3px solid #6F9BD1;outline-offset:2px}@media(max-height:760px){.profile-phone{min-height:680px}.scroll-content{padding-top:13px}.section{margin-top:15px}}\n</style>\n<div class=\"profile-phone\" data-kid=\"1\" data-name=\"mobile phone profile screen shell\">\n    <div class=\"status-bar\" data-kid=\"1-1\" data-name=\"phone status bar\">\n        <span data-kid=\"1-1-1\" data-name=\"status bar clock time\">\n            9:41\n        </span>\n        <span class=\"status-symbols\" data-dynamic=\"true\" data-kid=\"1-1-2\" data-name=\"status bar signal symbols\" data-reason=\"text replaced every second by countdown script\">\n            <i class=\"mdi mdi-signal-cellular-3\" data-kid=\"1-1-2-1\" data-name=\"cellular signal strength icon\">\n            </i>\n            <i class=\"mdi mdi-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon\">\n            </i>\n            <i class=\"mdi mdi-battery-70\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\">\n            </i>\n        </span>\n    </div>\n    <header class=\"toolbar\" data-kid=\"1-2\" data-name=\"top toolbar header\">\n        <button aria-label=\"Go back\" class=\"back\" data-kid=\"1-2-1\" data-name=\"back navigation button\">\n            <i class=\"mdi mdi-arrow-left\" data-kid=\"1-2-1-1\" data-name=\"back arrow icon\">\n            </i>\n        </button>\n        <div class=\"toolbar-title\" data-kid=\"1-2-2\" data-name=\"toolbar page title\">\n            Profile\n        </div>\n    </header>\n    <main class=\"scroll-content\" data-kid=\"1-3\" data-name=\"scrollable profile main content\">\n        <div class=\"intro\" data-kid=\"1-3-1\" data-name=\"intro heading block\">\n            <h1 data-kid=\"1-3-1-1\" data-name=\"page heading text\">\n                Your account\n            </h1>\n            <p data-kid=\"1-3-1-2\" data-name=\"page subheading description\">\n                Manage your profile and language preference.\n            </p>\n        </div>\n        <section aria-label=\"Demo account identity\" class=\"identity\" data-kid=\"1-3-2\" data-name=\"demo account identity card\">\n            <div class=\"identity-top\" data-kid=\"1-3-2-1\" data-name=\"identity card top row\">\n                <div aria-label=\"Demo account initials\" class=\"avatar\" data-kid=\"1-3-2-1-1\" data-name=\"account avatar initials circle\">\n                    DA\n                </div>\n                <div class=\"identity-copy\" data-kid=\"1-3-2-1-2\" data-name=\"identity details copy block\">\n                    <span class=\"demo-label\" data-kid=\"1-3-2-1-2-1\" data-name=\"demo profile badge label\">\n                        <i class=\"mdi mdi-flask-outline\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"flask outline icon\">\n                        </i>\n                        Demo profile\n                    </span>\n                    <div class=\"identity-name\" data-kid=\"1-3-2-1-2-2\" data-name=\"account display name\">\n                        Demo Officer\n                    </div>\n                    <div class=\"identity-email\" data-kid=\"1-3-2-1-2-3\" data-name=\"account email address\">\n                        officer@example.test\n                    </div>\n                </div>\n            </div>\n            <div class=\"identity-bottom\" data-kid=\"1-3-2-2\" data-name=\"identity card bottom row\">\n                <span class=\"role-copy\" data-kid=\"1-3-2-2-1\" data-name=\"account role caption\">\n                    Account role\n                </span>\n                <span class=\"role-chip\" data-kid=\"1-3-2-2-2\" data-name=\"account role chip\">\n                    <i class=\"mdi mdi-account-badge-outline\" data-kid=\"1-3-2-2-2-1\" data-name=\"account badge outline icon\">\n                    </i>\n                    OFFICER\n                </span>\n            </div>\n        </section>\n        <section aria-labelledby=\"language-heading\" class=\"section\" data-kid=\"1-3-3\" data-name=\"language preference section\">\n            <div class=\"section-head\" data-kid=\"1-3-3-1\" data-name=\"section header row\">\n                <h2 class=\"section-title\" data-kid=\"1-3-3-1-1\" data-name=\"section title text\" id=\"language-heading\">\n                    Language preference\n                </h2>\n                <span class=\"section-hi\" data-kid=\"1-3-3-1-2\" data-name=\"section title Hindi label\">\n                    भाषा\n                </span>\n            </div>\n            <p class=\"section-help\" data-kid=\"1-3-3-2\" data-name=\"section help text\">\n                Choose a preferred language for your account.\n            </p>\n            <div aria-label=\"Preferred language\" class=\"lang-options\" data-kid=\"1-3-3-3\" data-name=\"language option group\" role=\"group\">\n                <button aria-pressed=\"true\" class=\"lang-option selected\" data-dynamic=\"true\" data-kid=\"1-3-3-3-1\" data-name=\"English language option card\" data-reason=\"lang-code text appended with ' · Selected' when card selected, removing ' · Selected' from the other card\" onclick=\"selectLanguage(this)\">\n                    <span class=\"radio\" data-kid=\"1-3-3-3-1-1\" data-name=\"selection radio circle\">\n                        <span class=\"radio-dot\" data-kid=\"1-3-3-3-1-1-1\" data-name=\"radio selection dot\">\n                        </span>\n                    </span>\n                    <span class=\"lang-copy\" data-kid=\"1-3-3-3-1-2\" data-name=\"language option copy block\">\n                        <span class=\"lang-primary\" data-kid=\"1-3-3-3-1-2-1\" data-name=\"language primary label English\">\n                            English\n                        </span>\n                        <span class=\"lang-secondary\" data-kid=\"1-3-3-3-1-2-2\" data-name=\"language secondary label Devanagari\">\n                            अंग्रेज़ी\n                        </span>\n                        <span class=\"lang-code\" data-dynamic=\"true\" data-kid=\"1-3-3-3-1-2-3\" data-name=\"language code and selection status\" data-reason=\"lang-code text rewritten by selectLanguage script to toggle ' · Selected' suffix\">\n                            EN · Selected\n                        </span>\n                    </span>\n                </button>\n                <button aria-pressed=\"false\" class=\"lang-option\" data-dynamic=\"true\" data-kid=\"1-3-3-3-2\" data-name=\"Hindi language option card\" data-reason=\"lang-code text appended with ' · Selected' when card is chosen, otherwise ' · Selected' stripped\" onclick=\"selectLanguage(this)\">\n                    <span class=\"radio\" data-kid=\"1-3-3-3-2-1\" data-name=\"selection radio circle\">\n                        <span class=\"radio-dot\" data-kid=\"1-3-3-3-2-1-1\" data-name=\"radio selection dot\">\n                        </span>\n                    </span>\n                    <span class=\"lang-copy\" data-kid=\"1-3-3-3-2-2\" data-name=\"language option copy block\">\n                        <span class=\"lang-primary\" data-kid=\"1-3-3-3-2-2-1\" data-name=\"language primary label Hindi\">\n                            हिन्दी\n                        </span>\n                        <span class=\"lang-secondary\" data-kid=\"1-3-3-3-2-2-2\" data-name=\"language secondary label Latin\">\n                            Hindi\n                        </span>\n                        <span class=\"lang-code\" data-dynamic=\"true\" data-kid=\"1-3-3-3-2-2-3\" data-name=\"language code and selection status\" data-reason=\"lang-code text rewritten by selectLanguage script to toggle ' · Selected' suffix\">\n                            HI\n                        </span>\n                    </span>\n                </button>\n            </div>\n            <p class=\"language-note\" data-kid=\"1-3-3-4\" data-name=\"language preference note\">\n                <strong data-kid=\"1-3-3-4-1\" data-name=\"note strong lead text\">\n                    Preference only.\n                </strong>\n                Some screens may still appear in English.\n            </p>\n        </section>\n        <details class=\"setting-disclosure\" data-kid=\"1-3-4\" data-name=\"technical details disclosure\">\n            <summary aria-label=\"Expand technical details\" data-kid=\"1-3-4-1\" data-name=\"disclosure summary row\">\n                <span class=\"settings-icon\" data-kid=\"1-3-4-1-1\" data-name=\"disclosure settings icon container\">\n                    <i class=\"mdi mdi-tune-variant\" data-kid=\"1-3-4-1-1-1\" data-name=\"tune variant filter icon\">\n                    </i>\n                </span>\n                <span class=\"setting-title\" data-kid=\"1-3-4-1-2\" data-name=\"disclosure title block\">\n                    <strong data-kid=\"1-3-4-1-2-1\" data-name=\"disclosure title text\">\n                        Technical details\n                    </strong>\n                    <span data-kid=\"1-3-4-1-2-2\" data-name=\"disclosure subtitle text\">\n                        Network and inference diagnostics\n                    </span>\n                </span>\n                <i class=\"mdi mdi-chevron-down disclosure-chevron\" data-kid=\"1-3-4-1-3\" data-name=\"disclosure chevron icon\">\n                </i>\n            </summary>\n            <div class=\"diagnostic-list\" data-kid=\"1-3-4-2\" data-name=\"disclosure diagnostics list\">\n                <div class=\"diagnostic-row\" data-kid=\"1-3-4-2-1\" data-name=\"disclosure diagnostic endpoint row\">\n                    <span class=\"diagnostic-label\" data-kid=\"1-3-4-2-1-1\" data-name=\"diagnostic endpoint label\">\n                        Backend endpoint\n                    </span>\n                    <span class=\"diagnostic-value\" data-kid=\"1-3-4-2-1-2\" data-name=\"diagnostic endpoint value\">\n                        Configured · address not shown\n                    </span>\n                </div>\n                <div class=\"diagnostic-row\" data-kid=\"1-3-4-2-2\" data-name=\"face detection diagnostic row\">\n                    <span class=\"diagnostic-label\" data-kid=\"1-3-4-2-2-1\" data-name=\"face detection label\">\n                        Face detection\n                    </span>\n                    <span class=\"diagnostic-value\" data-kid=\"1-3-4-2-2-2\" data-name=\"face detection model value\">\n                        SCRFD-10GF\n                    </span>\n                </div>\n                <div class=\"diagnostic-row\" data-kid=\"1-3-4-2-3\" data-name=\"recognition index diagnostic row\">\n                    <span class=\"diagnostic-label\" data-kid=\"1-3-4-2-3-1\" data-name=\"recognition index label\">\n                        Recognition index\n                    </span>\n                    <span class=\"diagnostic-value\" data-kid=\"1-3-4-2-3-2\" data-name=\"recognition index value\">\n                        ArcFace 512-D · FAISS\n                    </span>\n                </div>\n                <div class=\"diagnostic-row\" data-kid=\"1-3-4-2-4\" data-name=\"frame tracking diagnostic row\">\n                    <span class=\"diagnostic-label\" data-kid=\"1-3-4-2-4-1\" data-name=\"frame tracking label\">\n                        Frame tracking\n                    </span>\n                    <span class=\"diagnostic-value\" data-kid=\"1-3-4-2-4-2\" data-name=\"frame tracking value\">\n                        ByteTrack · M-of-N\n                    </span>\n                </div>\n                <div class=\"diagnostic-row\" data-kid=\"1-3-4-2-5\" data-name=\"alerts diagnostic row\">\n                    <span class=\"diagnostic-label\" data-kid=\"1-3-4-2-5-1\" data-name=\"alerts label\">\n                        Alerts\n                    </span>\n                    <span class=\"diagnostic-value\" data-kid=\"1-3-4-2-5-2\" data-name=\"alerts value\">\n                        Firebase FCM + SSE\n                    </span>\n                </div>\n                <div class=\"diagnostic-row\" data-kid=\"1-3-4-2-6\" data-name=\"app version diagnostic row\">\n                    <span class=\"diagnostic-label\" data-kid=\"1-3-4-2-6-1\" data-name=\"app version label\">\n                        App version\n                    </span>\n                    <span class=\"diagnostic-value\" data-kid=\"1-3-4-2-6-2\" data-name=\"app version value\">\n                        1.0.0\n                    </span>\n                </div>\n            </div>\n        </details>\n        <section aria-label=\"Sign-out action\" class=\"signout-area\" data-kid=\"1-3-5\" data-name=\"sign-out action area\">\n            <div class=\"signout-copy\" data-kid=\"1-3-5-1\" data-name=\"sign-out copy block\">\n                <strong data-kid=\"1-3-5-1-1\" data-name=\"sign-out heading text\">\n                    Sign out\n                </strong>\n                <span data-kid=\"1-3-5-1-2\" data-name=\"sign-out description text\">\n                    End this account session on this device.\n                </span>\n            </div>\n            <button class=\"signout-button\" data-kid=\"1-3-5-2\" data-name=\"sign-out button\" onclick=\"openSignout()\">\n                <i class=\"mdi mdi-logout-variant\" data-kid=\"1-3-5-2-1\" data-name=\"logout variant icon\">\n                </i>\n                Sign out\n            </button>\n        </section>\n    </main>\n    <nav aria-label=\"Main navigation\" class=\"nav-bar\" data-kid=\"1-4\" data-name=\"bottom main navigation bar\">\n        <a class=\"nav-item\" data-kid=\"1-4-1\" data-name=\"home navigation item\" href=\"#home\">\n            <span class=\"nav-icon\" data-kid=\"1-4-1-1\" data-name=\"home navigation icon wrapper\">\n                <i class=\"mdi mdi-home-outline\" data-kid=\"1-4-1-1-1\" data-name=\"home outline icon\">\n                </i>\n            </span>\n            <span data-kid=\"1-4-1-2\" data-name=\"home icon label text\">\n                Home\n            </span>\n        </a>\n        <a class=\"nav-item\" data-kid=\"1-4-2\" data-name=\"cases navigation item\" href=\"#cases\">\n            <span class=\"nav-icon\" data-kid=\"1-4-2-1\" data-name=\"cases navigation icon wrapper\">\n                <i class=\"mdi mdi-folder-account-outline\" data-kid=\"1-4-2-1-1\" data-name=\"folder account outline icon\">\n                </i>\n            </span>\n            <span data-kid=\"1-4-2-2\" data-name=\"cases icon label text\">\n                Cases\n            </span>\n        </a>\n        <a class=\"nav-item\" data-kid=\"1-4-3\" data-name=\"sightings navigation item\" href=\"#sightings\">\n            <span class=\"nav-icon\" data-kid=\"1-4-3-1\" data-name=\"sightings navigation icon wrapper\">\n                <i class=\"mdi mdi-cctv\" data-kid=\"1-4-3-1-1\" data-name=\"CCTV camera icon\">\n                </i>\n            </span>\n            <span data-kid=\"1-4-3-2\" data-name=\"sightings icon label text\">\n                Sightings\n            </span>\n        </a>\n        <a aria-current=\"page\" class=\"nav-item active\" data-kid=\"1-4-4\" data-name=\"profile navigation item active\" href=\"#profile\">\n            <span class=\"nav-icon\" data-kid=\"1-4-4-1\" data-name=\"profile navigation icon highlight wrapper\">\n                <i class=\"mdi mdi-account-outline\" data-kid=\"1-4-4-1-1\" data-name=\"account outline icon\">\n                </i>\n            </span>\n            <span data-kid=\"1-4-4-2\" data-name=\"profile icon label text\">\n                Profile\n            </span>\n        </a>\n    </nav>\n    <div class=\"gesture-bar\" data-kid=\"1-5\" data-name=\"home gesture bar\">\n        <span data-kid=\"1-5-1\" data-name=\"home indicator pill\">\n        </span>\n    </div>\n    <div class=\"scrim\" data-kid=\"1-6\" data-name=\"sign-out dialog scrim overlay\" id=\"signout-scrim\" onclick=\"if(event.target===this)closeSignout()\" role=\"presentation\">\n        <section aria-labelledby=\"signout-title\" aria-modal=\"true\" class=\"dialog\" data-kid=\"1-6-1\" data-name=\"sign-out dialog container\" role=\"dialog\">\n            <div class=\"grabber\" data-kid=\"1-6-1-1\" data-name=\"dialog grabber handle\">\n            </div>\n            <div class=\"dialog-title\" data-kid=\"1-6-1-2\" data-name=\"dialog title text\" id=\"signout-title\">\n                Sign out of this device?\n            </div>\n            <div class=\"dialog-copy\" data-kid=\"1-6-1-3\" data-name=\"dialog informational copy\">\n                You’ll return to the sign-in screen. Your profile data will remain saved.\n            </div>\n            <div class=\"dialog-note\" data-kid=\"1-6-1-4\" data-name=\"dialog warning note\">\n                This will end the current account session on this device.\n            </div>\n            <div class=\"dialog-actions\" data-kid=\"1-6-1-5\" data-name=\"dialog action buttons row\">\n                <button class=\"dialog-button dialog-cancel\" data-kid=\"1-6-1-5-1\" data-name=\"dialog stay signed in button\" onclick=\"closeSignout()\">\n                    Stay signed in\n                </button>\n                <button class=\"dialog-button dialog-confirm\" data-kid=\"1-6-1-5-2\" data-name=\"dialog confirm sign out button\" onclick=\"closeSignout()\">\n                    Sign out\n                </button>\n            </div>\n        </section>\n    </div>\n</div>\n<script>\n    function selectLanguage(button){document.querySelectorAll('.lang-option').forEach((option)=>{option.classList.remove('selected');option.setAttribute('aria-pressed','false');const code=option.querySelector('.lang-code');code.textContent=code.textContent.replace(' · Selected','');});button.classList.add('selected');button.setAttribute('aria-pressed','true');const selectedCode=button.querySelector('.lang-code');selectedCode.textContent+=' · Selected';}\nfunction openSignout(){document.getElementById('signout-scrim').classList.add('open');}\nfunction closeSignout(){document.getElementById('signout-scrim').classList.remove('open');}\n</script>\n",
      "comments": [],
      "created": "2026-10-13T10:39:34.190841+00:00",
      "modified": "2026-10-13T10:40:56.163218+00:00",
      "id": "var_5d1d4791fd43",
      "contentHeight": 852
    },
    "var_032eeb7de163": {
      "type": "variant",
      "label": "Forgot Password — Blue & Cream",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5004,
        "y": 0,
        "w": 393,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css\");\n.forgot-device{--cream:#F8F3F0;--paper:#FFFDFB;--blue:#014BAA;--blue-deep:#07366F;--ink:#1B2635;--muted:#596572;--soft:#E8E1DB;--line:#D8CEC5;--green:#236E53;--green-pale:#E8F2EC;--rose:#A9454D;--rose-pale:#F8EBE8;width:min(100%,393px);height:min(852px,100vh);min-height:720px;margin:0 auto;display:flex;flex-direction:column;overflow:hidden;background:var(--cream);color:var(--ink);font-family:'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;box-shadow:0 18px 56px rgba(36,41,48,.16);}\n.forgot-device button,.forgot-device input{font:inherit;}\n.statusbar{height:36px;flex:none;padding:8px 21px 4px;display:flex;align-items:center;justify-content:space-between;font-size:12px;font-weight:700;color:#172435;}\n.status-icons{display:flex;align-items:center;gap:7px;font-size:14px;color:#273849;}\n.status-icons .battery{font-size:17px;}\n.appbar{height:60px;flex:none;display:flex;align-items:center;padding:0 18px;border-bottom:1px solid rgba(70,64,58,.1);}\n.back-link{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:6px 4px;border:0;background:transparent;color:var(--blue-deep);font-size:13px;font-weight:700;cursor:pointer;}\n.back-link i{font-size:19px;}\n.app-wordmark{margin-left:auto;color:var(--blue);font-size:10px;font-weight:800;letter-spacing:.09em;}\n.main-scroll{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:none;padding:25px 24px 22px;}\n.main-scroll::-webkit-scrollbar{display:none;}\n.content-width{width:100%;max-width:345px;margin:0 auto;}\n.title{max-width:320px;margin:0;color:var(--blue-deep);font-size:30px;font-weight:800;letter-spacing:-.045em;line-height:1.16;}\n.hindi-title{margin-top:7px;color:var(--blue);font-family:'Noto Sans Devanagari','Plus Jakarta Sans',sans-serif;font-size:17px;font-weight:600;line-height:1.4;}\n.description{max-width:325px;margin:15px 0 0;color:#455262;font-size:14px;line-height:1.65;}\n.form-block{margin-top:34px;}\n.label-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:9px;}\n.field-label{font-size:13px;font-weight:700;color:#24364A;}\n.field-kind{display:inline-flex;align-items:center;gap:5px;color:#66717B;font-size:11px;font-weight:600;}\n.field-kind i{color:var(--blue);font-size:14px;}\n.email-field{display:flex;align-items:center;gap:11px;width:100%;min-height:58px;padding:0 15px;background:var(--paper);border:1.5px solid #7B9CC9;border-radius:13px;box-shadow:0 0 0 3px rgba(1,75,170,.08);}\n.email-field>i{flex:none;color:var(--blue);font-size:19px;}\n.email-field input{min-width:0;width:100%;height:54px;padding:0;border:0;outline:0;background:transparent;color:var(--ink);font-size:14px;}\n.email-field input::placeholder{color:#687582;opacity:1;}\n.field-hint{margin:8px 2px 0;color:#5C6570;font-size:12px;line-height:1.5;}\n.primary-action{width:100%;min-height:54px;display:flex;align-items:center;justify-content:center;gap:9px;margin-top:22px;padding:12px 18px;border:0;border-radius:13px;background:var(--blue);color:#FFFDFB;font-size:15px;font-weight:750;letter-spacing:-.01em;box-shadow:0 5px 0 rgba(7,54,111,.13);cursor:pointer;}\n.primary-action i{font-size:18px;}\n.error-hint{display:flex;align-items:flex-start;gap:8px;margin-top:13px;padding:0 2px;color:#626C76;font-size:11px;line-height:1.55;}\n.error-hint i{flex:none;margin-top:1px;color:var(--rose);font-size:15px;}\n.preview-label{margin:30px 0 9px;color:#596572;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;}\n.success-preview{padding:13px 14px 12px;background:#F2F6F2;border:1px solid #D4E2D8;border-radius:13px;}\n.success-top{display:flex;align-items:center;gap:8px;color:var(--green);font-size:13px;font-weight:750;}\n.success-top i{font-size:17px;}\n.success-copy{margin:7px 0 0;color:#47564D;font-size:11px;line-height:1.5;}\n.success-link{display:inline-flex;align-items:center;gap:5px;margin-top:8px;color:var(--blue-deep);font-size:11px;font-weight:750;text-decoration:none;}\n.success-link i{font-size:14px;}\n.device-nav{height:23px;flex:none;display:grid;place-items:center;background:var(--cream);}\n.device-nav span{width:108px;height:4px;border-radius:5px;background:#5C6268;opacity:.6;}\n@media(max-height:760px){.forgot-device{min-height:680px}.main-scroll{padding-top:19px}.form-block{margin-top:25px}.preview-label{margin-top:22px}}\n</style>\n<div class=\"forgot-device\" data-kid=\"1\" data-name=\"Forgot Password screen container\">\n    <div aria-label=\"Android status bar\" class=\"statusbar\" data-kid=\"1-1\" data-name=\"Android status bar\">\n        <span data-kid=\"1-1-1\">\n            9:41\n        </span>\n        <span aria-hidden=\"true\" class=\"status-icons\" data-kid=\"1-1-2\">\n            <i class=\"mdi mdi-signal-cellular-3\" data-kid=\"1-1-2-1\">\n            </i>\n            <i class=\"mdi mdi-wifi\" data-kid=\"1-1-2-2\">\n            </i>\n            <i class=\"mdi mdi-battery-70 battery\" data-kid=\"1-1-2-3\">\n            </i>\n        </span>\n    </div>\n    <header class=\"appbar\" data-kid=\"1-2\" data-name=\"app top bar\">\n        <button aria-label=\"Back to sign in\" class=\"back-link\" data-kid=\"1-2-1\" type=\"button\">\n            <i class=\"mdi mdi-arrow-left\" data-kid=\"1-2-1-1\">\n            </i>\n            <span data-kid=\"1-2-1-2\">\n                Back to sign in\n            </span>\n        </button>\n        <span class=\"app-wordmark\" data-kid=\"1-2-2\">\n            FIND-MISSING-PEP\n        </span>\n    </header>\n    <main class=\"main-scroll\" data-kid=\"1-3\" data-name=\"main scrollable content area\">\n        <div class=\"content-width\" data-kid=\"1-3-1\" data-name=\"main content column\">\n            <h1 class=\"title\" data-kid=\"1-3-1-1\">\n                Reset your password\n            </h1>\n            <div class=\"hindi-title\" data-kid=\"1-3-1-2\" data-name=\"Hindi subtitle text\" lang=\"hi\">\n                पासवर्ड रीसेट करें\n            </div>\n            <p class=\"description\" data-kid=\"1-3-1-3\">\n                Enter your email address and we’ll send you a link to reset your password.\n            </p>\n            <form aria-label=\"Password reset form\" class=\"form-block\" data-kid=\"1-3-1-4\">\n                <div class=\"label-row\" data-kid=\"1-3-1-4-1\">\n                    <label class=\"field-label\" data-kid=\"1-3-1-4-1-1\" for=\"reset-email\">\n                        Email address\n                    </label>\n                    <span class=\"field-kind\" data-kid=\"1-3-1-4-1-2\">\n                        <i class=\"mdi mdi-at\" data-kid=\"1-3-1-4-1-2-1\">\n                        </i>\n                        Email\n                    </span>\n                </div>\n                <div class=\"email-field\" data-kid=\"1-3-1-4-2\">\n                    <i aria-hidden=\"true\" class=\"mdi mdi-email-outline\" data-kid=\"1-3-1-4-2-1\">\n                    </i>\n                    <input aria-describedby=\"email-hint error-hint\" autocomplete=\"email\" data-kid=\"1-3-1-4-2-2\" id=\"reset-email\" inputmode=\"email\" placeholder=\"Enter your email address\" type=\"email\"/>\n                </div>\n                <p class=\"field-hint\" data-kid=\"1-3-1-4-3\" id=\"email-hint\">\n                    Use the address associated with your account.\n                </p>\n                <button class=\"primary-action\" data-kid=\"1-3-1-4-4\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"mdi mdi-send-outline\" data-kid=\"1-3-1-4-4-1\">\n                    </i>\n                    Send reset link\n                </button>\n                <div class=\"error-hint\" data-kid=\"1-3-1-4-5\" id=\"error-hint\">\n                    <i aria-hidden=\"true\" class=\"mdi mdi-alert-circle-outline\" data-kid=\"1-3-1-4-5-1\">\n                    </i>\n                    <span data-kid=\"1-3-1-4-5-2\">\n                        If sending fails, a message will appear here so you can try again.\n                    </span>\n                </div>\n            </form>\n            <div class=\"preview-label\" data-kid=\"1-3-1-5\">\n                After you send\n            </div>\n            <section aria-label=\"Password reset success state preview\" class=\"success-preview\" data-kid=\"1-3-1-6\">\n                <div class=\"success-top\" data-kid=\"1-3-1-6-1\">\n                    <i aria-hidden=\"true\" class=\"mdi mdi-check-circle-outline\" data-kid=\"1-3-1-6-1-1\">\n                    </i>\n                    <span data-kid=\"1-3-1-6-1-2\">\n                        Reset link sent\n                    </span>\n                </div>\n                <p class=\"success-copy\" data-kid=\"1-3-1-6-2\">\n                    The confirmation will name the address you submitted and include a way back to sign in.\n                </p>\n                <button class=\"success-link\" data-kid=\"1-3-1-6-3\" data-name=\"back to sign in link button\" type=\"button\">\n                    <span data-kid=\"1-3-1-6-3-1\">\n                        Back to sign in\n                    </span>\n                    <i aria-hidden=\"true\" class=\"mdi mdi-arrow-right\" data-kid=\"1-3-1-6-3-2\">\n                    </i>\n                </button>\n            </section>\n        </div>\n    </main>\n    <div aria-hidden=\"true\" class=\"device-nav\" data-kid=\"1-4\" data-name=\"device navigation bar\">\n        <span data-kid=\"1-4-1\" data-name=\"device home indicator bar\">\n        </span>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-13T10:39:37.905691+00:00",
      "modified": "2026-10-13T10:40:09.702067+00:00",
      "id": "var_032eeb7de163",
      "contentHeight": 852
    },
    "var_613d699c2a16": {
      "type": "variant",
      "label": "Breadcrumb Map — Blue & Cream",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5497,
        "y": 0,
        "w": 393,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n\n.breadcrumb-screen{--cream:#f8f3f0;--paper:#fffdfa;--blue:#014baa;--blue-dark:#0a3672;--ink:#172338;--muted:#6d7888;--line:#e7ddd5;--soft-blue:#e8eff9;--amber:#a66a18;--amber-soft:#fff1d8;--green:#217a61;--green-soft:#e5f3ed;width:100%;height:852px;min-height:852px;display:flex;flex-direction:column;overflow:hidden;background:var(--cream);color:var(--ink);font-family:'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;letter-spacing:-.01em;}\n.breadcrumb-screen *{box-sizing:border-box;}\n.breadcrumb-status{height:28px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 20px;color:#243148;font-size:11px;font-weight:700;}\n.status-icons{display:flex;align-items:center;gap:6px;color:#26334a;font-size:13px;}\n.breadcrumb-toolbar{height:64px;flex:none;display:flex;align-items:center;gap:8px;padding:0 16px;background:var(--cream);border-bottom:1px solid #e9dfd8;}\n.back-btn{width:40px;height:40px;display:grid;place-items:center;border:0;border-radius:12px;background:transparent;color:var(--ink);font-size:21px;}\n.toolbar-copy{flex:1;min-width:0;}\n.toolbar-title{font-size:17px;font-weight:800;letter-spacing:-.045em;line-height:1.2;}\n.toolbar-sub{margin-top:2px;color:var(--muted);font-size:10px;font-weight:600;}\n.case-chip{flex:none;padding:7px 9px;border:1px solid #d9cabe;border-radius:9px;color:var(--blue-dark);font-size:10px;font-weight:700;background:#fffaf6;}\n.map-area{position:relative;flex:1;min-height:0;overflow:hidden;background-color:#f3ece5;background-image:radial-gradient(circle at 1px 1px,#cfbeb0 1px,transparent 1.3px);background-size:26px 26px;}\n.map-area:before{content:\"\";position:absolute;inset:0;background:radial-gradient(ellipse at 58% 43%,rgba(255,253,250,.78) 0,rgba(255,253,250,.3) 36%,transparent 73%);pointer-events:none;}\n.map-caption{position:absolute;z-index:2;top:15px;left:16px;right:16px;display:flex;justify-content:space-between;align-items:flex-start;gap:10px;}\n.order-label{max-width:225px;padding:9px 11px;background:#fffdfa;border:1px solid #e1d5cc;border-radius:12px;box-shadow:0 4px 14px #39250d0a;}\n.order-label strong{display:block;color:#26384f;font-size:10px;font-weight:800;letter-spacing:.04em;}\n.order-label span{display:block;margin-top:2px;color:var(--muted);font-size:10px;line-height:1.35;}\n.provenance{max-width:110px;padding:7px 8px;border-radius:9px;background:#fff1d8;color:#7e4f12;border:1px solid #e6c997;font-size:9px;line-height:1.25;font-weight:750;text-align:center;}\n.marker-halo{position:absolute;top:43%;left:57%;width:110px;height:110px;transform:translate(-50%,-50%);border:1px solid #014baa20;border-radius:50%;display:grid;place-items:center;}\n.marker-halo:before{content:\"\";position:absolute;inset:15px;border:1px solid #014baa24;border-radius:50%;}\n.demo-marker{position:relative;z-index:1;width:50px;height:50px;display:grid;place-items:center;border:4px solid #fffdfa;border-radius:50% 50% 50% 12px;background:var(--blue);box-shadow:0 5px 15px #1239682b;color:#fff;transform:rotate(-45deg);}\n.demo-marker i{font-size:21px;transform:rotate(45deg);}\n.marker-tag{position:absolute;z-index:2;top:calc(43% + 43px);left:57%;transform:translateX(-50%);padding:6px 9px;background:var(--blue);border:2px solid #fffdfa;border-radius:8px;color:#fff;font-size:9px;font-weight:800;white-space:nowrap;box-shadow:0 3px 9px #0e356528;}\n.map-bottom-note{position:absolute;left:16px;bottom:17px;display:flex;align-items:center;gap:7px;padding:8px 10px;background:#fffdfa;border:1px solid #e4d8ce;border-radius:10px;color:#505e70;font-size:10px;font-weight:650;box-shadow:0 3px 12px #39250d0a;}\n.map-bottom-note i{color:var(--blue);font-size:15px;}\n.coord-fab{position:absolute;right:16px;bottom:17px;width:42px;height:42px;display:grid;place-items:center;border:1px solid #e3d6cc;border-radius:13px;background:#fffdfa;color:#516074;font-size:19px;box-shadow:0 3px 12px #39250d0a;}\n.waypoint-sheet{position:relative;z-index:3;flex:none;padding:7px 16px 12px;background:var(--paper);border-top:1px solid #e5d9d0;border-radius:20px 20px 0 0;box-shadow:0 -8px 24px #43270d0b;}\n.sheet-handle{width:34px;height:4px;border-radius:4px;background:#d8cbc0;margin:0 auto 11px;}\n.sheet-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:9px;}\n.sheet-title{font-size:15px;font-weight:800;letter-spacing:-.035em;}\n.demo-label{padding:4px 7px;background:#eef2f8;border:1px solid #d4deed;border-radius:6px;color:#38567f;font-size:9px;font-weight:800;letter-spacing:.04em;}\n.waypoint-row{display:flex;align-items:center;gap:10px;padding:10px 11px;border:1px solid #e7ddd5;border-radius:13px;background:#fffdfa;}\n.waypoint-icon{width:37px;height:37px;flex:none;display:grid;place-items:center;border-radius:11px;background:var(--soft-blue);color:var(--blue);font-size:19px;}\n.waypoint-copy{min-width:0;flex:1;}\n.waypoint-name{font-size:12px;font-weight:750;}\n.waypoint-sub{margin-top:2px;color:var(--muted);font-size:11px;line-height:1.35;}\n.sequence{flex:none;align-self:flex-start;padding:4px 6px;border-radius:6px;background:#f1eee9;color:#5d6877;font-size:10px;font-weight:750;}\n.detail-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px;}\n.detail-cell{padding:8px 9px;background:#f8f3f0;border-radius:10px;min-width:0;}\n.detail-label{font-size:11px;color:#637084;font-weight:700;}\n.detail-value{margin-top:3px;font-size:12px;color:#39475b;font-weight:700;line-height:1.3;}\n.detail-value.missing{color:#8d6540;font-weight:650;}\n.gps-notice{display:flex;align-items:flex-start;gap:7px;margin-top:8px;padding:8px 9px;background:#fff5e5;border:1px solid #efdfc4;border-radius:10px;color:#72582f;font-size:10px;line-height:1.35;}\n.gps-notice i{font-size:14px;flex:none;color:var(--amber);}\n.navigate-btn{height:43px;width:100%;display:flex;align-items:center;justify-content:center;gap:7px;margin-top:9px;border:0;border-radius:11px;background:#e4e8ee;color:#43536b;font-family:inherit;font-size:11px;font-weight:800;}\n.navigate-btn i{font-size:16px;}\n.navigate-hint{margin-top:5px;text-align:center;font-size:10px;color:#667286;}\n.bottom-nav{height:23px;flex:none;display:grid;place-items:center;background:var(--paper);}\n.bottom-nav span{width:108px;height:4px;background:#788294;border-radius:4px;opacity:.6;}\n@media(max-width:370px){.breadcrumb-screen{font-size:13px}.map-caption{left:12px;right:12px}.order-label{max-width:195px}.provenance{max-width:100px}.waypoint-sheet{padding-left:12px;padding-right:12px}.waypoint-row{gap:8px}.detail-row{gap:6px}}\n</style>\n<div class=\"breadcrumb-screen\" data-kid=\"1\" data-name=\"breadcrumb case detail screen container\">\n    <div class=\"breadcrumb-status\" data-kid=\"1-1\" data-name=\"phone status bar\">\n        <span data-kid=\"1-1-1\" data-name=\"status bar time text\">\n            9:41\n        </span>\n        <span class=\"status-icons\" data-kid=\"1-1-2\" data-name=\"status bar system icons\">\n            <i class=\"mdi mdi-signal-cellular-3\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\">\n            </i>\n            <i class=\"mdi mdi-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi icon\">\n            </i>\n            <i class=\"mdi mdi-battery-70\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\">\n            </i>\n        </span>\n    </div>\n    <header class=\"breadcrumb-toolbar\" data-kid=\"1-2\" data-name=\"toolbar header\">\n        <button aria-label=\"Back\" class=\"back-btn\" data-kid=\"1-2-1\" data-name=\"back navigation button\">\n            <i class=\"mdi mdi-arrow-left\" data-kid=\"1-2-1-1\" data-name=\"left arrow back icon\">\n            </i>\n        </button>\n        <div class=\"toolbar-copy\" data-kid=\"1-2-2\" data-name=\"toolbar title and subtitle container\">\n            <div class=\"toolbar-title\" data-kid=\"1-2-2-1\" data-name=\"toolbar page title text\">\n                Movement trajectory\n            </div>\n            <div class=\"toolbar-sub\" data-kid=\"1-2-2-2\" data-name=\"toolbar context subtitle text\">\n                Case subject · demonstration view\n            </div>\n        </div>\n        <span class=\"case-chip\" data-kid=\"1-2-3\" data-name=\"demo case indicator chip\">\n            DEMO\n        </span>\n    </header>\n    <main aria-label=\"Schematic, non-geographic map preview\" class=\"map-area\" data-kid=\"1-3\" data-name=\"map preview area\">\n        <div class=\"map-caption\" data-kid=\"1-3-1\" data-name=\"map caption overlays container\">\n            <div class=\"order-label\" data-kid=\"1-3-1-1\" data-name=\"camera observation order label card\">\n                <strong data-kid=\"1-3-1-1-1\" data-name=\"observation order label headline\">\n                    CAMERA OBSERVATION ORDER\n                </strong>\n                <span data-kid=\"1-3-1-1-2\" data-name=\"observation order disclaimer text\">\n                    Sequence is not a verified travel path.\n                </span>\n            </div>\n            <div class=\"provenance\" data-kid=\"1-3-1-2\" data-name=\"provenance disclaimer badge\">\n                Illustrative point\n                <br data-kid=\"1-3-1-2-1\" data-name=\"line break between disclaimer words\"/>\n                not GPS evidence\n            </div>\n        </div>\n        <div aria-hidden=\"true\" class=\"marker-halo\" data-kid=\"1-3-2\" data-name=\"decorative marker halo rings\">\n            <div class=\"demo-marker\" data-kid=\"1-3-2-1\" data-name=\"demo location marker pin\">\n                <i class=\"mdi mdi-map-marker\" data-kid=\"1-3-2-1-1\" data-name=\"map marker icon inside pin\">\n                </i>\n            </div>\n        </div>\n        <div class=\"marker-tag\" data-kid=\"1-3-3\" data-name=\"marker point tag label\">\n            01 · DEMO POINT\n        </div>\n        <div class=\"map-bottom-note\" data-kid=\"1-3-4\" data-name=\"map schematic disclaimer note\">\n            <i class=\"mdi mdi-map-outline\" data-kid=\"1-3-4-1\" data-name=\"map outline icon\">\n            </i>\n            <span data-kid=\"1-3-4-2\" data-name=\"schematic preview note text\">\n                Schematic preview · no map tiles\n            </span>\n        </div>\n        <button aria-label=\"Map orientation unavailable in demo\" class=\"coord-fab\" data-kid=\"1-3-5\" data-name=\"gps crosshairs floating action button\">\n            <i class=\"mdi mdi-crosshairs-gps\" data-kid=\"1-3-5-1\" data-name=\"crosshairs gps icon\">\n            </i>\n        </button>\n    </main>\n    <section aria-label=\"Selected waypoint details\" class=\"waypoint-sheet\" data-kid=\"1-4\" data-name=\"selected waypoint detail sheet\">\n        <div class=\"sheet-handle\" data-kid=\"1-4-1\" data-name=\"sheet drag handle\">\n        </div>\n        <div class=\"sheet-head\" data-kid=\"1-4-2\" data-name=\"sheet header row\">\n            <div class=\"sheet-title\" data-kid=\"1-4-2-1\" data-name=\"sheet title text\">\n                Selected observation\n            </div>\n            <span class=\"demo-label\" data-kid=\"1-4-2-2\" data-name=\"demo record badge\">\n                DEMO RECORD\n            </span>\n        </div>\n        <div class=\"waypoint-row\" data-kid=\"1-4-3\" data-name=\"waypoint summary row\">\n            <div class=\"waypoint-icon\" data-kid=\"1-4-3-1\" data-name=\"waypoint icon container\">\n                <i class=\"mdi mdi-cctv\" data-kid=\"1-4-3-1-1\" data-name=\"cctv camera icon\">\n                </i>\n            </div>\n            <div class=\"waypoint-copy\" data-kid=\"1-4-3-2\" data-name=\"waypoint text copy container\">\n                <div class=\"waypoint-name\" data-kid=\"1-4-3-2-1\" data-name=\"waypoint name text\">\n                    Demonstration camera point\n                </div>\n                <div class=\"waypoint-sub\" data-kid=\"1-4-3-2-2\" data-name=\"waypoint subtitle disclaimer text\">\n                    No real camera or case is linked to this marker.\n                </div>\n            </div>\n            <span class=\"sequence\" data-kid=\"1-4-3-3\" data-name=\"waypoint sequence number badge\">\n                01\n            </span>\n        </div>\n        <div class=\"detail-row\" data-kid=\"1-4-4\" data-name=\"detail grid row\">\n            <div class=\"detail-cell\" data-kid=\"1-4-4-1\" data-name=\"match similarity detail cell\">\n                <div class=\"detail-label\" data-kid=\"1-4-4-1-1\" data-name=\"match similarity detail label\">\n                    MATCH SIMILARITY\n                </div>\n                <div class=\"detail-value\" data-kid=\"1-4-4-1-2\" data-name=\"match similarity detail value\">\n                    Unavailable in demo\n                </div>\n            </div>\n            <div class=\"detail-cell\" data-kid=\"1-4-4-2\" data-name=\"detected at detail cell\">\n                <div class=\"detail-label\" data-kid=\"1-4-4-2-1\" data-name=\"detected at detail label\">\n                    DETECTED AT\n                </div>\n                <div class=\"detail-value missing\" data-kid=\"1-4-4-2-2\" data-name=\"detected at detail value\">\n                    Not in sample record\n                </div>\n            </div>\n        </div>\n        <div class=\"gps-notice\" data-kid=\"1-4-5\" data-name=\"unavailable GPS warning notification\">\n            <i class=\"mdi mdi-map-marker-off-outline\" data-kid=\"1-4-5-1\" data-name=\"disabled map marker warning icon\">\n            </i>\n            <span data-kid=\"1-4-5-2\" data-name=\"notice body text container\">\n                <strong data-kid=\"1-4-5-2-1\" data-name=\"notice bold heading text\">\n                    Observations without GPS\n                </strong>\n                stay in the timeline list and are not plotted or connected.\n            </span>\n        </div>\n        <button class=\"navigate-btn\" data-kid=\"1-4-6\" data-name=\"disabled navigate to camera button\" disabled=\"\">\n            <i class=\"mdi mdi-navigation-variant-outline\" data-kid=\"1-4-6-1\" data-name=\"navigation arrow icon\">\n            </i>\n            Navigate to Camera Location\n        </button>\n        <div class=\"navigate-hint\" data-kid=\"1-4-7\" data-name=\"navigate button availability hint text\">\n            Available when this observation has valid camera coordinates.\n        </div>\n    </section>\n    <div class=\"bottom-nav\" data-kid=\"1-5\" data-name=\"home indicator bar container\">\n        <span data-kid=\"1-5-1\" data-name=\"home indicator pill\">\n        </span>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-13T10:39:43.757994+00:00",
      "modified": "2026-10-13T10:41:17.533776+00:00",
      "id": "var_613d699c2a16",
      "contentHeight": 852
    },
    "var_0b0cb064d2f7": {
      "type": "variant",
      "label": "Home — Blue & Cream",
      "parentId": "var_c01bdf294e06",
      "themeId": null,
      "rect": {
        "x": 2046,
        "y": 0,
        "w": 393,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n.home-shell{--cream:#F8F3F0;--blue:#014BAA;--blue-deep:#063975;--ink:#172841;--muted:#617187;--paper:#FFFEFC;--line:#E6DDD7;--amber:#9A5C0B;--amber-bg:#FFF1D8;--green:#16744F;--green-bg:#E2F4E9;position:relative;width:min(100%,393px);height:min(852px,100vh);min-height:700px;margin:0 auto;display:flex;flex-direction:column;overflow:hidden;background:var(--cream);color:var(--ink);font-family:'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;box-shadow:0 20px 60px rgba(25,44,67,.16)}\n.home-shell *{box-sizing:border-box}\n.home-shell button{font:inherit;cursor:pointer}\n.sysbar{height:32px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 22px;color:#26394F;font-size:12px;font-weight:700}\n.sysicons{display:flex;align-items:center;gap:6px;color:#26394F;font-size:14px}\n.appbar{height:58px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 20px;border-bottom:1px solid #EDE4DF;background:rgba(248,243,240,.96)}\n.brand{display:flex;align-items:center;gap:9px;min-width:0}\n.brand-mark{width:31px;height:31px;border-radius:9px;background:var(--blue);color:white;display:grid;place-items:center;font-size:17px}\n.brand-name{font-size:12px;font-weight:800;letter-spacing:-.03em;color:var(--blue-deep);line-height:1.1}\n.brand-sub{margin-top:3px;font-size:9px;font-weight:600;color:var(--muted);letter-spacing:.02em}\n.header-actions{display:flex;align-items:center;gap:6px}\n.header-button{position:relative;width:40px;height:40px;border:0;background:transparent;color:var(--blue-deep);display:grid;place-items:center;border-radius:12px;font-size:21px}\n.header-button.profile{font-size:23px}\n.unread-dot{position:absolute;top:7px;right:8px;width:8px;height:8px;border:1.5px solid var(--cream);background:#C54753;border-radius:50%}\n.home-scroll{flex:1;min-height:0;overflow-y:auto;padding:20px 18px 24px;scrollbar-width:none;overscroll-behavior:contain}\n.home-scroll::-webkit-scrollbar{display:none}\n.greeting{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin:0 1px 15px}\n.greeting-title{font-size:22px;line-height:1.14;font-weight:800;letter-spacing:-.045em;color:var(--ink)}\n.greeting-copy{margin-top:5px;color:var(--muted);font-size:12px;line-height:1.45}\n.role-note{align-self:flex-start;margin-top:3px;padding:6px 8px;border:1px solid #DED4CD;border-radius:8px;color:#66768A;background:#FFFDFB;font-size:9px;font-weight:700;white-space:nowrap}\n.work-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 1px 8px}\n.section-title{font-size:14px;font-weight:800;letter-spacing:-.025em;color:var(--ink)}\n.section-link{border:0;background:transparent;padding:6px 2px;color:var(--blue);font-size:11px;font-weight:800}\n.review-card{padding:14px 14px 13px;background:var(--paper);border:1px solid #E6DDD7;border-radius:16px}\n.review-top{display:flex;align-items:center;justify-content:space-between;gap:7px}\n.sample-label{display:inline-flex;align-items:center;gap:5px;color:#66768A;font-size:9px;font-weight:800;letter-spacing:.025em}\n.sample-mark{width:6px;height:6px;border:1.5px solid #74849A;border-radius:50%}\n.pending-label{display:inline-flex;align-items:center;gap:5px;padding:5px 7px;background:var(--amber-bg);border-radius:7px;color:var(--amber);font-size:10px;font-weight:800;white-space:nowrap}\n.pending-dot{width:6px;height:6px;background:#D28A20;border-radius:50%}\n.review-title{margin-top:10px;font-size:14px;line-height:1.3;font-weight:800;letter-spacing:-.02em;color:var(--ink)}\n.review-copy{margin-top:3px;color:var(--muted);font-size:11px;line-height:1.45}\n.review-foot{display:flex;align-items:center;justify-content:space-between;gap:9px;margin-top:11px;padding-top:10px;border-top:1px solid #EEE7E2}\n.review-caveat{max-width:145px;color:#77859A;font-size:9px;line-height:1.3}\n.review-button{min-height:38px;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:0 11px;border:0;border-radius:10px;color:#fff;background:var(--blue);font-size:11px;font-weight:800;white-space:nowrap}\n.review-button i{font-size:14px}\n.report-card{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 16px;margin-top:14px;background:var(--blue);border-radius:17px;color:var(--cream)}\n.report-copy{min-width:0;max-width:230px}\n.report-title{font-size:16px;line-height:1.2;font-weight:800;letter-spacing:-.03em;color:#FFF9F5}\n.report-sub{margin-top:5px;color:#F8F3F0E8;font-size:11px;line-height:1.45}\n.report-button{flex:none;min-width:100px;min-height:39px;padding:0 11px;border:1px solid rgba(255,255,255,.7);border-radius:10px;background:var(--cream);color:var(--blue-deep);font-size:11px;font-weight:800}\n.case-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:19px 1px 6px}\n.case-list{background:var(--paper);border:1px solid var(--line);border-radius:14px;overflow:hidden}\n.case-row{display:flex;align-items:center;gap:10px;padding:11px 12px;min-height:57px}\n.case-icon{width:34px;height:34px;flex:none;border-radius:10px;background:#E9F0FA;color:var(--blue);display:grid;place-items:center;font-size:18px}\n.case-text{min-width:0;flex:1}\n.case-name{color:var(--ink);font-size:12px;font-weight:750;line-height:1.25}\n.case-description{margin-top:3px;color:var(--muted);font-size:10px;line-height:1.35}\n.row-arrow{border:0;background:transparent;color:#65768D;width:36px;height:36px;flex:none;display:grid;place-items:center;font-size:19px}\n.row-divider{height:1px;margin-left:56px;background:#EEE7E2}\n.officer-card{margin-top:10px;background:#F1E9E4;border-radius:13px;padding:11px 12px;display:flex;align-items:center;gap:10px}\n.officer-icon{width:31px;height:31px;display:grid;place-items:center;border-radius:9px;background:#E5D7CC;color:var(--blue-deep);font-size:17px;flex:none}\n.officer-text{flex:1;min-width:0}\n.officer-text strong{display:block;font-size:11px;color:var(--ink)}\n.officer-text span{display:block;margin-top:2px;font-size:9px;color:var(--muted)}\n.officer-action{border:0;background:transparent;color:var(--blue);font-size:10px;font-weight:800;padding:8px 3px}\n.bottom-nav{height:68px;flex:none;display:grid;grid-template-columns:repeat(4,1fr);align-items:center;padding:4px 12px 5px;background:#FFFEFC;border-top:1px solid #E7DED8}\n.nav-item{height:55px;border:0;background:transparent;color:#7B8798;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:3px;font-size:10px;font-weight:650;position:relative}\n.nav-item i{font-size:19px;line-height:1}\n.nav-item.active{color:var(--blue);font-weight:800}\n.nav-item.active:before{position:absolute;top:1px;width:46px;height:23px;content:'';border-radius:999px;background:#E9EFF8;z-index:0}\n.nav-item i,.nav-item span{position:relative;z-index:1}\n.nav-item.report-nav{color:var(--blue-deep)}\n.nav-item.report-nav i{width:28px;height:28px;display:grid;place-items:center;border-radius:9px;background:var(--blue);color:var(--cream);font-size:18px}\n.system-nav{height:19px;flex:none;background:#FFFEFC;display:grid;place-items:center}\n.system-nav span{width:108px;height:4px;border-radius:4px;background:#667287;opacity:.55}\n@media(max-height:760px){.home-scroll{padding-top:14px}.greeting{margin-bottom:10px}.report-card{margin-top:10px;padding:13px}.case-head{margin-top:14px}}\n@media(max-width:360px){.home-shell{min-width:320px}.home-scroll{padding-left:14px;padding-right:14px}.greeting-title{font-size:20px}.report-card{align-items:flex-start;flex-direction:column}.report-copy{max-width:none}.report-button{align-self:flex-start}}\n</style>\n<div class=\"home-shell\" data-kid=\"1\" data-screen=\"home\">\n    <div class=\"sysbar\" data-kid=\"1-1\">\n        <span data-kid=\"1-1-1\">\n            9:41\n        </span>\n        <span class=\"sysicons\" data-kid=\"1-1-2\">\n            <i class=\"mdi mdi-signal-cellular-3\" data-kid=\"1-1-2-1\">\n            </i>\n            <i class=\"mdi mdi-wifi\" data-kid=\"1-1-2-2\">\n            </i>\n            <i class=\"mdi mdi-battery-70\" data-kid=\"1-1-2-3\">\n            </i>\n        </span>\n    </div>\n    <header class=\"appbar\" data-kid=\"1-2\">\n        <div class=\"brand\" data-kid=\"1-2-1\">\n            <span class=\"brand-mark\" data-kid=\"1-2-1-1\">\n                <i class=\"mdi mdi-account-search-outline\" data-kid=\"1-2-1-1-1\">\n                </i>\n            </span>\n            <span data-kid=\"1-2-1-2\">\n                <span class=\"brand-name\" data-kid=\"1-2-1-2-1\">\n                    FIND-MISSING-PEP\n                </span>\n                <span class=\"brand-sub\" data-kid=\"1-2-1-2-2\">\n                    Search & support\n                </span>\n            </span>\n        </div>\n        <div class=\"header-actions\" data-kid=\"1-2-2\">\n            <button aria-label=\"Notifications\" class=\"header-button\" data-kid=\"1-2-2-1\" title=\"Notifications\">\n                <i class=\"mdi mdi-bell-outline\" data-kid=\"1-2-2-1-1\">\n                </i>\n                <span class=\"unread-dot\" data-kid=\"1-2-2-1-2\">\n                </span>\n            </button>\n            <button aria-label=\"Profile\" class=\"header-button profile\" data-kid=\"1-2-2-2\" title=\"Profile\">\n                <i class=\"mdi mdi-account-circle-outline\" data-kid=\"1-2-2-2-1\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"home-scroll\" data-kid=\"1-3\">\n        <section class=\"greeting\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <div class=\"greeting-title\" data-kid=\"1-3-1-1-1\">\n                    Your next step,\n                    <br data-kid=\"1-3-1-1-1-1\"/>\n                    made clear.\n                </div>\n                <div class=\"greeting-copy\" data-kid=\"1-3-1-1-2\">\n                    Report a missing person or follow up on a case.\n                </div>\n            </div>\n            <span class=\"role-note\" data-kid=\"1-3-1-2\" data-name=\"user role view badge\">\n                Officer view\n            </span>\n        </section>\n        <section aria-label=\"Pending sighting review\" data-kid=\"1-3-2\">\n            <div class=\"work-head\" data-kid=\"1-3-2-1\">\n                <div class=\"section-title\" data-kid=\"1-3-2-1-1\">\n                    Review a possible match\n                </div>\n                <span class=\"sample-label\" data-kid=\"1-3-2-1-2\">\n                    <span class=\"sample-mark\" data-kid=\"1-3-2-1-2-1\">\n                    </span>\n                    DEMO ONLY\n                </span>\n            </div>\n            <div class=\"review-card\" data-kid=\"1-3-2-2\">\n                <div class=\"review-top\" data-kid=\"1-3-2-2-1\">\n                    <span class=\"sample-label\" data-kid=\"1-3-2-2-1-1\">\n                        Example task · not a live alert\n                    </span>\n                    <span class=\"pending-label\" data-kid=\"1-3-2-2-1-2\">\n                        <span class=\"pending-dot\" data-kid=\"1-3-2-2-1-2-1\">\n                        </span>\n                        Pending review\n                    </span>\n                </div>\n                <div class=\"review-title\" data-kid=\"1-3-2-2-2\">\n                    Check a sighting before deciding\n                </div>\n                <div class=\"review-copy\" data-kid=\"1-3-2-2-3\">\n                    Compare the submitted evidence in the sightings feed. A match score is a lead, not proof.\n                </div>\n                <div class=\"review-foot\" data-kid=\"1-3-2-2-4\">\n                    <span class=\"review-caveat\" data-kid=\"1-3-2-2-4-1\">\n                        No real case, person or timestamp is shown.\n                    </span>\n                    <button aria-label=\"Open sightings to review evidence\" class=\"review-button\" data-kid=\"1-3-2-2-4-2\">\n                        Review sightings\n                        <i class=\"mdi mdi-arrow-right\" data-kid=\"1-3-2-2-4-2-1\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Start a missing person report\" class=\"report-card\" data-kid=\"1-3-3\">\n            <div class=\"report-copy\" data-kid=\"1-3-3-1\">\n                <div class=\"report-title\" data-kid=\"1-3-3-1-1\">\n                    Report a missing person\n                </div>\n                <div class=\"report-sub\" data-kid=\"1-3-3-1-2\">\n                    Share key details, an FIR and reference photos.\n                </div>\n            </div>\n            <button aria-label=\"Start a missing person report\" class=\"report-button\" data-kid=\"1-3-3-2\">\n                Start report\n                <i class=\"mdi mdi-arrow-right\" data-kid=\"1-3-3-2-1\">\n                </i>\n            </button>\n        </section>\n        <section aria-label=\"Your cases and sightings\" class=\"case-section\" data-kid=\"1-3-4\">\n            <div class=\"case-head\" data-kid=\"1-3-4-1\">\n                <div class=\"section-title\" data-kid=\"1-3-4-1-1\">\n                    Your casework\n                </div>\n                <span class=\"sample-label\" data-kid=\"1-3-4-1-2\">\n                    No totals shown\n                </span>\n            </div>\n            <div class=\"case-list\" data-kid=\"1-3-4-2\">\n                <div class=\"case-row\" data-kid=\"1-3-4-2-1\">\n                    <span class=\"case-icon\" data-kid=\"1-3-4-2-1-1\">\n                        <i class=\"mdi mdi-folder-multiple-outline\" data-kid=\"1-3-4-2-1-1-1\">\n                        </i>\n                    </span>\n                    <span class=\"case-text\" data-kid=\"1-3-4-2-1-2\">\n                        <span class=\"case-name\" data-kid=\"1-3-4-2-1-2-1\">\n                            Reported cases\n                        </span>\n                        <span class=\"case-description\" data-kid=\"1-3-4-2-1-2-2\">\n                            Open your cases and see their current status.\n                        </span>\n                    </span>\n                    <button aria-label=\"Open reported cases\" class=\"row-arrow\" data-kid=\"1-3-4-2-1-3\">\n                        <i class=\"mdi mdi-chevron-right\" data-kid=\"1-3-4-2-1-3-1\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"row-divider\" data-kid=\"1-3-4-2-2\">\n                </div>\n                <div class=\"case-row\" data-kid=\"1-3-4-2-3\">\n                    <span class=\"case-icon\" data-kid=\"1-3-4-2-3-1\">\n                        <i class=\"mdi mdi-cctv\" data-kid=\"1-3-4-2-3-1-1\">\n                        </i>\n                    </span>\n                    <span class=\"case-text\" data-kid=\"1-3-4-2-3-2\">\n                        <span class=\"case-name\" data-kid=\"1-3-4-2-3-2-1\">\n                            Live sightings\n                        </span>\n                        <span class=\"case-description\" data-kid=\"1-3-4-2-3-2-2\">\n                            Browse and filter possible CCTV matches.\n                        </span>\n                    </span>\n                    <button aria-label=\"Open live sightings\" class=\"row-arrow\" data-kid=\"1-3-4-2-3-3\">\n                        <i class=\"mdi mdi-chevron-right\" data-kid=\"1-3-4-2-3-3-1\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Officer-only FIR verification queue\" class=\"officer-card\" data-kid=\"1-3-5\">\n            <span class=\"officer-icon\" data-kid=\"1-3-5-1\">\n                <i class=\"mdi mdi-file-document-check-outline\" data-kid=\"1-3-5-1-1\">\n                </i>\n            </span>\n            <span class=\"officer-text\" data-kid=\"1-3-5-2\">\n                <strong data-kid=\"1-3-5-2-1\">\n                    FIR verification queue\n                </strong>\n                <span data-kid=\"1-3-5-2-2\">\n                    For officers · review submitted documents\n                </span>\n            </span>\n            <button aria-label=\"Open FIR verification queue\" class=\"officer-action\" data-kid=\"1-3-5-3\">\n                Open\n                <i class=\"mdi mdi-arrow-right\" data-kid=\"1-3-5-3-1\">\n                </i>\n            </button>\n        </section>\n    </main>\n    <nav aria-label=\"Main navigation\" class=\"bottom-nav\" data-kid=\"1-4\">\n        <button aria-current=\"page\" aria-label=\"Home\" class=\"nav-item active\" data-kid=\"1-4-1\">\n            <i class=\"mdi mdi-home-variant-outline\" data-kid=\"1-4-1-1\">\n            </i>\n            <span data-kid=\"1-4-1-2\">\n                Home\n            </span>\n        </button>\n        <button aria-label=\"Cases\" class=\"nav-item\" data-kid=\"1-4-2\">\n            <i class=\"mdi mdi-folder-multiple-outline\" data-kid=\"1-4-2-1\">\n            </i>\n            <span data-kid=\"1-4-2-2\">\n                Cases\n            </span>\n        </button>\n        <button aria-label=\"Sightings\" class=\"nav-item\" data-kid=\"1-4-3\">\n            <i class=\"mdi mdi-cctv\" data-kid=\"1-4-3-1\">\n            </i>\n            <span data-kid=\"1-4-3-2\">\n                Sightings\n            </span>\n        </button>\n        <button aria-label=\"Report missing person\" class=\"nav-item report-nav\" data-kid=\"1-4-4\">\n            <i class=\"mdi mdi-plus\" data-kid=\"1-4-4-1\">\n            </i>\n            <span data-kid=\"1-4-4-2\">\n                Report\n            </span>\n        </button>\n    </nav>\n    <div class=\"system-nav\" data-kid=\"1-5\">\n        <span data-kid=\"1-5-1\">\n        </span>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-13T10:39:48.746998+00:00",
