        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css\");\n:root{font-family:'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;color:#17233a;background:#f8f3f0;font-synthesis:none}\n*{box-sizing:border-box}\nbody{margin:0;background:#f8f3f0}\nbutton{font:inherit;color:inherit}\n.cases-phone{width:min(100%,393px);height:852px;max-height:100vh;min-height:720px;margin:0 auto;display:flex;flex-direction:column;background:#f8f3f0;overflow:hidden;box-shadow:0 22px 70px #1e2a421c}\n.statusbar{height:34px;flex:none;padding:8px 22px 0;display:flex;align-items:center;justify-content:space-between;background:#f8f3f0;color:#17233a;font-size:12px;font-weight:700;letter-spacing:.01em}\n.sys-icons{display:flex;gap:6px;align-items:center;font-size:14px;color:#223047}\n.appbar{height:62px;flex:none;display:flex;align-items:center;gap:11px;padding:0 16px;border-bottom:1px solid #e8dfd9;background:#f8f3f0}\n.appbar button{width:42px;height:42px;border:0;border-radius:13px;background:transparent;display:grid;place-items:center;color:#17233a;font-size:20px;cursor:pointer}\n.appbar-copy{flex:1;min-width:0}\n.appbar-title{font-size:17px;font-weight:750;line-height:1.15;letter-spacing:-.025em}\n.appbar-sub{margin-top:2px;color:#6e7480;font-size:11px;line-height:1.3}\n.refresh-btn{color:#014baa!important}\n.scroll-content{flex:1;min-height:0;overflow:auto;padding:20px 18px 28px;scrollbar-width:none}\n.scroll-content::-webkit-scrollbar,.filter-scroll::-webkit-scrollbar{display:none}\n.heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin:1px 0 13px}\n.heading h1{margin:0;color:#17233a;font-size:24px;font-weight:800;line-height:1.18;letter-spacing:-.045em}\n.heading p{margin:5px 0 0;color:#657081;font-size:13px;line-height:1.45}\n.demo-note{display:flex;gap:8px;align-items:flex-start;padding:10px 11px;margin:0 0 19px;border-radius:11px;background:#fffaf7;border:1px solid #e9ddd5;color:#535b68;font-size:11px;line-height:1.45}\n.demo-note i{color:#014baa;font-size:15px;flex:none;margin-top:1px}\n.filters-title{margin:0 0 8px;color:#4f5867;font-size:12px;font-weight:700;letter-spacing:.005em}\n.filter-scroll{display:flex;gap:7px;overflow-x:auto;padding:1px 0 6px;scrollbar-width:none;overscroll-behavior-x:contain}\n.filter-chip{height:38px;flex:none;padding:0 12px;border-radius:10px;border:1px solid #ddd4cf;background:#fffdfa;color:#424d5c;font-size:12px;font-weight:650;white-space:nowrap;cursor:pointer}\n.filter-chip.is-selected{border-color:#014baa;background:#014baa;color:#fffaf7;box-shadow:0 3px 8px #014baa20}\n.case-section-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:17px 0 4px}\n.case-section-head h2{margin:0;color:#17233a;font-size:14px;font-weight:750;letter-spacing:-.01em}\n.row-hint{color:#777e89;font-size:10px}\n.case-list{margin-top:4px;border-top:1px solid #ded6d0}\n.case-row{position:relative;width:100%;display:grid;grid-template-columns:44px minmax(0,1fr) 22px;gap:11px;align-items:start;padding:15px 1px 15px;text-align:left;background:transparent;border:0;border-bottom:1px solid #ded6d0;cursor:pointer}\n.case-mark{width:42px;height:42px;border-radius:12px;background:#e8eef9;color:#014baa;display:grid;place-items:center;font-size:13px;font-weight:800;letter-spacing:-.03em}\n.case-content{min-width:0}\n.case-top{display:flex;align-items:flex-start;justify-content:space-between;gap:7px;flex-wrap:wrap}\n.case-name{color:#17233a;font-size:14px;font-weight:750;line-height:1.35;letter-spacing:-.015em}\n.demo-label{margin-top:2px;color:#777e89;font-size:10px;font-weight:600;line-height:1.35}\n.state{display:inline-flex;align-items:center;gap:5px;max-width:100%;padding:4px 7px;border-radius:7px;font-size:10px;font-weight:700;line-height:1.25}\n.state:before{content:'';width:6px;height:6px;flex:none;border-radius:50%;background:currentColor}\n.state.active{color:#267358;background:#e6f2eb}\n.state.pending{color:#805215;background:#fbf0d9}\n.state.processing{color:#5b4b81;background:#efeafa}\n.state.found{color:#014baa;background:#e7eef9}\n.state.closed{color:#616873;background:#eceae8}\n.state.rejected{color:#a73b4d;background:#f9e8eb}\n.state.noface{color:#8c4c35;background:#f7e9e2}\n.demo-facts{display:flex;flex-direction:column;gap:5px;margin-top:8px;color:#515d6d;font-size:11px;line-height:1.4}\n.fact-line{display:flex;align-items:flex-start;gap:6px;min-width:0}\n.fact-line i{width:13px;flex:none;margin-top:1px;color:#65748b;font-size:13px}\n.fact-line span{min-width:0;overflow-wrap:anywhere}\n.fir-note{display:inline-flex;align-items:center;gap:5px;margin-top:7px;padding:4px 7px;border-radius:7px;background:#f3ece4;color:#5a4d3f;font-size:10px;font-weight:600;line-height:1.3}\n.fir-note i{font-size:12px}\n.row-chevron{padding-top:12px;color:#758196;font-size:17px}\n.case-row:hover .row-chevron,.case-row:focus-visible .row-chevron{color:#014baa}\n.empty-state{display:none;padding:23px 15px;margin-top:11px;border-radius:13px;background:#fffdfa;border:1px solid #e4dbd5;text-align:center}\n.empty-icon{width:37px;height:37px;margin:0 auto 8px;border-radius:12px;background:#e9eff9;color:#014baa;display:grid;place-items:center;font-size:19px}\n.empty-title{color:#17233a;font-size:14px;font-weight:750}\n.empty-copy{max-width:250px;margin:4px auto 0;color:#646d7b;font-size:12px;line-height:1.45}\n.empty-action{margin-top:11px;padding:8px 11px;border:1px solid #cad7ed;border-radius:9px;background:#f2f5fb;color:#014baa;font-size:11px;font-weight:700;cursor:pointer}\n.error-banner{display:none;padding:10px 11px;margin:10px 0 4px;border-radius:11px;background:#faebec;border:1px solid #e8c8cc;color:#8b3444;font-size:11px;line-height:1.4}\n.error-banner strong{display:block;margin-bottom:2px;color:#7d2d3c;font-size:12px}\n.toast{position:absolute;left:22px;right:22px;bottom:72px;z-index:5;display:none;padding:10px 12px;border-radius:10px;background:#17233a;color:#fffaf7;font-size:12px;box-shadow:0 5px 16px #17233a30}\n.bottom-nav{height:25px;flex:none;display:grid;place-items:center;background:#f8f3f0}\n.bottom-nav span{width:106px;height:4px;border-radius:4px;background:#18233a;opacity:.58}\n@media(max-width:360px){.scroll-content{padding-left:14px;padding-right:14px}.state{font-size:9px}.case-row{grid-template-columns:40px minmax(0,1fr) 18px;gap:8px}.case-mark{width:38px;height:38px}}\n</style>\n<div aria-label=\"My Cases screen\" class=\"cases-phone\" data-kid=\"1\" data-name=\"phone screen mock frame\">\n    <div class=\"statusbar\" data-kid=\"1-1\" data-name=\"status bar\">\n        <span data-kid=\"1-1-1\" data-name=\"status bar clock time\">\n            9:41\n        </span>\n        <span class=\"sys-icons\" data-kid=\"1-1-2\" data-name=\"status bar system icon group\">\n            <i class=\"mdi mdi-signal-cellular-3\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\">\n            </i>\n            <i class=\"mdi mdi-wifi\" data-kid=\"1-1-2-2\" data-name=\"Wi-Fi connection icon\">\n            </i>\n            <i class=\"mdi mdi-battery-70\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\">\n            </i>\n        </span>\n    </div>\n    <header class=\"appbar\" data-kid=\"1-2\" data-name=\"app header bar\">\n        <button aria-label=\"Back\" data-kid=\"1-2-1\" data-name=\"back navigation button\">\n            <i class=\"mdi mdi-arrow-left\" data-kid=\"1-2-1-1\" data-name=\"left arrow back icon\">\n            </i>\n        </button>\n        <div class=\"appbar-copy\" data-kid=\"1-2-2\" data-name=\"app header title group\">\n            <div class=\"appbar-title\" data-kid=\"1-2-2-1\" data-name=\"screen title text\">\n                My cases\n            </div>\n            <div class=\"appbar-sub\" data-kid=\"1-2-2-2\" data-name=\"screen subtitle text\">\n                Reported cases\n            </div>\n        </div>\n        <button aria-label=\"Refresh cases\" class=\"refresh-btn\" data-kid=\"1-2-3\" data-name=\"refresh cases button\" onclick=\"refreshCases()\">\n            <i class=\"mdi mdi-refresh\" data-kid=\"1-2-3-1\" data-name=\"refresh icon\">\n            </i>\n        </button>\n    </header>\n    <main class=\"scroll-content\" data-kid=\"1-3\" data-name=\"scrollable main content area\">\n        <div class=\"heading\" data-kid=\"1-3-1\" data-name=\"content heading block\">\n            <div data-kid=\"1-3-1-1\" data-name=\"heading text group\">\n                <h1 data-kid=\"1-3-1-1-1\" data-name=\"main section headline\">\n                    Your cases\n                </h1>\n                <p data-kid=\"1-3-1-1-2\" data-name=\"section descriptive subtitle\">\n                    Review reports and their current status.\n                </p>\n            </div>\n        </div>\n        <div class=\"demo-note\" data-kid=\"1-3-2\" data-name=\"demo disclaimer note\">\n            <i class=\"mdi mdi-information-outline\" data-kid=\"1-3-2-1\" data-name=\"information icon\">\n            </i>\n            <span data-kid=\"1-3-2-2\" data-name=\"disclaimer body text\">\n                <strong data-kid=\"1-3-2-2-1\" data-name=\"disclaimer bold lead-in\">\n                    Demo examples\n                </strong>\n                · Names and case details are illustrative. No real case records or urgent timestamps are shown.\n            </span>\n        </div>\n        <div class=\"filters-title\" data-kid=\"1-3-3\" data-name=\"filter label heading\">\n            Filter by status\n        </div>\n        <div aria-label=\"Filter cases by status\" class=\"filter-scroll\" data-kid=\"1-3-4\" data-name=\"horizontally scrolling status filter tabs\" role=\"tablist\">\n            <button class=\"filter-chip is-selected\" data-kid=\"1-3-4-1\" data-name=\"All cases filter chip\" data-status=\"all\" onclick=\"filterCases(this)\">\n                All cases\n            </button>\n            <button class=\"filter-chip\" data-kid=\"1-3-4-2\" data-name=\"Processing filter chip\" data-status=\"PROCESSING\" onclick=\"filterCases(this)\">\n                Processing\n            </button>\n            <button class=\"filter-chip\" data-kid=\"1-3-4-3\" data-name=\"Pending FIR filter chip\" data-status=\"PENDING_FIR_REVIEW\" onclick=\"filterCases(this)\">\n                Pending FIR\n            </button>\n            <button class=\"filter-chip\" data-kid=\"1-3-4-4\" data-name=\"Active search filter chip\" data-status=\"ACTIVE\" onclick=\"filterCases(this)\">\n                Active search\n            </button>\n            <button class=\"filter-chip\" data-kid=\"1-3-4-5\" data-name=\"Found filter chip\" data-status=\"FOUND\" onclick=\"filterCases(this)\">\n                Found\n            </button>\n            <button class=\"filter-chip\" data-kid=\"1-3-4-6\" data-name=\"Closed filter chip\" data-status=\"CLOSED\" onclick=\"filterCases(this)\">\n                Closed\n            </button>\n            <button class=\"filter-chip\" data-kid=\"1-3-4-7\" data-name=\"FIR rejected filter chip\" data-status=\"FIR_REJECTED\" onclick=\"filterCases(this)\">\n                FIR rejected\n            </button>\n            <button class=\"filter-chip\" data-kid=\"1-3-4-8\" data-name=\"No face filter chip\" data-status=\"REJECTED_NO_FACE\" onclick=\"filterCases(this)\">\n                No face\n            </button>\n        </div>\n        <div class=\"error-banner\" data-kid=\"1-3-5\" data-name=\"refresh error banner\" id=\"refresh-error\">\n            <strong data-kid=\"1-3-5-1\" data-name=\"error banner title\">\n                Couldn’t refresh cases\n            </strong>\n            Showing the cases already available. Pull to refresh again when your connection is back.\n        </div>\n        <div class=\"case-section-head\" data-kid=\"1-3-6\" data-name=\"case section header row\">\n            <h2 data-dynamic=\"true\" data-kid=\"1-3-6-1\" data-name=\"dynamic list section heading\" data-reason=\"heading text replaced by filterCases script based on selected filter\" id=\"list-heading\">\n                All cases\n            </h2>\n            <span class=\"row-hint\" data-kid=\"1-3-6-2\" data-name=\"case list tap hint\">\n                Tap a case to view details\n            </span>\n        </div>\n        <div class=\"case-list\" data-kid=\"1-3-7\" data-name=\"case list container\" id=\"case-list\">\n            <button aria-label=\"Open demo case A. Sharma details\" class=\"case-row\" data-case-status=\"ACTIVE\" data-kid=\"1-3-7-1\" data-name=\"collapsible case row button\" onclick=\"openCase('A. Sharma')\">\n                <span aria-hidden=\"true\" class=\"case-mark\" data-kid=\"1-3-7-1-1\" data-name=\"case owner initials avatar\">\n                    AS\n                </span>\n                <span class=\"case-content\" data-kid=\"1-3-7-1-2\" data-name=\"case row content group\">\n                    <span class=\"case-top\" data-kid=\"1-3-7-1-2-1\" data-name=\"case row top row\">\n                        <span data-kid=\"1-3-7-1-2-1-1\" data-name=\"case identity text group\">\n                            <span class=\"case-name\" data-kid=\"1-3-7-1-2-1-1-1\" data-name=\"case subject name\">\n                                A. Sharma\n                            </span>\n                            <span class=\"demo-label\" data-kid=\"1-3-7-1-2-1-1-2\" data-name=\"demo sample label\">\n                                Demo case · sample details\n                            </span>\n                        </span>\n                        <span class=\"state active\" data-kid=\"1-3-7-1-2-1-2\" data-name=\"case status pill\">\n                            Active search\n                        </span>\n                    </span>\n                    <span class=\"demo-facts\" data-kid=\"1-3-7-1-2-2\" data-name=\"case fact lines group\">\n                        <span class=\"fact-line\" data-kid=\"1-3-7-1-2-2-1\" data-name=\"age and gender fact line\">\n                            <i class=\"mdi mdi-account-outline\" data-kid=\"1-3-7-1-2-2-1-1\" data-name=\"account icon\">\n                            </i>\n                            <span data-kid=\"1-3-7-1-2-2-1-2\" data-name=\"age and gender fact text\">\n                                14 years · Female\n                            </span>\n                        </span>\n                        <span class=\"fact-line\" data-kid=\"1-3-7-1-2-2-2\" data-name=\"location fact line\">\n                            <i class=\"mdi mdi-map-marker-outline\" data-kid=\"1-3-7-1-2-2-2-1\" data-name=\"map location icon\">\n                            </i>\n                            <span data-kid=\"1-3-7-1-2-2-2-2\" data-name=\"location fact text\">\n                                Sample area · Demo city\n                            </span>\n                        </span>\n                    </span>\n                </span>\n                <span class=\"row-chevron\" data-kid=\"1-3-7-1-3\" data-name=\"case row expand chevron\">\n                    <i class=\"mdi mdi-chevron-right\" data-kid=\"1-3-7-1-3-1\" data-name=\"chevron right icon\">\n                    </i>\n                </span>\n            </button>\n            <button aria-label=\"Open demo case N. Devi details\" class=\"case-row\" data-case-status=\"PENDING_FIR_REVIEW\" data-kid=\"1-3-7-2\" data-name=\"case row button for N. Devi\" onclick=\"openCase('N. Devi')\">\n                <span aria-hidden=\"true\" class=\"case-mark\" data-kid=\"1-3-7-2-1\" data-name=\"case initials avatar ND\">\n                    ND\n                </span>\n                <span class=\"case-content\" data-kid=\"1-3-7-2-2\" data-name=\"case content for N. Devi\">\n                    <span class=\"case-top\" data-kid=\"1-3-7-2-2-1\" data-name=\"top row for N. Devi\">\n                        <span data-kid=\"1-3-7-2-2-1-1\" data-name=\"identity group for N. Devi\">\n                            <span class=\"case-name\" data-kid=\"1-3-7-2-2-1-1-1\" data-name=\"case name N. Devi\">\n                                N. Devi\n                            </span>\n                            <span class=\"demo-label\" data-kid=\"1-3-7-2-2-1-1-2\" data-name=\"demo label for N. Devi\">\n                                Demo case · sample details\n                            </span>\n                        </span>\n                        <span class=\"state pending\" data-kid=\"1-3-7-2-2-1-2\" data-name=\"status pill pending FIR\">\n                            Pending FIR review\n                        </span>\n                    </span>\n                    <span class=\"demo-facts\" data-kid=\"1-3-7-2-2-2\" data-name=\"facts for N. Devi\">\n                        <span class=\"fact-line\" data-kid=\"1-3-7-2-2-2-1\" data-name=\"age/gender fact line\">\n                            <i class=\"mdi mdi-account-outline\" data-kid=\"1-3-7-2-2-2-1-1\" data-name=\"account icon\">\n                            </i>\n                            <span data-kid=\"1-3-7-2-2-2-1-2\" data-name=\"age/gender text\">\n                                42 years · Female\n                            </span>\n                        </span>\n                        <span class=\"fact-line\" data-kid=\"1-3-7-2-2-2-2\" data-name=\"location fact line\">\n                            <i class=\"mdi mdi-map-marker-outline\" data-kid=\"1-3-7-2-2-2-2-1\" data-name=\"location icon\">\n                            </i>\n                            <span data-kid=\"1-3-7-2-2-2-2-2\" data-name=\"location text\">\n                                Location not provided in demo\n                            </span>\n                        </span>\n                    </span>\n                    <span class=\"fir-note\" data-kid=\"1-3-7-2-2-3\" data-name=\"FIR note badge\">\n                        <i class=\"mdi mdi-file-document-outline\" data-kid=\"1-3-7-2-2-3-1\" data-name=\"document icon\">\n                        </i>\n                        FIR number added · review pending\n                    </span>\n                </span>\n                <span class=\"row-chevron\" data-kid=\"1-3-7-2-3\" data-name=\"chevron for N. Devi row\">\n                    <i class=\"mdi mdi-chevron-right\" data-kid=\"1-3-7-2-3-1\" data-name=\"chevron right icon\">\n                    </i>\n                </span>\n            </button>\n            <button aria-label=\"Open demo case M. Kumar details\" class=\"case-row\" data-case-status=\"PROCESSING\" data-kid=\"1-3-7-3\" data-name=\"case row button for M. Kumar\" onclick=\"openCase('M. Kumar')\">\n                <span aria-hidden=\"true\" class=\"case-mark\" data-kid=\"1-3-7-3-1\" data-name=\"initials avatar MK\">\n                    MK\n                </span>\n                <span class=\"case-content\" data-kid=\"1-3-7-3-2\" data-name=\"content for M. Kumar\">\n                    <span class=\"case-top\" data-kid=\"1-3-7-3-2-1\" data-name=\"top row\">\n                        <span data-kid=\"1-3-7-3-2-1-1\" data-name=\"identity group\">\n                            <span class=\"case-name\" data-kid=\"1-3-7-3-2-1-1-1\" data-name=\"case name M. Kumar\">\n                                M. Kumar\n                            </span>\n                            <span class=\"demo-label\" data-kid=\"1-3-7-3-2-1-1-2\" data-name=\"demo label\">\n                                Demo case · sample details\n                            </span>\n                        </span>\n                        <span class=\"state processing\" data-kid=\"1-3-7-3-2-1-2\" data-name=\"processing status pill\">\n                            Processing\n                        </span>\n                    </span>\n                    <span class=\"demo-facts\" data-kid=\"1-3-7-3-2-2\" data-name=\"facts for M. Kumar\">\n                        <span class=\"fact-line\" data-kid=\"1-3-7-3-2-2-1\" data-name=\"age/gender fact line\">\n                            <i class=\"mdi mdi-account-outline\" data-kid=\"1-3-7-3-2-2-1-1\" data-name=\"account icon\">\n                            </i>\n                            <span data-kid=\"1-3-7-3-2-2-1-2\" data-name=\"age/gender text\">\n                                Age and gender not included\n                            </span>\n                        </span>\n                        <span class=\"fact-line\" data-kid=\"1-3-7-3-2-2-2\" data-name=\"location fact line\">\n                            <i class=\"mdi mdi-map-marker-outline\" data-kid=\"1-3-7-3-2-2-2-1\" data-name=\"location icon\">\n                            </i>\n                            <span data-kid=\"1-3-7-3-2-2-2-2\" data-name=\"location text\">\n                                Last-seen location not included\n                            </span>\n                        </span>\n                    </span>\n                </span>\n                <span class=\"row-chevron\" data-kid=\"1-3-7-3-3\" data-name=\"chevron for M. Kumar\">\n                    <i class=\"mdi mdi-chevron-right\" data-kid=\"1-3-7-3-3-1\" data-name=\"chevron right icon\">\n                    </i>\n                </span>\n            </button>\n        </div>\n        <div class=\"empty-state\" data-kid=\"1-3-8\" data-name=\"empty state panel\" id=\"filtered-empty\" role=\"status\">\n            <div class=\"empty-icon\" data-kid=\"1-3-8-1\" data-name=\"empty state icon container\">\n                <i class=\"mdi mdi-filter-remove-outline\" data-kid=\"1-3-8-1-1\" data-name=\"filter remove icon\">\n                </i>\n            </div>\n            <div class=\"empty-title\" data-kid=\"1-3-8-2\" data-name=\"empty state title\">\n                No cases match this status\n            </div>\n            <div class=\"empty-copy\" data-kid=\"1-3-8-3\" data-name=\"empty state copy\">\n                This filter has no demo records. Your other cases have not been removed.\n            </div>\n            <button class=\"empty-action\" data-kid=\"1-3-8-4\" data-name=\"reset filters button\" onclick=\"resetFilters()\">\n                Show all cases\n            </button>\n        </div>\n    </main>\n    <div class=\"toast\" data-dynamic=\"true\" data-kid=\"1-4\" data-name=\"transient toast notification\" data-reason=\"text set by openCase and cleared after timer\" id=\"case-toast\" role=\"status\">\n    </div>\n    <div aria-hidden=\"true\" class=\"bottom-nav\" data-kid=\"1-5\" data-name=\"home indicator bar\">\n        <span data-kid=\"1-5-1\" data-name=\"rounded home indicator pill\">\n        </span>\n    </div>\n</div>\n<script>\n    function filterCases(button){document.querySelectorAll('.filter-chip').forEach(chip=>chip.classList.remove('is-selected'));button.classList.add('is-selected');document.getElementById('refresh-error').style.display='none';const status=button.dataset.status;let visible=0;document.querySelectorAll('.case-row').forEach(row=>{const show=status==='all'||row.dataset.caseStatus===status;row.style.display=show?'grid':'none';if(show)visible++;});document.getElementById('case-list').style.display=visible?'block':'none';document.getElementById('filtered-empty').style.display=visible?'none':'block';document.getElementById('list-heading').textContent=status==='all'?'All cases':button.textContent;}\nfunction resetFilters(){const all=document.querySelector('.filter-chip[data-status=\"all\"]');filterCases(all);}\nfunction refreshCases(){const banner=document.getElementById('refresh-error');banner.style.display=banner.style.display==='block'?'none':'block';}\nfunction openCase(name){const toast=document.getElementById('case-toast');toast.textContent='Opening '+name+' · case details';toast.style.display='block';setTimeout(()=>{toast.style.display='none';},2200);}\n</script>\n",
      "comments": [],
      "created": "2026-10-13T10:40:08.651341+00:00",
      "modified": "2026-10-13T10:40:36.869157+00:00",
      "id": "var_eb3e6f8fcf16",
      "contentHeight": 852
    },
    "var_cea65da5c2f8": {
      "type": "variant",
      "label": "Case Detail — Blue & Cream",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6976,
        "y": 0,
        "w": 393,
        "h": 0
      },
      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap\");\n@import url(\"https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css\");\n.case-screen{--blue:#014BAA;--cream:#F8F3F0;--paper:#FFFDFC;--ink:#172536;--muted:#637181;--line:#E6DDD6;--green:#217A61;--green-bg:#E5F3ED;--amber:#9A6419;--amber-bg:#FFF2D8;--red:#B34E4E;--red-bg:#FBE9E8;--blue-soft:#EAF1F8;position:relative;display:flex;flex-direction:column;width:min(100%,393px);height:min(852px,100vh);min-height:740px;margin:0 auto;background:var(--cream);color:var(--ink);font-family:'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;font-size:13px;line-height:1.45;overflow:hidden;box-shadow:0 20px 70px rgba(14,34,58,.18);}\n.case-screen button{font-family:inherit;color:inherit;cursor:pointer;}\n.status-bar{height:30px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 20px;background:var(--blue);color:#fff8f0;font-size:11px;font-weight:700;letter-spacing:.01em;}\n.status-icons{display:flex;align-items:center;gap:6px;font-size:13px;}\n.topbar{height:54px;flex:none;display:flex;align-items:center;gap:8px;padding:0 16px;background:var(--paper);border-bottom:1px solid var(--line);}\n.back{width:36px;height:36px;border:0;background:transparent;border-radius:11px;color:var(--blue)!important;font-size:20px;display:grid;place-items:center;}\n.top-title{flex:1;font-size:16px;font-weight:750;letter-spacing:-.03em;}\n.top-action{display:flex;align-items:center;gap:5px;height:34px;padding:0 9px;border:1px solid #D9E4F0;border-radius:10px;background:#F1F5FA;color:var(--blue)!important;font-size:10px;font-weight:750;white-space:nowrap;}\n.top-action i{font-size:14px;}\n.scroll-region{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:14px 16px 24px;scrollbar-width:none;}\n.scroll-region::-webkit-scrollbar{display:none;}\n.demo-label{display:inline-flex;align-items:center;gap:5px;color:#F8F3F0;background:#0D3D78;border:1px solid #D8E8F7;border-radius:5px;padding:4px 7px;font-size:9px;line-height:1.2;font-weight:800;letter-spacing:.06em;text-transform:uppercase;}\n.case-hero{padding:15px 16px 14px;border-radius:17px;background:var(--blue);color:var(--cream);position:relative;overflow:hidden;}\n.hero-top{display:flex;align-items:center;justify-content:space-between;gap:8px;}\n.case-name{margin-top:12px;color:#fffaf4;font-size:24px;line-height:1.08;font-weight:800;letter-spacing:-.045em;}\n.case-meta{margin-top:5px;color:#E4EDF6;font-size:11px;font-weight:550;}\n.hero-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:13px;padding-top:11px;border-top:1px solid #ffffff3c;}\n.status-active{display:inline-flex;align-items:center;gap:6px;color:#F0FFF8;background:#17583F;border:1px solid #67B695;border-radius:8px;padding:6px 9px;font-size:10px;font-weight:750;}\n.state-dot{width:7px;height:7px;border-radius:50%;background:#67D0A4;}\n.demo-state{font-size:9px;color:#E6EEF7;text-align:right;}\n.section{margin-top:18px;}\n.section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:0 1px 9px;}\n.section-title{font-size:15px;font-weight:780;letter-spacing:-.025em;color:var(--ink);}\n.section-count{font-size:10px;color:var(--muted);font-weight:650;white-space:nowrap;}\n.text-link{display:flex;align-items:center;gap:4px;padding:6px 0;border:0;background:transparent;color:var(--blue)!important;font-size:11px;font-weight:750;white-space:nowrap;}\n.text-link i{font-size:14px;}\n.photo-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px;}\n.photo-cell{min-width:0;padding:7px 7px 8px;background:var(--paper);border:1px solid var(--line);border-radius:13px;}\n.photo-frame{height:150px;position:relative;overflow:hidden;border-radius:9px;background:#E9E2DB;}\n.photo-frame img{display:block;width:100%;height:100%;object-fit:cover;}\n.photo-tag{position:absolute;left:6px;right:6px;bottom:6px;padding:4px 5px;border-radius:5px;background:#11233be8;color:#fff8f0;font-size:8px;font-weight:800;letter-spacing:.035em;text-align:center;text-transform:uppercase;}\n.photo-title{margin:8px 2px 1px;font-size:11px;font-weight:780;}\n.photo-sub{margin:0 2px;color:var(--muted);font-size:9px;line-height:1.35;}\n.provenance{display:flex;align-items:flex-start;gap:7px;margin-top:8px;padding:9px 10px;border:1px solid #D7E0EA;border-radius:10px;background:#EEF3F8;color:#30475F;font-size:10px;line-height:1.4;}\n.provenance i{flex:none;font-size:14px;color:var(--blue);}\n.state-panel{padding:13px 14px 12px;border:1px solid var(--line);border-radius:14px;background:var(--paper);}\n.state-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px;}\n.state-now{font-size:10px;font-weight:750;color:var(--green);background:var(--green-bg);border-radius:6px;padding:5px 7px;}\n.state-path{display:flex;flex-direction:column;gap:0;}\n.path-row{display:grid;grid-template-columns:20px minmax(0,1fr) auto;align-items:start;gap:9px;min-height:37px;position:relative;}\n.path-row:not(:last-child):before{content:\"\";position:absolute;left:8px;top:17px;bottom:-1px;width:2px;background:#B7D7C9;}\n.path-mark{z-index:1;width:17px;height:17px;margin-top:1px;border-radius:50%;display:grid;place-items:center;background:var(--green);color:#fff;font-size:10px;}\n.path-mark.current{width:17px;height:17px;border:3px solid var(--blue);background:var(--cream);box-shadow:0 0 0 3px #D6E3F2;}\n.path-copy strong{display:block;font-size:11px;line-height:1.25;font-weight:750;}\n.path-copy span{display:block;margin-top:2px;color:var(--muted);font-size:9px;line-height:1.3;}\n.path-current{align-self:start;margin-top:1px;color:var(--blue);font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.035em;}\n.path-outcomes{padding:9px 0 0 28px;margin-top:3px;border-top:1px dashed #D5CCC5;color:var(--muted);font-size:9px;line-height:1.5;}\n.outcome{font-weight:750;}\n.outcome.reject{color:var(--red);}\n.outcome.close{color:#596676;}\n.outcome.found{color:var(--green);}\n.data-surface{border:1px solid var(--line);border-radius:14px;background:var(--paper);padding:12px 14px;}\n.field-row{display:flex;justify-content:space-between;gap:14px;padding:8px 0;border-bottom:1px solid #EFE8E2;}\n.field-row:last-child{border-bottom:0;padding-bottom:1px;}\n.field-label{flex:none;color:#566675;font-size:10px;font-weight:650;}\n.field-value{max-width:62%;color:var(--ink);font-size:11px;font-weight:700;text-align:right;overflow-wrap:anywhere;}\n.field-value.missing{color:#718090;font-weight:550;}\n.fir-card{border:1px solid var(--line);border-radius:14px;background:var(--paper);padding:13px 14px;}\n.fir-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:5px;}\n.fir-title{font-size:14px;font-weight:780;letter-spacing:-.02em;}\n.fir-status{display:inline-flex;align-items:center;gap:5px;padding:5px 8px;border-radius:7px;color:var(--green);background:var(--green-bg);font-size:9px;font-weight:800;white-space:nowrap;}\n.fir-status i{font-size:13px;}\n.fir-note{margin:2px 0 6px;color:#536676;font-size:10px;line-height:1.45;}\n.sighting{display:flex;align-items:center;gap:10px;padding:10px;background:var(--paper);border:1px solid var(--line);border-radius:13px;}\n.score{width:47px;height:47px;flex:none;border-radius:50%;display:grid;place-items:center;background:#F5EBDD;border:3px solid #D09A43;color:#8A5812;font-size:11px;font-weight:800;}\n.sight-copy{flex:1;min-width:0;}\n.sight-title{font-size:11px;font-weight:780;line-height:1.25;}\n.sight-meta{margin-top:3px;color:var(--muted);font-size:9px;line-height:1.4;}\n.sight-state{display:inline-flex;align-items:center;margin-top:5px;padding:3px 6px;border-radius:5px;color:var(--amber);background:var(--amber-bg);font-size:8px;font-weight:800;text-transform:uppercase;letter-spacing:.025em;}\n.sight-open{width:32px;height:36px;flex:none;border:0;background:transparent;color:var(--blue)!important;font-size:19px;}\n.route-action{display:flex;align-items:center;gap:11px;width:100%;padding:12px;border:1px solid #CBD8E6;border-radius:13px;background:#EEF3F8;text-align:left;}\n.route-icon{width:38px;height:38px;flex:none;display:grid;place-items:center;border-radius:10px;background:#DCE7F2;color:var(--blue);font-size:20px;}\n.route-copy{flex:1;min-width:0;}\n.route-copy strong{display:block;font-size:12px;font-weight:780;}\n.route-copy span{display:block;margin-top:2px;color:#596D7F;font-size:9px;line-height:1.3;}\n.route-arrow{color:var(--blue);font-size:17px;}\n.case-footer{flex:none;display:flex;gap:8px;padding:10px 15px calc(10px + env(safe-area-inset-bottom));background:var(--paper);border-top:1px solid var(--line);}\n.footer-case{height:44px;flex:1;border-radius:11px;border:1px solid #C8BFB9;background:transparent;color:#354454!important;font-size:11px;font-weight:750;}\n.footer-map{height:44px;flex:1.15;border:0;border-radius:11px;background:var(--blue);color:#fffaf4!important;font-size:11px;font-weight:780;display:flex;align-items:center;justify-content:center;gap:6px;}\n.footer-map i{font-size:15px;}\n.bottom-nav{height:55px;flex:none;display:flex;align-items:center;justify-content:space-around;background:var(--paper);border-top:1px solid #F0E8E2;padding-bottom:env(safe-area-inset-bottom);}\n.nav-item{min-width:55px;border:0;background:transparent;color:#718090!important;display:flex;align-items:center;flex-direction:column;gap:2px;font-size:9px;font-weight:650;}\n.nav-item i{font-size:18px;line-height:1.1;}\n.nav-item.selected{color:var(--blue)!important;}\n.modal-backdrop{position:absolute;inset:30px 0 0;z-index:5;display:none;align-items:flex-end;justify-content:center;padding:12px;background:rgba(16,31,49,.46);}\n.modal-backdrop.open{display:flex;}\n.close-dialog{width:100%;padding:17px 16px 14px;border-radius:18px;background:var(--paper);border:1px solid #D7D0CA;box-shadow:0 20px 50px #12253a2a;}\n.grabber{width:34px;height:4px;margin:0 auto 13px;border-radius:8px;background:#C7C0BA;}\n.dialog-title{font-size:17px;font-weight:800;letter-spacing:-.03em;}\n.dialog-copy{margin-top:7px;color:#4C5D6A;font-size:12px;line-height:1.5;}\n.dialog-warning{margin-top:11px;padding:10px;border-radius:9px;background:#FFF2D8;color:#805114;font-size:11px;line-height:1.45;}\n.dialog-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px;}\n.dialog-actions button{height:42px;border-radius:10px;font-size:11px;font-weight:750;}\n.dialog-cancel{border:1px solid var(--line);background:#F7F3F0;}\n.dialog-confirm{border:0;background:var(--blue);color:white!important;}\n@media(max-height:760px){.case-screen{min-height:700px}.scroll-region{padding-top:10px}.photo-frame{height:126px}.section{margin-top:14px}}\n</style>\n<div class=\"case-screen\" data-kid=\"1\" data-name=\"case details mobile screen container\">\n    <div class=\"status-bar\" data-kid=\"1-1\">\n        <span data-kid=\"1-1-1\">\n            9:41\n        </span>\n        <span class=\"status-icons\" data-kid=\"1-1-2\">\n            <i class=\"mdi mdi-signal-cellular-3\" data-kid=\"1-1-2-1\">\n            </i>\n            <i class=\"mdi mdi-wifi\" data-kid=\"1-1-2-2\">\n            </i>\n            <i class=\"mdi mdi-battery-70\" data-kid=\"1-1-2-3\">\n            </i>\n        </span>\n    </div>\n    <header class=\"topbar\" data-kid=\"1-2\">\n        <button aria-label=\"Back to cases\" class=\"back\" data-kid=\"1-2-1\">\n            <i class=\"mdi mdi-arrow-left\" data-kid=\"1-2-1-1\">\n            </i>\n        </button>\n        <div class=\"top-title\" data-kid=\"1-2-2\">\n            Case details\n        </div>\n    </header>\n    <main class=\"scroll-region\" data-kid=\"1-3\">\n        <section aria-label=\"Sample case identity\" class=\"case-hero\" data-kid=\"1-3-1\">\n            <div class=\"hero-top\" data-kid=\"1-3-1-1\">\n                <span class=\"demo-label\" data-kid=\"1-3-1-1-1\">\n                    <i class=\"mdi mdi-flask-outline\" data-kid=\"1-3-1-1-1-1\">\n                    </i>\n                    Demo record\n                </span>\n                <span class=\"demo-state\" data-kid=\"1-3-1-1-2\">\n                    Training preview · not a live case\n                </span>\n            </div>\n            <div class=\"case-name\" data-kid=\"1-3-1-2\">\n                Sample subject\n            </div>\n            <div class=\"case-meta\" data-kid=\"1-3-1-3\">\n                Case identity is illustrative only\n            </div>\n            <div class=\"hero-bottom\" data-kid=\"1-3-1-4\">\n                <span class=\"status-active\" data-kid=\"1-3-1-4-1\">\n                    <span class=\"state-dot\" data-kid=\"1-3-1-4-1-1\">\n                    </span>\n                    Active search\n                </span>\n                <span class=\"demo-state\" data-kid=\"1-3-1-4-2\">\n                    Status shown as a sample\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Reference photos\" class=\"section\" data-kid=\"1-3-2\">\n            <div class=\"section-head\" data-kid=\"1-3-2-1\">\n                <div class=\"section-title\" data-kid=\"1-3-2-1-1\">\n                    Reference photos\n                </div>\n                <button class=\"text-link\" data-kid=\"1-3-2-1-2\">\n                    <i class=\"mdi mdi-plus\" data-kid=\"1-3-2-1-2-1\">\n                    </i>\n                    Add photo\n                </button>\n            </div>\n            <div class=\"photo-pair\" data-kid=\"1-3-2-2\">\n                <div class=\"photo-cell\" data-kid=\"1-3-2-2-1\">\n                    <div class=\"photo-frame\" data-kid=\"1-3-2-2-1-1\">\n                        <img alt=\"Repository demo source portrait, not live case evidence\" data-kid=\"1-3-2-2-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/test_image/image.png\"/>\n                        <span class=\"photo-tag\" data-kid=\"1-3-2-2-1-1-2\">\n                            Demo fixture · not case evidence\n                        </span>\n                    </div>\n                    <div class=\"photo-title\" data-kid=\"1-3-2-2-1-2\">\n                        Original photo\n                    </div>\n                    <div class=\"photo-sub\" data-kid=\"1-3-2-2-1-3\">\n                        Primary reference · demo image\n                    </div>\n                </div>\n                <div class=\"photo-cell\" data-kid=\"1-3-2-2-2\">\n                    <div class=\"photo-frame\" data-kid=\"1-3-2-2-2-1\">\n                        <img alt=\"Demo aligned 112 by 112 crop, not live case evidence\" data-kid=\"1-3-2-2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/test_image/image_aligned_112x112.jpg\"/>\n                        <span class=\"photo-tag\" data-kid=\"1-3-2-2-2-1-2\">\n                            Demo fixture · not case evidence\n                        </span>\n                    </div>\n                    <div class=\"photo-title\" data-kid=\"1-3-2-2-2-2\">\n                        Aligned face crop\n                    </div>\n                    <div class=\"photo-sub\" data-kid=\"1-3-2-2-2-3\">\n                        112 × 112 · demo alignment\n                    </div>\n                </div>\n            </div>\n            <div class=\"provenance\" data-kid=\"1-3-2-3\">\n                <i class=\"mdi mdi-information-outline\" data-kid=\"1-3-2-3-1\">\n                </i>\n                <span data-kid=\"1-3-2-3-2\">\n                    These are repository test images, not a real missing-person record. Do not use as current case evidence.\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Case status and recorded path\" class=\"section\" data-kid=\"1-3-3\">\n            <div class=\"section-head\" data-kid=\"1-3-3-1\">\n                <div class=\"section-title\" data-kid=\"1-3-3-1-1\">\n                    Case status\n                </div>\n                <span class=\"section-count\" data-kid=\"1-3-3-1-2\">\n                    Record path\n                </span>\n            </div>\n            <div class=\"state-panel\" data-kid=\"1-3-3-2\">\n                <div class=\"state-head\" data-kid=\"1-3-3-2-1\">\n                    <span data-kid=\"1-3-3-2-1-1\" style=\"font-size:11px;font-weight:750\">\n                        Current recorded state\n                    </span>\n                    <span class=\"state-now\" data-kid=\"1-3-3-2-1-2\">\n                        Active search · demo\n                    </span>\n                </div>\n                <div class=\"state-path\" data-kid=\"1-3-3-2-2\">\n                    <div class=\"path-row\" data-kid=\"1-3-3-2-2-1\">\n                        <span class=\"path-mark\" data-kid=\"1-3-3-2-2-1-1\">\n                            <i class=\"mdi mdi-check\" data-kid=\"1-3-3-2-2-1-1-1\">\n                            </i>\n                        </span>\n                        <div class=\"path-copy\" data-kid=\"1-3-3-2-2-1-2\">\n                            <strong data-kid=\"1-3-3-2-2-1-2-1\">\n                                Report submitted\n                            </strong>\n                            <span data-kid=\"1-3-3-2-2-1-2-2\">\n                                Shown as a sample event only\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"path-row\" data-kid=\"1-3-3-2-2-2\">\n                        <span class=\"path-mark current\" data-kid=\"1-3-3-2-2-2-1\">\n                        </span>\n                        <div class=\"path-copy\" data-kid=\"1-3-3-2-2-2-2\">\n                            <strong data-kid=\"1-3-3-2-2-2-2-1\">\n                                Active search\n                            </strong>\n                            <span data-kid=\"1-3-3-2-2-2-2-2\">\n                                Current case state · demo record\n                            </span>\n                        </div>\n                        <span class=\"path-current\" data-kid=\"1-3-3-2-2-2-3\">\n                            Now\n                        </span>\n                    </div>\n                </div>\n                <div class=\"path-outcomes\" data-kid=\"1-3-3-2-3\">\n                    The path stops at the recorded state. Other records may end at\n                    <span class=\"outcome reject\" data-kid=\"1-3-3-2-3-1\">\n                        FIR rejected\n                    </span>\n                    ,\n                    <span class=\"outcome reject\" data-kid=\"1-3-3-2-3-2\">\n                        No usable face\n                    </span>\n                    ,\n                    <span class=\"outcome found\" data-kid=\"1-3-3-2-3-3\">\n                        Found\n                    </span>\n                    , or\n                    <span class=\"outcome close\" data-kid=\"1-3-3-2-3-4\">\n                        Closed\n                    </span>\n                    ; later steps are not marked complete.\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Demographics and last seen information\" class=\"section\" data-kid=\"1-3-4\">\n            <div class=\"section-head\" data-kid=\"1-3-4-1\">\n                <div class=\"section-title\" data-kid=\"1-3-4-1-1\">\n                    Person & last-seen details\n                </div>\n                <span class=\"section-count\" data-kid=\"1-3-4-1-2\">\n                    Demo values\n                </span>\n            </div>\n            <div class=\"data-surface\" data-kid=\"1-3-4-2\">\n                <div class=\"field-row\" data-kid=\"1-3-4-2-1\">\n                    <span class=\"field-label\" data-kid=\"1-3-4-2-1-1\">\n                        Age · gender\n                    </span>\n                    <span class=\"field-value missing\" data-kid=\"1-3-4-2-1-2\">\n                        Not in demo record\n                    </span>\n                </div>\n                <div class=\"field-row\" data-kid=\"1-3-4-2-2\">\n                    <span class=\"field-label\" data-kid=\"1-3-4-2-2-1\">\n                        Height\n                    </span>\n                    <span class=\"field-value missing\" data-kid=\"1-3-4-2-2-2\">\n                        Not in demo record\n                    </span>\n                </div>\n                <div class=\"field-row\" data-kid=\"1-3-4-2-3\">\n                    <span class=\"field-label\" data-kid=\"1-3-4-2-3-1\">\n                        Last seen area\n                    </span>\n                    <span class=\"field-value missing\" data-kid=\"1-3-4-2-3-2\">\n                        Not in demo record\n                    </span>\n                </div>\n                <div class=\"field-row\" data-kid=\"1-3-4-2-4\">\n                    <span class=\"field-label\" data-kid=\"1-3-4-2-4-1\">\n                        Last seen time\n                    </span>\n                    <span class=\"field-value missing\" data-kid=\"1-3-4-2-4-2\">\n                        Not in demo record\n                    </span>\n                </div>\n                <div class=\"field-row\" data-kid=\"1-3-4-2-5\">\n                    <span class=\"field-label\" data-kid=\"1-3-4-2-5-1\">\n                        Description\n                    </span>\n                    <span class=\"field-value missing\" data-kid=\"1-3-4-2-5-2\">\n                        Not in demo record\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Police FIR record\" class=\"section\" data-kid=\"1-3-5\">\n            <div class=\"section-head\" data-kid=\"1-3-5-1\">\n                <div class=\"section-title\" data-kid=\"1-3-5-1-1\">\n                    Police FIR record\n                </div>\n                <span class=\"section-count\" data-kid=\"1-3-5-1-2\">\n                    Demo values\n                </span>\n            </div>\n            <div class=\"fir-card\" data-kid=\"1-3-5-2\">\n                <div class=\"fir-head\" data-kid=\"1-3-5-2-1\">\n                    <div class=\"fir-title\" data-kid=\"1-3-5-2-1-1\">\n                        FIR details\n                    </div>\n                    <span class=\"fir-status\" data-kid=\"1-3-5-2-1-2\">\n                        <i class=\"mdi mdi-check-circle\" data-kid=\"1-3-5-2-1-2-1\">\n                        </i>\n                        Verified · demo\n                    </span>\n                </div>\n                <p class=\"fir-note\" data-kid=\"1-3-5-2-2\">\n                    FIR status is separate from the case status. Rejected FIRs use the rejection state, not this verified treatment.\n                </p>\n                <div class=\"field-row\" data-kid=\"1-3-5-2-3\">\n                    <span class=\"field-label\" data-kid=\"1-3-5-2-3-1\">\n                        FIR number\n                    </span>\n                    <span class=\"field-value missing\" data-kid=\"1-3-5-2-3-2\">\n                        Not in demo record\n                    </span>\n                </div>\n                <div class=\"field-row\" data-kid=\"1-3-5-2-4\">\n                    <span class=\"field-label\" data-kid=\"1-3-5-2-4-1\">\n                        Police station\n                    </span>\n                    <span class=\"field-value missing\" data-kid=\"1-3-5-2-4-2\">\n                        Not in demo record\n                    </span>\n                </div>\n                <div class=\"field-row\" data-kid=\"1-3-5-2-5\">\n                    <span class=\"field-label\" data-kid=\"1-3-5-2-5-1\">\n                        Date filed\n                    </span>\n                    <span class=\"field-value missing\" data-kid=\"1-3-5-2-5-2\">\n                        Not in demo record\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Associated CCTV sightings\" class=\"section\" data-kid=\"1-3-6\">\n            <div class=\"section-head\" data-kid=\"1-3-6-1\">\n                <div class=\"section-title\" data-kid=\"1-3-6-1-1\">\n                    CCTV sightings\n                </div>\n                <span class=\"section-count\" data-kid=\"1-3-6-1-2\">\n                    1 demo entry\n                </span>\n            </div>\n            <button aria-label=\"Open demo sighting in Forensic Inspector\" class=\"sighting\" data-kid=\"1-3-6-2\">\n                <span class=\"score\" data-kid=\"1-3-6-2-1\">\n                    81%\n                </span>\n                <span class=\"sight-copy\" data-kid=\"1-3-6-2-2\">\n                    <span class=\"sight-title\" data-kid=\"1-3-6-2-2-1\">\n                        Camera location not provided\n                    </span>\n                    <span class=\"sight-meta\" data-kid=\"1-3-6-2-2-2\">\n                        Timestamp unavailable · illustrative score only\n                    </span>\n                    <span class=\"sight-state\" data-kid=\"1-3-6-2-2-3\">\n                        Pending review · demo\n                    </span>\n                </span>\n                <span class=\"sight-open\" data-kid=\"1-3-6-2-3\">\n                    <i class=\"mdi mdi-chevron-right\" data-kid=\"1-3-6-2-3-1\">\n                    </i>\n                </span>\n            </button>\n            <div class=\"provenance\" data-kid=\"1-3-6-3\">\n                <i class=\"mdi mdi-information-outline\" data-kid=\"1-3-6-3-1\">\n                </i>\n                <span data-kid=\"1-3-6-3-2\">\n                    No real CCTV image or sighting record is included in this preview. This sample row is not a live match.\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Movement trajectory action\" class=\"section\" data-kid=\"1-3-7\">\n            <div class=\"section-head\" data-kid=\"1-3-7-1\">\n                <div class=\"section-title\" data-kid=\"1-3-7-1-1\">\n                    Movement trajectory\n                </div>\n            </div>\n            <button aria-label=\"View movement trajectory map\" class=\"route-action\" data-kid=\"1-3-7-2\">\n                <span class=\"route-icon\" data-kid=\"1-3-7-2-1\">\n                    <i class=\"mdi mdi-map-marker-path\" data-kid=\"1-3-7-2-1-1\">\n                    </i>\n                </span>\n                <span class=\"route-copy\" data-kid=\"1-3-7-2-2\">\n                    <strong data-kid=\"1-3-7-2-2-1\">\n                        View sighting map\n                    </strong>\n                    <span data-kid=\"1-3-7-2-2-2\">\n                        Only observations with recorded coordinates appear.\n                    </span>\n                </span>\n                <span class=\"route-arrow\" data-kid=\"1-3-7-2-3\">\n                    <i class=\"mdi mdi-arrow-right\" data-kid=\"1-3-7-2-3-1\">\n                    </i>\n                </span>\n            </button>\n        </section>\n        <div data-kid=\"1-3-8\" style=\"height:14px\">\n        </div>\n    </main>\n    <footer class=\"case-footer\" data-kid=\"1-4\" data-name=\"case footer action bar\">\n        <button class=\"footer-case\" data-kid=\"1-4-1\" data-name=\"case footer action bar\" onclick=\"document.getElementById('close-case').classList.add('open')\">\n            <i class=\"mdi mdi-check-circle-outline\" data-kid=\"1-4-1-1\">\n            </i>\n            Close case\n        </button>\n    </footer>\n    <nav aria-label=\"Main navigation\" class=\"bottom-nav\" data-kid=\"1-5\">\n        <button class=\"nav-item\" data-kid=\"1-5-1\">\n            <i class=\"mdi mdi-home-outline\" data-kid=\"1-5-1-1\">\n            </i>\n            Home\n        </button>\n        <button class=\"nav-item selected\" data-kid=\"1-5-2\">\n            <i class=\"mdi mdi-folder-outline\" data-kid=\"1-5-2-1\">\n            </i>\n            Cases\n        </button>\n        <button class=\"nav-item\" data-kid=\"1-5-3\">\n            <i class=\"mdi mdi-cctv\" data-kid=\"1-5-3-1\">\n            </i>\n            Sightings\n        </button>\n        <button class=\"nav-item\" data-kid=\"1-5-4\">\n            <i class=\"mdi mdi-account-outline\" data-kid=\"1-5-4-1\">\n            </i>\n            Profile\n        </button>\n    </nav>\n    <div class=\"modal-backdrop\" data-kid=\"1-6\" id=\"close-case\" onclick=\"if(event.target===this)this.classList.remove('open')\" role=\"presentation\">\n        <section aria-labelledby=\"dialog-title\" aria-modal=\"true\" class=\"close-dialog\" data-kid=\"1-6-1\" role=\"dialog\">\n            <div class=\"grabber\" data-kid=\"1-6-1-1\">\n            </div>\n            <div class=\"dialog-title\" data-kid=\"1-6-1-2\" id=\"dialog-title\">\n                Close this case?\n            </div>\n            <div class=\"dialog-copy\" data-kid=\"1-6-1-3\">\n                Closing stops active CCTV scanning for this case. Continue only if the search should end.\n            </div>\n            <div class=\"dialog-warning\" data-kid=\"1-6-1-4\">\n                This action is available only while the sample case is not Found or Closed.\n            </div>\n            <div class=\"dialog-actions\" data-kid=\"1-6-1-5\">\n                <button class=\"dialog-cancel\" data-kid=\"1-6-1-5-1\" onclick=\"document.getElementById('close-case').classList.remove('open')\">\n                    Go back\n                </button>\n                <button class=\"dialog-confirm\" data-kid=\"1-6-1-5-2\" onclick=\"document.getElementById('close-case').classList.remove('open')\">\n                    Confirm closure\n                </button>\n            </div>\n        </section>\n    </div>\n</div>\n",
