      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n.notification-screen{--cream:#F8F3F0;--paper:#FFFCF9;--blue:#014BAA;--ink:#17243A;--muted:#657187;--line:#E9E2DC;--green:#187757;--green-bg:#E6F3EC;--amber:#956114;--amber-bg:#FBF0D9;--rose:#A83B50;--rose-bg:#F8E8E9;width:min(100%,393px);height:min(852px,100vh);min-height:720px;margin:0 auto;display:flex;flex-direction:column;overflow:hidden;background:var(--cream);color:var(--ink);font-family:'Plus Jakarta Sans','Noto Sans Devanagari',system-ui,sans-serif;box-shadow:0 18px 60px rgba(39,35,31,.16);}\n.device-status{height:34px;flex:none;display:flex;justify-content:space-between;align-items:center;padding:0 22px;color:#222c3a;background:var(--cream);font-size:12px;font-weight:700;}\n.status-icons{display:flex;align-items:center;gap:6px;font-size:14px;color:#33445b;}\n.topbar{height:62px;flex:none;display:flex;align-items:center;gap:10px;padding:0 15px;background:var(--paper);border-bottom:1px solid var(--line);}\n.back-button{width:42px;height:42px;display:grid;place-items:center;border:0;border-radius:14px;background:transparent;color:var(--blue);font-size:21px;}\n.page-title{min-width:0;flex:1;font-size:17px;line-height:1.15;font-weight:800;letter-spacing:-.035em;color:var(--ink);}\n.mark-read{min-height:40px;padding:0 8px;display:flex;align-items:center;gap:5px;border:0;background:transparent;color:var(--blue);font-size:11px;font-weight:700;white-space:nowrap;}\n.mark-read i{font-size:17px;}\n.feed-scroll{min-height:0;flex:1;overflow-y:auto;overscroll-behavior:contain;padding:20px 18px 28px;scrollbar-width:none;}\n.feed-scroll::-webkit-scrollbar{display:none;}\n.intro{margin:0 2px 15px;}\n.intro p{margin:0;color:#526078;font-size:13px;line-height:1.55;}\n.demo-note{display:flex;align-items:flex-start;gap:9px;padding:11px 12px;margin-bottom:23px;border-radius:13px;background:#EAF1FB;color:#344B6C;font-size:11px;line-height:1.45;}\n.demo-note i{flex:none;color:var(--blue);font-size:17px;margin-top:0;}\n.demo-note strong{color:#233F65;font-weight:800;}\n.group-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 2px 9px;}\n.group-head h2{margin:0;color:#293750;font-size:14px;font-weight:800;letter-spacing:-.02em;}\n.group-head span{font-size:10px;color:#7C8491;}\n.notice-list{background:var(--paper);border-radius:16px;overflow:hidden;}\n.notice{display:grid;grid-template-columns:38px minmax(0,1fr) 9px;gap:11px;align-items:start;padding:15px 13px 14px;border-bottom:1px solid var(--line);}\n.notice:last-child{border-bottom:0;}\n.notice.read{background:#FBF8F5;}\n.notice-icon{width:36px;height:36px;display:grid;place-items:center;border-radius:12px;font-size:19px;}\n.notice-icon.sighting{background:var(--rose-bg);color:var(--rose);}\n.notice-icon.fir{background:var(--green-bg);color:var(--green);}\n.notice-icon.info{background:#EEEAE5;color:#667184;}\n.notice-copy{min-width:0;}\n.notice-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:6px;}\n.notice-title{margin:0;color:#17243A;font-size:13px;line-height:1.35;font-weight:800;letter-spacing:-.018em;}\n.notice.read .notice-title{font-weight:650;}\n.demo-tag{flex:none;padding:3px 5px;border:1px solid #D6DDEA;border-radius:5px;color:#4D6180;background:#F6F8FB;font-size:8px;line-height:1;font-weight:800;letter-spacing:.05em;}\n.notice-message{margin:5px 0 0;color:#56647A;font-size:11px;line-height:1.5;}\n.notice-meta{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-top:9px;}\n.type-tag{padding:4px 7px;border-radius:6px;font-size:9px;line-height:1.15;font-weight:750;}\n.type-tag.sighting{background:var(--rose-bg);color:var(--rose);}\n.type-tag.fir{background:var(--green-bg);color:var(--green);}\n.type-tag.info{background:#F0ECE7;color:#667184;}\n.route-link{min-height:34px;display:inline-flex;align-items:center;gap:4px;color:var(--blue);font-size:10px;font-weight:800;text-decoration:none;}\n.route-link i{font-size:15px;}\n.unread-dot{width:8px;height:8px;margin-top:5px;border-radius:50%;background:var(--blue);}\n.notice.read .unread-dot{visibility:hidden;}\n.read-only{display:inline-flex;align-items:center;gap:4px;color:#727D8E;font-size:10px;font-weight:650;}\n.read-only i{font-size:13px;}\n.section-gap{height:22px;}\n.group-head.read-head{padding-bottom:9px;}\n.footer-hint{margin:13px 2px 0;color:#788293;font-size:10px;line-height:1.45;}\n.nav-bar{height:25px;flex:none;display:grid;place-items:center;background:var(--paper);border-top:1px solid var(--line);}\n.nav-bar span{width:108px;height:4px;border-radius:5px;background:#31415A;opacity:.45;}\n@media(max-height:760px){.notification-screen{min-height:660px}.feed-scroll{padding-top:14px}.demo-note{margin-bottom:17px}.notice{padding-top:12px;padding-bottom:11px}.section-gap{height:16px}}\n</style>\n<div aria-label=\"Notification Center mobile preview\" class=\"notification-screen\" data-kid=\"1\" data-name=\"notification center mobile preview frame\">\n    <div class=\"device-status\" data-kid=\"1-1\" data-name=\"device status bar\">\n        <span data-kid=\"1-1-1\" data-name=\"device status bar clock\">\n            9:41\n        </span>\n        <span class=\"status-icons\" data-kid=\"1-1-2\" data-name=\"device status bar connectivity icons\">\n            <i class=\"mdi mdi-signal-cellular-3\" data-kid=\"1-1-2-1\" data-name=\"mobile signal strength icon\">\n            </i>\n            <i class=\"mdi mdi-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon\">\n            </i>\n            <i class=\"mdi mdi-battery-80\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\">\n            </i>\n        </span>\n    </div>\n    <header class=\"topbar\" data-kid=\"1-2\" data-name=\"page top app bar\">\n        <button aria-label=\"Back\" class=\"back-button\" data-kid=\"1-2-1\" data-name=\"back navigation button\">\n            <i class=\"mdi mdi-arrow-left\" data-kid=\"1-2-1-1\" data-name=\"left arrow back icon\">\n            </i>\n        </button>\n        <h1 class=\"page-title\" data-kid=\"1-2-2\" data-name=\"page title heading\">\n            Notification Center\n        </h1>\n        <button aria-label=\"Mark all as read\" class=\"mark-read\" data-kid=\"1-2-3\" data-name=\"mark all as read button\">\n            <i class=\"mdi mdi-check-all\" data-kid=\"1-2-3-1\" data-name=\"check all checkbox icon\">\n            </i>\n            <span data-kid=\"1-2-3-2\" data-name=\"mark all as read button label\">\n                Mark all\n                <br data-kid=\"1-2-3-2-1\" data-name=\"line break for two-line button label\"/>\n                as read\n            </span>\n        </button>\n    </header>\n    <main class=\"feed-scroll\" data-kid=\"1-3\" data-name=\"scrollable notification feed\">\n        <div class=\"intro\" data-kid=\"1-3-1\" data-name=\"feed intro container\">\n            <p data-kid=\"1-3-1-1\" data-name=\"feed intro description text\">\n                Case updates and sighting alerts, in one place.\n            </p>\n        </div>\n        <div class=\"demo-note\" data-kid=\"1-3-2\" data-name=\"demo notices banner\">\n            <i class=\"mdi mdi-information-outline\" data-kid=\"1-3-2-1\" data-name=\"information icon\">\n            </i>\n            <div data-kid=\"1-3-2-2\" data-name=\"demo notice text container\">\n                <strong data-kid=\"1-3-2-2-1\" data-name=\"demo notice emphasis label\">\n                    Demo preview.\n                </strong>\n                Sample alerts only; dates and record references are not shown.\n            </div>\n        </div>\n        <section aria-labelledby=\"unread-heading\" data-kid=\"1-3-3\" data-name=\"unread notification group section\">\n            <div class=\"group-head\" data-kid=\"1-3-3-1\" data-name=\"unread group header row\">\n                <h2 data-kid=\"1-3-3-1-1\" data-name=\"unread group heading\" id=\"unread-heading\">\n                    Unread\n                </h2>\n                <span data-kid=\"1-3-3-1-2\" data-name=\"unread group subtitle label\">\n                    Sample notifications\n                </span>\n            </div>\n            <div class=\"notice-list\" data-kid=\"1-3-3-2\" data-name=\"unread notification card list\">\n                <article aria-label=\"Unread demo sighting notification; linked to sighting review\" class=\"notice\" data-kid=\"1-3-3-2-1\" data-name=\"unread sighting demo notification card\">\n                    <div class=\"notice-icon sighting\" data-kid=\"1-3-3-2-1-1\" data-name=\"notification icon badge container\">\n                        <i class=\"mdi mdi-cctv\" data-kid=\"1-3-3-2-1-1-1\" data-name=\"CCTV camera icon\">\n                        </i>\n                    </div>\n                    <div class=\"notice-copy\" data-kid=\"1-3-3-2-1-2\" data-name=\"notification body content container\">\n                        <div class=\"notice-title-row\" data-kid=\"1-3-3-2-1-2-1\" data-name=\"notification title row\">\n                            <h3 class=\"notice-title\" data-kid=\"1-3-3-2-1-2-1-1\" data-name=\"notification card title\">\n                                CCTV match ready for review\n                            </h3>\n                            <span class=\"demo-tag\" data-kid=\"1-3-3-2-1-2-1-2\" data-name=\"demo badge label\">\n                                DEMO\n                            </span>\n                        </div>\n                        <p class=\"notice-message\" data-kid=\"1-3-3-2-1-2-2\" data-name=\"notification card message text\">\n                            A possible match is available. Review the sighting evidence before deciding.\n                        </p>\n                        <div class=\"notice-meta\" data-kid=\"1-3-3-2-1-2-3\" data-name=\"notification metadata row\">\n                            <span class=\"type-tag sighting\" data-kid=\"1-3-3-2-1-2-3-1\" data-name=\"sighting type tag\">\n                                Sighting\n                            </span>\n                            <a class=\"route-link\" data-kid=\"1-3-3-2-1-2-3-2\" data-name=\"open sighting review link\" href=\"#sighting-review\">\n                                Open sighting review\n                                <i class=\"mdi mdi-arrow-right\" data-kid=\"1-3-3-2-1-2-3-2-1\" data-name=\"right action arrow icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                    <span aria-label=\"Unread\" class=\"unread-dot\" data-kid=\"1-3-3-2-1-3\" data-name=\"unread indicator dot\">\n                    </span>\n                </article>\n                <article aria-label=\"Unread demo FIR notification; linked to case details\" class=\"notice\" data-kid=\"1-3-3-2-2\" data-name=\"unread FIR approval demo notification card\">\n                    <div class=\"notice-icon fir\" data-kid=\"1-3-3-2-2-1\" data-name=\"notification icon badge container\">\n                        <i class=\"mdi mdi-file-check-outline\" data-kid=\"1-3-3-2-2-1-1\" data-name=\"document checkmark icon\">\n                        </i>\n                    </div>\n                    <div class=\"notice-copy\" data-kid=\"1-3-3-2-2-2\" data-name=\"notification body content container\">\n                        <div class=\"notice-title-row\" data-kid=\"1-3-3-2-2-2-1\" data-name=\"notification title row\">\n                            <h3 class=\"notice-title\" data-kid=\"1-3-3-2-2-2-1-1\" data-name=\"notification card title\">\n                                FIR review completed\n                            </h3>\n                            <span class=\"demo-tag\" data-kid=\"1-3-3-2-2-2-1-2\" data-name=\"demo badge label\">\n                                DEMO\n                            </span>\n                        </div>\n                        <p class=\"notice-message\" data-kid=\"1-3-3-2-2-2-2\" data-name=\"notification card message text\">\n                            The FIR was approved. The case is active for CCTV matching.\n                        </p>\n                        <div class=\"notice-meta\" data-kid=\"1-3-3-2-2-2-3\" data-name=\"notification metadata row\">\n                            <span class=\"type-tag fir\" data-kid=\"1-3-3-2-2-2-3-1\" data-name=\"FIR approval type tag\">\n                                FIR approved\n                            </span>\n                            <a class=\"route-link\" data-kid=\"1-3-3-2-2-2-3-2\" data-name=\"view case link\" href=\"#case-details\">\n                                View case\n                                <i class=\"mdi mdi-arrow-right\" data-kid=\"1-3-3-2-2-2-3-2-1\" data-name=\"right action arrow icon\">\n                                </i>\n                            </a>\n                        </div>\n                    </div>\n                    <span aria-label=\"Unread\" class=\"unread-dot\" data-kid=\"1-3-3-2-2-3\" data-name=\"unread indicator dot\">\n                    </span>\n                </article>\n            </div>\n        </section>\n        <div class=\"section-gap\" data-kid=\"1-3-4\" data-name=\"vertical section spacing gap\">\n        </div>\n        <section aria-labelledby=\"read-heading\" data-kid=\"1-3-5\" data-name=\"read notification group section\">\n            <div class=\"group-head read-head\" data-kid=\"1-3-5-1\" data-name=\"read group header row\">\n                <h2 data-kid=\"1-3-5-1-1\" data-name=\"read group heading\" id=\"read-heading\">\n                    Read\n                </h2>\n                <span data-kid=\"1-3-5-1-2\" data-name=\"read group subtitle label\">\n                    Sample notification\n                </span>\n            </div>\n            <div class=\"notice-list\" data-kid=\"1-3-5-2\" data-name=\"read notification card list\">\n                <article aria-label=\"Read-only demo information notification; no case reference\" class=\"notice read\" data-kid=\"1-3-5-2-1\" data-name=\"read-only information demo notification card\">\n                    <div class=\"notice-icon info\" data-kid=\"1-3-5-2-1-1\" data-name=\"notification icon badge container\">\n                        <i class=\"mdi mdi-bell-outline\" data-kid=\"1-3-5-2-1-1-1\" data-name=\"bell outline icon\">\n                        </i>\n                    </div>\n                    <div class=\"notice-copy\" data-kid=\"1-3-5-2-1-2\" data-name=\"notification body content container\">\n                        <div class=\"notice-title-row\" data-kid=\"1-3-5-2-1-2-1\" data-name=\"notification title row\">\n                            <h3 class=\"notice-title\" data-kid=\"1-3-5-2-1-2-1-1\" data-name=\"notification card title\">\n                                Case update\n                            </h3>\n                            <span class=\"demo-tag\" data-kid=\"1-3-5-2-1-2-1-2\" data-name=\"demo badge label\">\n                                DEMO\n                            </span>\n                        </div>\n                        <p class=\"notice-message\" data-kid=\"1-3-5-2-1-2-2\" data-name=\"notification card message text\">\n                            This sample has no linked case. Its message remains readable here.\n                        </p>\n                        <div class=\"notice-meta\" data-kid=\"1-3-5-2-1-2-3\" data-name=\"notification metadata row\">\n                            <span class=\"type-tag info\" data-kid=\"1-3-5-2-1-2-3-1\" data-name=\"information type tag\">\n                                Information\n                            </span>\n                            <span class=\"read-only\" data-kid=\"1-3-5-2-1-2-3-2\" data-name=\"no case link indicator span\">\n                                <i class=\"mdi mdi-link-off\" data-kid=\"1-3-5-2-1-2-3-2-1\" data-name=\"link-off icon\">\n                                </i>\n                                No case link\n                            </span>\n                        </div>\n                    </div>\n                    <span aria-hidden=\"true\" class=\"unread-dot\" data-kid=\"1-3-5-2-1-3\" data-name=\"hidden read indicator dot\">\n                    </span>\n                </article>\n            </div>\n        </section>\n        <p class=\"footer-hint\" data-kid=\"1-3-6\" data-name=\"feed footer explanation text\">\n            Linked alerts open their referenced sighting or case. Alerts without a valid reference stay readable and do not act like links.\n        </p>\n    </main>\n    <div aria-hidden=\"true\" class=\"nav-bar\" data-kid=\"1-4\" data-name=\"home indicator bar\">\n        <span data-kid=\"1-4-1\" data-name=\"home indicator pill\">\n        </span>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-13T10:39:28.847248+00:00",
      "modified": "2026-10-13T10:39:47.511118+00:00",
      "id": "var_0eebbf9b9e93",
      "contentHeight": 852
    },
    "var_626d06c0d04d": {
      "type": "variant",
      "label": "FIR Queue — Blue & Cream",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4018,
        "y": 0,
        "w": 393,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css');\n.fir-app{--blue:#014baa;--blue-deep:#003a84;--cream:#f8f3f0;--paper:#fffdfa;--ink:#182434;--muted:#596777;--line:#ddd9d2;--amber:#825709;--amber-bg:#fff1d3;--green:#176344;--green-bg:#e4f3e9;--red:#a42f43;--red-bg:#fde9e9;width:min(100%,393px);height:min(852px,100vh);min-height:720px;margin:0 auto;display:flex;flex-direction:column;background:var(--cream);color:var(--ink);font-family:'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;font-size:14px;line-height:1.45;overflow:hidden;box-shadow:0 18px 60px #15203026;position:relative;}\n.fir-app *{box-sizing:border-box}.fir-app button,.fir-app textarea{font:inherit}.sysbar{height:30px;flex:none;padding:6px 17px 2px;display:flex;align-items:center;justify-content:space-between;background:var(--blue);color:white;font-size:11px;font-weight:700}.sysicons{display:flex;gap:6px;align-items:center;font-size:13px}.appbar{height:58px;flex:none;display:flex;align-items:center;gap:10px;padding:0 16px;background:var(--blue);color:white;border-bottom:1px solid #ffffff38}.back{width:38px;height:38px;border:0;border-radius:11px;background:#ffffff18;color:white;display:grid;place-items:center;font-size:20px}.bar-title{font-size:17px;font-weight:800;letter-spacing:-.035em;flex:1}.refresh{width:38px;height:38px;border:1px solid #ffffff52;background:#ffffff12;color:#fff;border-radius:11px;display:grid;place-items:center;font-size:18px}.scroll{flex:1;min-height:0;overflow-y:auto;padding:19px 18px 24px;scrollbar-width:none}.scroll::-webkit-scrollbar{display:none}.intro{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.intro h1{font-size:21px;line-height:1.18;letter-spacing:-.04em;margin:0;font-weight:800;color:var(--ink)}.intro p{font-size:12px;line-height:1.5;color:var(--muted);margin:6px 0 0;max-width:225px}.demo-tag{flex:none;padding:5px 7px;border:1px solid #cbbca4;border-radius:6px;font-size:9px;font-weight:800;letter-spacing:.04em;color:#68512e;background:#fffaf0;text-align:center}.queue-summary{display:flex;align-items:center;justify-content:space-between;margin:18px 0 9px;padding:11px 12px;background:#efe8dd;border-radius:12px;gap:8px}.summary-copy{font-size:12px;font-weight:700;color:#374454}.summary-note{display:block;margin-top:1px;font-size:10px;color:#687585;font-weight:500}.sample-count{flex:none;color:var(--amber);font-size:11px;font-weight:800;text-align:right}.list-head{display:flex;justify-content:space-between;align-items:center;padding:8px 2px 7px;border-bottom:1px solid #cbc5bb}.list-head strong{font-size:12px;font-weight:800}.list-head span{font-size:10px;color:var(--muted)}.case-row{padding:15px 2px 16px;border-bottom:1px solid var(--line)}.row-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}.person{min-width:0}.person strong{display:block;font-size:15px;line-height:1.25;letter-spacing:-.02em;font-weight:800;color:var(--ink)}.person-meta{font-size:10px;color:var(--muted);margin-top:3px}.pending{display:inline-flex;flex:none;align-items:center;gap:5px;padding:4px 7px;border-radius:6px;background:var(--amber-bg);color:var(--amber);font-size:10px;font-weight:800;white-space:nowrap}.pending i{font-size:12px}.fir-number{margin-top:10px;font-family:'Plus Jakarta Sans','Noto Sans Devanagari',sans-serif;font-size:13px;font-weight:800;color:var(--blue-deep);letter-spacing:.005em}.fir-number small{font-family:inherit;font-size:9px;text-transform:uppercase;letter-spacing:.06em;color:#687585;font-weight:800;margin-right:5px}.facts{display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;margin-top:8px}.fact{min-width:0}.fact-label{font-size:9px;font-weight:800;letter-spacing:.035em;color:#747b82;text-transform:uppercase}.fact-value{font-size:11px;font-weight:650;color:#334150;margin-top:2px;overflow-wrap:anywhere}.doc-line{display:flex;align-items:center;gap:7px;margin-top:11px;padding:8px 9px;background:#f0ece6;border-radius:8px;color:#596777;font-size:10px;line-height:1.35}.doc-line i{font-size:15px;color:var(--blue);flex:none}.row-actions{display:flex;gap:8px;margin-top:11px}.action{height:40px;padding:0 11px;border-radius:9px;display:flex;align-items:center;justify-content:center;gap:6px;font-size:11px;font-weight:800;white-space:nowrap}.action i{font-size:15px}.inspect{background:var(--blue);color:white;border:1px solid var(--blue);flex:1}.open-case{background:transparent;color:var(--blue-deep);border:1px solid #9bb0ca}.state-note{margin:14px 0 3px;padding:10px 11px;border-left:3px solid var(--blue);background:#eee7de;border-radius:0 9px 9px 0;font-size:10px;color:#536171;line-height:1.45}.state-note strong{color:#29394a}.bottom-note{flex:none;padding:10px 17px calc(9px + env(safe-area-inset-bottom));border-top:1px solid #ddd8cf;background:var(--paper);color:#647181;font-size:10px;display:flex;align-items:center;gap:7px}.bottom-note i{color:var(--blue);font-size:15px}.gesture{height:20px;flex:none;background:var(--paper);display:grid;place-items:center}.gesture span{width:104px;height:4px;border-radius:8px;background:#747d88;opacity:.6}.scrim{display:none;position:absolute;inset:0;z-index:10;background:#17233380;align-items:flex-end;justify-content:center;padding:0}.scrim.open{display:flex}.sheet{max-height:88%;overflow:auto;width:100%;background:var(--paper);border-radius:20px 20px 0 0;padding:10px 18px 18px;box-shadow:0 -10px 40px #121c2b24}.grabber{width:38px;height:4px;border-radius:5px;background:#c7c2ba;margin:0 auto 14px}.sheet-head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}.sheet-head h2{font-size:17px;line-height:1.25;margin:0;letter-spacing:-.03em;color:var(--ink)}.sheet-head p{font-size:11px;color:var(--muted);margin:4px 0 0}.close{width:34px;height:34px;border:0;border-radius:9px;background:#efeae3;color:#334150;font-size:18px}.sheet-status{margin-top:12px;display:flex;align-items:center;gap:7px;padding:9px 10px;background:var(--amber-bg);color:var(--amber);border-radius:9px;font-size:11px;font-weight:750}.doc-preview{margin-top:13px;border:1px dashed #aaa49a;border-radius:11px;min-height:90px;display:flex;align-items:center;gap:10px;padding:12px;background:#f4f0e9}.doc-icon{width:38px;height:42px;flex:none;border-radius:6px;background:#e4edf9;color:var(--blue);display:grid;place-items:center;font-size:20px}.doc-title{font-size:12px;font-weight:800;color:#27384a}.doc-caption{font-size:10px;line-height:1.4;color:#687585;margin-top:3px}.sheet-button{margin-top:12px;height:42px;width:100%;border-radius:9px;border:1px solid #90a6c2;color:var(--blue-deep);background:#f5f8fc;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:6px}.sheet-label{margin:15px 0 6px;font-size:12px;font-weight:800}.reason{width:100%;height:62px;resize:none;border:1px solid #c9c4bb;border-radius:9px;background:#fffdfa;padding:9px 10px;color:var(--ink);font-size:11px;line-height:1.4;outline:none}.reason::placeholder{color:#7b8490}.required{font-size:10px;color:#737d87;margin-top:4px}.decisions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.decision{height:43px;border-radius:9px;font-size:11px;font-weight:800}.approve{background:var(--green);color:white;border:1px solid var(--green)}.reject{background:#fff6f5;color:var(--red);border:1px solid #d9979f}.decision:disabled{opacity:.48;background:#eeebe6;color:#777;border-color:#d5d0c8}.demo-lock{margin-top:9px;font-size:10px;color:#6a7480;line-height:1.4;display:flex;gap:6px;align-items:flex-start}.demo-lock i{font-size:13px;color:var(--blue);flex:none}.confirm-strip{margin-top:10px;padding:9px 10px;background:var(--green-bg);border:1px solid #bfd9c8;border-radius:8px;color:#355c46;font-size:10px;line-height:1.4}.error-strip{margin-top:9px;padding:9px 10px;background:var(--red-bg);border:1px solid #e6b9bd;border-radius:8px;color:#822c3b;font-size:10px;display:flex;justify-content:space-between;gap:8px}.retry{color:#7d2638;font-weight:800;text-decoration:underline;white-space:nowrap}@media(max-height:760px){.fir-app{min-height:680px}.scroll{padding-top:14px}.case-row{padding-top:12px;padding-bottom:13px}}\n</style>\n<div class=\"fir-app\" data-kid=\"1\" data-name=\"FIR review app mockup container\">\n    <div class=\"sysbar\" data-kid=\"1-1\" data-name=\"phone status bar\">\n        <span data-kid=\"1-1-1\" data-name=\"status bar clock time\">\n            9:41\n        </span>\n        <span class=\"sysicons\" data-kid=\"1-1-2\" data-name=\"system status icons group\">\n            <i class=\"mdi mdi-signal-cellular-3\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\">\n            </i>\n            <i class=\"mdi mdi-wifi\" data-kid=\"1-1-2-2\" data-name=\"wifi icon\">\n            </i>\n            <i class=\"mdi mdi-battery-70\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\">\n            </i>\n        </span>\n    </div>\n    <header class=\"appbar\" data-kid=\"1-2\" data-name=\"app top action bar\">\n        <button aria-label=\"Back\" class=\"back\" data-kid=\"1-2-1\" data-name=\"back navigation button\">\n            <i class=\"mdi mdi-arrow-left\" data-kid=\"1-2-1-1\" data-name=\"back arrow icon\">\n            </i>\n        </button>\n        <div class=\"bar-title\" data-kid=\"1-2-2\" data-name=\"app bar title\">\n            FIR verification queue\n        </div>\n        <button aria-label=\"Refresh queue\" class=\"refresh\" data-kid=\"1-2-3\" data-name=\"refresh queue button\">\n            <i class=\"mdi mdi-refresh\" data-kid=\"1-2-3-1\" data-name=\"refresh reload icon\">\n            </i>\n        </button>\n    </header>\n    <main class=\"scroll\" data-kid=\"1-3\" data-name=\"scrollable main content area\">\n        <section class=\"intro\" data-kid=\"1-3-1\" data-name=\"page intro section\">\n            <div data-kid=\"1-3-1-1\" data-name=\"intro heading and description wrapper\">\n                <h1 data-kid=\"1-3-1-1-1\" data-name=\"page main headline\">\n                    Review submitted FIRs\n                </h1>\n                <p data-kid=\"1-3-1-1-2\" data-name=\"intro description text\">\n                    Inspect the case and document before approving or returning a report.\n                </p>\n            </div>\n            <div class=\"demo-tag\" data-kid=\"1-3-1-2\" data-name=\"demo preview label badge\">\n                DEMO\n                <br data-kid=\"1-3-1-2-1\" data-name=\"line break in demo label\"/>\n                PREVIEW\n            </div>\n        </section>\n        <section class=\"queue-summary\" data-kid=\"1-3-2\" data-name=\"queue summary banner\">\n            <div class=\"summary-copy\" data-kid=\"1-3-2-1\" data-name=\"summary heading block\">\n                Officer review worklist\n                <span class=\"summary-note\" data-kid=\"1-3-2-1-1\" data-name=\"summary sample-data note\">\n                    Sample records only · not live queue data\n                </span>\n            </div>\n            <div class=\"sample-count\" data-kid=\"1-3-2-2\" data-name=\"case count with demo tag\">\n                02\n                <br data-kid=\"1-3-2-2-1\" data-name=\"line break before demo tag\"/>\n                <span data-kid=\"1-3-2-2-2\" data-name=\"count demo tag\" style=\"font-size:9px;font-weight:700\">\n                    DEMO\n                </span>\n            </div>\n        </section>\n        <div class=\"list-head\" data-kid=\"1-3-3\" data-name=\"case list header row\">\n            <strong data-kid=\"1-3-3-1\" data-name=\"list header title\">\n                Pending FIR review\n            </strong>\n            <span data-kid=\"1-3-3-2\" data-name=\"list sort order note\">\n                Oldest sample first\n            </span>\n        </div>\n        <article class=\"case-row\" data-kid=\"1-3-4\" data-name=\"pending FIR case card A\">\n            <div class=\"row-top\" data-kid=\"1-3-4-1\" data-name=\"case card top row\">\n                <div class=\"person\" data-kid=\"1-3-4-1-1\" data-name=\"case subject block\">\n                    <strong data-kid=\"1-3-4-1-1-1\" data-name=\"case subject name\">\n                        Demo subject A\n                    </strong>\n                    <div class=\"person-meta\" data-kid=\"1-3-4-1-1-2\" data-name=\"subject sample-case meta\">\n                        Sample case record · demo only\n                    </div>\n                </div>\n                <span class=\"pending\" data-kid=\"1-3-4-1-2\" data-name=\"pending review status badge\">\n                    <i class=\"mdi mdi-clock-outline\" data-kid=\"1-3-4-1-2-1\" data-name=\"clock status icon\">\n                    </i>\n                    Pending review\n                </span>\n            </div>\n            <div class=\"fir-number\" data-kid=\"1-3-4-2\" data-name=\"FIR case number\">\n                <small data-kid=\"1-3-4-2-1\" data-name=\"FIR number label\">\n                    FIR no. · demo\n                </small>\n                FIR/2026/0142\n            </div>\n            <div class=\"facts\" data-kid=\"1-3-4-3\" data-name=\"case facts grid\">\n                <div class=\"fact\" data-kid=\"1-3-4-3-1\" data-name=\"station fact group\">\n                    <div class=\"fact-label\" data-kid=\"1-3-4-3-1-1\" data-name=\"station fact label\">\n                        Police station\n                    </div>\n                    <div class=\"fact-value\" data-kid=\"1-3-4-3-1-2\" data-name=\"station fact value\">\n                        Sample station A\n                    </div>\n                </div>\n                <div class=\"fact\" data-kid=\"1-3-4-3-2\" data-name=\"filed date fact group\">\n                    <div class=\"fact-label\" data-kid=\"1-3-4-3-2-1\" data-name=\"filed date fact label\">\n                        Filed date\n                    </div>\n                    <div class=\"fact-value\" data-kid=\"1-3-4-3-2-2\" data-name=\"filed date fact value\">\n                        12 Oct 2026 · sample\n                    </div>\n                </div>\n            </div>\n            <div class=\"doc-line\" data-kid=\"1-3-4-4\" data-name=\"document missing notice row\">\n                <i class=\"mdi mdi-file-alert-outline\" data-kid=\"1-3-4-4-1\" data-name=\"file alert icon\">\n                </i>\n                <span data-kid=\"1-3-4-4-2\" data-name=\"document missing notice text\">\n                    No FIR document fixture included. Inspect the live case attachment before deciding.\n                </span>\n            </div>\n            <div class=\"row-actions\" data-kid=\"1-3-4-5\" data-name=\"case action button group\">\n                <button class=\"action inspect\" data-kid=\"1-3-4-5-1\" data-name=\"inspect FIR action button\" onclick=\"openSheet('A','FIR/2026/0142','Sample station A')\">\n                    <i class=\"mdi mdi-file-search-outline\" data-kid=\"1-3-4-5-1-1\" data-name=\"file search icon\">\n                    </i>\n                    Inspect FIR\n                </button>\n                <button class=\"action open-case\" data-kid=\"1-3-4-5-2\" data-name=\"open case action button\" onclick=\"openSheet('A','FIR/2026/0142','Sample station A')\">\n                    Open case\n                </button>\n            </div>\n        </article>\n        <article class=\"case-row\" data-kid=\"1-3-5\" data-name=\"pending FIR case card B\">\n            <div class=\"row-top\" data-kid=\"1-3-5-1\" data-name=\"case card top row\">\n                <div class=\"person\" data-kid=\"1-3-5-1-1\" data-name=\"case subject block\">\n                    <strong data-kid=\"1-3-5-1-1-1\" data-name=\"case subject name\">\n                        Demo subject B\n                    </strong>\n                    <div class=\"person-meta\" data-kid=\"1-3-5-1-1-2\" data-name=\"subject sample-case meta\">\n                        Sample case record · demo only\n                    </div>\n                </div>\n                <span class=\"pending\" data-kid=\"1-3-5-1-2\" data-name=\"pending review status badge\">\n                    <i class=\"mdi mdi-clock-outline\" data-kid=\"1-3-5-1-2-1\" data-name=\"clock status icon\">\n                    </i>\n                    Pending review\n                </span>\n            </div>\n            <div class=\"fir-number\" data-kid=\"1-3-5-2\" data-name=\"FIR case number\">\n                <small data-kid=\"1-3-5-2-1\" data-name=\"FIR number label\">\n                    FIR no. · demo\n                </small>\n                FIR/2026/0157\n            </div>\n            <div class=\"facts\" data-kid=\"1-3-5-3\" data-name=\"case facts grid\">\n                <div class=\"fact\" data-kid=\"1-3-5-3-1\" data-name=\"station fact group\">\n                    <div class=\"fact-label\" data-kid=\"1-3-5-3-1-1\" data-name=\"station fact label\">\n                        Police station\n                    </div>\n                    <div class=\"fact-value\" data-kid=\"1-3-5-3-1-2\" data-name=\"station fact value\">\n                        Sample station B\n                    </div>\n                </div>\n                <div class=\"fact\" data-kid=\"1-3-5-3-2\" data-name=\"filed date fact group\">\n                    <div class=\"fact-label\" data-kid=\"1-3-5-3-2-1\" data-name=\"filed date fact label\">\n                        Filed date\n                    </div>\n                    <div class=\"fact-value\" data-kid=\"1-3-5-3-2-2\" data-name=\"filed date fact value\">\n                        11 Oct 2026 · sample\n                    </div>\n                </div>\n            </div>\n            <div class=\"doc-line\" data-kid=\"1-3-5-4\" data-name=\"document missing notice row\">\n                <i class=\"mdi mdi-file-alert-outline\" data-kid=\"1-3-5-4-1\" data-name=\"file alert icon\">\n                </i>\n                <span data-kid=\"1-3-5-4-2\" data-name=\"document missing notice text\">\n                    No FIR document fixture included. Inspect the live case attachment before deciding.\n                </span>\n            </div>\n            <div class=\"row-actions\" data-kid=\"1-3-5-5\" data-name=\"case action button group\">\n                <button class=\"action inspect\" data-kid=\"1-3-5-5-1\" data-name=\"inspect FIR action button\" onclick=\"openSheet('B','FIR/2026/0157','Sample station B')\">\n                    <i class=\"mdi mdi-file-search-outline\" data-kid=\"1-3-5-5-1-1\" data-name=\"file search icon\">\n                    </i>\n                    Inspect FIR\n                </button>\n                <button class=\"action open-case\" data-kid=\"1-3-5-5-2\" data-name=\"open case action button\" onclick=\"openSheet('B','FIR/2026/0157','Sample station B')\">\n                    Open case\n                </button>\n            </div>\n        </article>\n        <aside class=\"state-note\" data-kid=\"1-3-6\" data-name=\"review order instruction note\">\n            <strong data-kid=\"1-3-6-1\" data-name=\"review order label\">\n                Review order:\n            </strong>\n            open the case, inspect the attached FIR, then approve or reject with a reason. A sample number or status here does not represent a verified document.\n        </aside>\n    </main>\n    <footer class=\"bottom-note\" data-kid=\"1-4\" data-name=\"footer demo disclaimer bar\">\n        <i class=\"mdi mdi-information-outline\" data-kid=\"1-4-1\" data-name=\"information icon\">\n        </i>\n        <span data-kid=\"1-4-2\" data-name=\"footer disclaimer text\">\n            Demo preview · approval and rejection never submit or change a record.\n        </span>\n    </footer>\n    <div class=\"gesture\" data-kid=\"1-5\" data-name=\"home gesture indicator bar\">\n        <span data-kid=\"1-5-1\" data-name=\"gesture pill indicator\">\n        </span>\n    </div>\n    <div class=\"scrim\" data-kid=\"1-6\" data-name=\"modal overlay scrim\" id=\"scrim\" onclick=\"if(event.target===this)closeSheet()\" role=\"presentation\">\n        <section aria-labelledby=\"sheet-title\" aria-modal=\"true\" class=\"sheet\" data-kid=\"1-6-1\" data-name=\"case review bottom sheet dialog\" role=\"dialog\">\n            <div class=\"grabber\" data-kid=\"1-6-1-1\" data-name=\"sheet grabber handle\">\n            </div>\n            <div class=\"sheet-head\" data-kid=\"1-6-1-2\" data-name=\"sheet header row\">\n                <div data-kid=\"1-6-1-2-1\" data-name=\"sheet title and meta block\">\n                    <h2 data-dynamic=\"true\" data-kid=\"1-6-1-2-1-1\" data-name=\"sheet case title\" data-reason=\"text replaced by openSheet script from clicked case when sheet opens\" id=\"sheet-title\">\n                        Review FIR · Demo subject A\n                    </h2>\n                    <p data-dynamic=\"true\" data-kid=\"1-6-1-2-1-2\" data-name=\"sheet case number and station meta\" data-reason=\"text replaced by openSheet script from clicked case when sheet opens\" id=\"sheet-meta\">\n                        FIR/2026/0142 · Sample station A\n                    </p>\n                </div>\n                <button aria-label=\"Close\" class=\"close\" data-kid=\"1-6-1-2-2\" data-name=\"close sheet button\" onclick=\"closeSheet()\">\n                    <i class=\"mdi mdi-close\" data-kid=\"1-6-1-2-2-1\" data-name=\"close X icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"sheet-status\" data-kid=\"1-6-1-3\" data-name=\"sheet pending status banner\">\n                <i class=\"mdi mdi-clock-outline\" data-kid=\"1-6-1-3-1\" data-name=\"clock status icon\">\n                </i>\n                Pending review · sample state\n            </div>\n            <div class=\"doc-preview\" data-kid=\"1-6-1-4\" data-name=\"FIR document preview card\">\n                <div class=\"doc-icon\" data-kid=\"1-6-1-4-1\" data-name=\"document icon tile\">\n                    <i class=\"mdi mdi-file-document-outline\" data-kid=\"1-6-1-4-1-1\" data-name=\"document file icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-6-1-4-2\" data-name=\"document preview text block\">\n                    <div class=\"doc-title\" data-kid=\"1-6-1-4-2-1\" data-name=\"document title\">\n                        FIR attachment\n                    </div>\n                    <div class=\"doc-caption\" data-kid=\"1-6-1-4-2-2\" data-name=\"document caption note\">\n                        No document asset is supplied in this demo. The real case file must be opened and inspected before a decision.\n                    </div>\n                </div>\n            </div>\n            <button class=\"sheet-button\" data-kid=\"1-6-1-5\" data-name=\"open case details button\">\n                <i class=\"mdi mdi-open-in-new\" data-kid=\"1-6-1-5-1\" data-name=\"open in new icon\">\n                </i>\n                Open case details\n            </button>\n            <div class=\"sheet-label\" data-kid=\"1-6-1-6\" data-name=\"rejection reason field label\">\n                Rejection reason\n                <span data-kid=\"1-6-1-6-1\" data-name=\"required-to-reject tag\" style=\"color:#a42f43\">\n                    · required to reject\n                </span>\n            </div>\n            <textarea aria-label=\"Required rejection reason\" class=\"reason\" data-kid=\"1-6-1-7\" data-name=\"rejection reason text input\" placeholder=\"Explain what needs correction for the reporter…\"></textarea>\n            <div class=\"required\" data-kid=\"1-6-1-8\" data-name=\"reason help note\">\n                A reason is required before rejection. Keep the case open if you need more information.\n            </div>\n            <div class=\"decisions\" data-kid=\"1-6-1-9\" data-name=\"decision action buttons\">\n                <button class=\"decision reject\" data-kid=\"1-6-1-9-1\" data-name=\"reject FIR button\" disabled=\"\">\n                    Reject FIR\n                </button>\n                <button class=\"decision approve\" data-kid=\"1-6-1-9-2\" data-name=\"approve FIR button\" disabled=\"\">\n                    Approve FIR\n                </button>\n            </div>\n            <div class=\"demo-lock\" data-kid=\"1-6-1-10\" data-name=\"demo decision lock note\">\n                <i class=\"mdi mdi-lock-outline\" data-kid=\"1-6-1-10-1\" data-name=\"lock icon\">\n                </i>\n                <span data-kid=\"1-6-1-10-2\" data-name=\"decision lock explanation text\">\n                    Decisions are disabled because this preview has no live case or FIR file. In the app, keep this review open during submission; show errors here with a retry option.\n                </span>\n            </div>\n            <div class=\"confirm-strip\" data-kid=\"1-6-1-11\" data-name=\"approval consequence note\">\n                <strong data-kid=\"1-6-1-11-1\" data-name=\"approval consequence label\">\n                    Approval consequence:\n                </strong>\n                the real app activates CCTV matching after a verified FIR. This demo does not claim that any sample document is valid.\n            </div>\n            <div class=\"error-strip\" data-kid=\"1-6-1-12\" data-name=\"error recovery strip\">\n                <span data-kid=\"1-6-1-12-1\" data-name=\"error message text\">\n                    Example recovery state: Could not save the decision. Your reason remains available.\n                </span>\n                <span class=\"retry\" data-kid=\"1-6-1-12-2\" data-name=\"retry action link\">\n                    Retry\n                </span>\n            </div>\n        </section>\n    </div>\n</div>\n<script>\n    function openSheet(name,num,station){document.getElementById('sheet-title').textContent='Review FIR · Demo subject '+name;document.getElementById('sheet-meta').textContent=num+' · '+station;document.getElementById('scrim').classList.add('open');}\nfunction closeSheet(){document.getElementById('scrim').classList.remove('open');}\n</script>\n",
