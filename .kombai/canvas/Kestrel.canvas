      "html": "<style>\n  :root{\n    --accent:#0f8a6a;\n    --accent-deep:#0a5f4c;\n    --accent-soft:#def9ef;\n    --ink:#0f211a;\n    --ink-2:#385248;\n    --muted:#758f85;\n    --line:#e5eeeb;\n    --line-strong:#d3deda;\n    --surface:#ffffff;\n    --page:#f9fcfb;\n\n    --s1:4px; --s2:8px; --s3:12px; --s4:16px; --s5:24px; --s6:32px;\n    --r-card:18px; --r-pill:999px;\n    --shadow-card:0 1px 2px rgba(15,33,26,.04), 0 8px 24px -18px rgba(15,33,26,.22);\n    --shadow-banner:0 14px 32px -20px rgba(10,95,76,.55);\n    --ease:cubic-bezier(0.16,1,0.3,1);\n    --font:-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  }\n\n  *{box-sizing:border-box;}\n  html,body{\n    margin:0; padding:0; min-height:100vh;\n    display:flex; align-items:center; justify-content:center;\n    background:#09110e;\n    font-family:var(--font);\n    -webkit-font-smoothing:antialiased;\n  }\n\n  .device{\n    box-sizing:border-box;\n    width:430px; height:932px;\n    overflow:hidden;\n    position:relative;\n    display:flex; flex-direction:column;\n    background:var(--page);\n    border:0; border-radius:0; box-shadow:none;\n    color:var(--ink);\n  }\n\n  /* ---------- status bar ---------- */\n  .statusbar{\n    height:54px; flex:0 0 54px;\n    display:flex; align-items:center; justify-content:space-between;\n    padding:14px 30px 0 34px;\n  }\n  .sb-time{\n    display:flex; align-items:center; gap:5px;\n    font-size:17px; font-weight:640; letter-spacing:-.2px; color:var(--ink);\n  }\n  .sb-right{display:flex; align-items:center; gap:6px;}\n\n  /* ---------- header ---------- */\n  .appbar{\n    flex:0 0 auto;\n    display:flex; align-items:center; gap:var(--s4);\n    padding:6px 20px 14px 20px;\n  }\n  .avatar{\n    width:36px; height:36px; flex:0 0 36px;\n    border-radius:11px;\n    overflow:hidden; position:relative;\n    background:linear-gradient(150deg,#dbeae5,#bed8ce);\n    box-shadow:0 0 0 2px var(--accent), 0 0 0 3px rgba(255,255,255,.9);\n  }\n  .avatar img{width:100%; height:100%; object-fit:cover; display:block;}\n  .appbar h1{\n    flex:1 1 auto; margin:0; text-align:center;\n    font-size:21px; font-weight:700; letter-spacing:-.45px;\n  }\n  .appbar-actions{display:flex; align-items:center; gap:14px; flex:0 0 auto;}\n  .icon-btn{\n    display:grid; place-items:center;\n    width:32px; height:32px; padding:0; border:0; background:none;\n    color:var(--ink); cursor:pointer; border-radius:var(--r-pill);\n    transition:transform .35s var(--ease), background-color .35s var(--ease);\n  }\n  .icon-btn:hover{background:rgba(15,33,26,.05); transform:translateY(-1px);}\n  .icon-btn:active{transform:scale(.94);}\n\n  /* ---------- tabs ---------- */\n  .tabs{\n    flex:0 0 auto;\n    display:flex; border-bottom:1px solid var(--line);\n  }\n  .tab{\n    flex:1 1 0; min-width:0;\n    background:none; border:0; cursor:pointer;\n    font-family:inherit; font-size:19px; font-weight:600; letter-spacing:-.3px;\n    color:var(--muted);\n    padding:10px 0 13px;\n    position:relative;\n    transition:color .35s var(--ease);\n  }\n  .tab.is-active{color:var(--ink); font-weight:700;}\n  .tab.is-active::after{\n    content:\"\"; position:absolute; left:14%; right:14%; bottom:-1px;\n    height:3px; border-radius:3px 3px 0 0; background:var(--accent);\n  }\n  .tab:hover{color:var(--ink-2);}\n\n  /* ---------- scroll body ---------- */\n  .screen{\n    flex:1 1 auto; min-height:0;\n    overflow:hidden;\n    padding:20px 24px 0;\n    display:flex; flex-direction:column;\n  }\n\n  /* focus card */\n  .focus{\n    border:1px solid var(--line-strong);\n    border-radius:var(--r-card);\n    background:var(--surface);\n    padding:16px 18px 14px;\n    box-shadow:var(--shadow-card);\n  }\n  .focus-top{display:flex; align-items:flex-start; gap:10px;}\n  .focus-label{\n    display:flex; align-items:center; gap:8px;\n    font-size:14px; font-weight:560; color:var(--ink-2); letter-spacing:-.1px;\n  }\n  .focus h2{\n    margin:5px 0 0; font-size:26px; font-weight:760; letter-spacing:-.7px; line-height:1.1;\n  }\n  .focus .icon-btn{margin:-4px -6px 0 auto; color:var(--ink-2);}\n  .track{\n    margin:16px 0 12px;\n    height:6px; border-radius:3px;\n    background-image:repeating-linear-gradient(to right,\n      var(--line-strong) 0 12px, transparent 12px 18px);\n  }\n  .focus-meta{\n    display:flex; align-items:baseline; justify-content:space-between;\n    font-size:14px;\n  }\n  .focus-meta .left{color:var(--muted); font-weight:500;}\n  .focus-meta .right{color:var(--ink); font-weight:700; letter-spacing:-.2px;}\n\n  /* recap banner */\n  .recap{\n    position:relative; overflow:hidden;\n    margin-top:18px;\n    height:96px; flex:0 0 96px;\n    border-radius:14px;\n    display:flex; align-items:center; justify-content:space-between;\n    padding:0 20px;\n    color:#fff;\n    background:linear-gradient(105deg, #05372c 0%, #07463800 60%), #063a2e;\n    box-shadow:var(--shadow-banner);\n    isolation:isolate;\n  }\n  .recap-art{\n    position:absolute; inset:0; width:100%; height:100%;\n    z-index:-2; display:block;\n  }\n  .recap::after{\n    content:\"\"; position:absolute; inset:0;\n    background-image:\n      radial-gradient(rgba(255,255,255,.11) .6px, transparent .7px),\n      radial-gradient(rgba(0,0,0,.13) .6px, transparent .7px);\n    background-size:4px 4px, 5px 5px;\n    background-position:0 0, 2px 3px;\n    mix-blend-mode:overlay;\n    z-index:-1;\n  }\n  .recap-veil{\n    position:absolute; inset:0; z-index:-1;\n    background:linear-gradient(96deg, rgba(4,42,33,.94) 6%, rgba(4,42,33,.55) 40%, rgba(4,42,33,0) 66%);\n  }\n  .recap-copy h3{\n    margin:0; font-size:23px; font-weight:760; letter-spacing:-.6px;\n    text-shadow:0 1px 12px rgba(3,34,27,.35);\n  }\n  .recap-copy p{\n    margin:3px 0 0; font-size:14px; font-weight:640; letter-spacing:-.1px;\n    color:rgba(255,255,255,.92);\n  }\n  .play{\n    width:50px; height:50px; flex:0 0 50px;\n    border-radius:var(--r-pill); border:0;\n    background:#fff; color:#083b30;\n    display:grid; place-items:center; cursor:pointer;\n    box-shadow:0 6px 18px -8px rgba(3,34,27,.6);\n    transition:transform .4s var(--ease);\n  }\n  .play:hover{transform:scale(1.05);}\n  .play:active{transform:scale(.95);}\n\n  /* sport chip */\n  .chip-row{margin-top:20px;}\n  .chip{\n    display:inline-flex; align-items:center; gap:8px;\n    border:1.5px solid var(--accent); color:var(--accent);\n    background:var(--surface);\n    border-radius:var(--r-pill);\n    padding:8px 18px 8px 14px;\n    font-size:16px; font-weight:640; letter-spacing:-.2px;\n    cursor:pointer;\n    transition:background-color .35s var(--ease), transform .35s var(--ease);\n  }\n  .chip:hover{background:var(--accent-soft);}\n  .chip:active{transform:scale(.97);}\n\n  /* week block */\n  .week-title{\n    margin:20px 0 0; font-size:22px; font-weight:760; letter-spacing:-.55px;\n  }\n  .stats{\n    display:grid; grid-template-columns:repeat(3, minmax(0,1fr));\n    gap:var(--s3);\n    margin-top:14px;\n  }\n  .stat dt{font-size:14px; color:var(--muted); font-weight:520; letter-spacing:-.1px;}\n  .stat dd{margin:4px 0 0; font-size:22px; font-weight:740; letter-spacing:-.6px;}\n\n  .chart-label{\n    margin:22px 0 6px; font-size:14px; color:var(--ink-2); font-weight:520;\n  }\n  .chart{display:block; width:100%; height:132px;}\n  .grid-line{stroke:var(--line); stroke-width:1;}\n  .axis-line{stroke:var(--line-strong); stroke-width:1;}\n  .now-line{stroke:#253f35; stroke-width:2;}\n  .series{fill:none; stroke:var(--accent); stroke-width:2.4; stroke-linejoin:round; stroke-linecap:round;}\n  .series-fill{fill:rgba(15,138,106,.16);}\n  .dot{fill:var(--surface); stroke:var(--accent); stroke-width:2.2;}\n  .dot-now{fill:var(--accent); stroke:none;}\n  .dot-now-halo{fill:rgba(15,138,106,.22);}\n  .y-label{fill:var(--ink-2); font-size:12.5px; font-weight:560; font-family:var(--font);}\n  .x-label{fill:var(--muted); font-size:12.5px; font-weight:600; letter-spacing:.4px; font-family:var(--font);}\n\n  .cta{\n    margin-top:auto; margin-bottom:14px;\n    display:block; width:100%;\n    border:0; border-radius:var(--r-pill);\n    background:var(--accent); color:#fff;\n    font-family:inherit; font-size:17px; font-weight:700; letter-spacing:-.25px;\n    padding:15px 0;\n    cursor:pointer;\n    box-shadow:0 10px 24px -14px rgba(10,95,76,.85);\n    transition:transform .4s var(--ease), background-color .4s var(--ease);\n  }\n  .cta:hover{background:var(--accent-deep); transform:translateY(-1px);}\n  .cta:active{transform:translateY(0) scale(.99);}\n\n  /* ---------- tab bar ---------- */\n  .tabbar{\n    flex:0 0 auto;\n    border-top:1px solid var(--line);\n    background:rgba(249,252,251,.86);\n    backdrop-filter:saturate(180%) blur(18px);\n    -webkit-backdrop-filter:saturate(180%) blur(18px);\n    display:grid; grid-template-columns:repeat(5, 1fr);\n    padding:10px 6px 8px;\n  }\n  .nav{\n    background:none; border:0; cursor:pointer;\n    display:flex; flex-direction:column; align-items:center; gap:5px;\n    color:var(--ink); font-family:inherit;\n    font-size:12.5px; font-weight:620; letter-spacing:-.1px;\n    padding:0;\n    transition:transform .35s var(--ease), color .35s var(--ease);\n  }\n  .nav:hover{transform:translateY(-1px);}\n  .nav-ico{position:relative; display:grid; place-items:center; height:28px;}\n  .nav.is-active{color:var(--accent);}\n  .badge{\n    position:absolute; top:-4px; right:-11px;\n    min-width:19px; height:19px; padding:0 5px;\n    border-radius:var(--r-pill);\n    background:#c2452f; color:#fff;\n    font-size:11.5px; font-weight:700; line-height:19px; text-align:center;\n    box-shadow:0 0 0 2px var(--page);\n  }\n  .home-indicator{\n    flex:0 0 22px; display:grid; place-items:center;\n    background:rgba(249,252,251,.86);\n  }\n  .home-indicator span{\n    display:block; width:140px; height:5px; border-radius:3px;\n    background:#0c221a; opacity:.85;\n  }\n</style>\n\n  <div class=\"device\">\n\n    <!-- status bar -->\n    <div class=\"statusbar\">\n      <div class=\"sb-time\">\n        9:41\n        <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n          <path d=\"M21.3 2.7 2.9 10.4c-1 .4-.9 1.9.2 2.1l7 1.6 1.6 7c.2 1.1 1.7 1.2 2.1.2l7.7-18.4c.4-.8-.4-1.6-1.2-1.2z\"/>\n        </svg>\n      </div>\n      <div class=\"sb-right\">\n        <svg width=\"18\" height=\"12\" viewBox=\"0 0 18 12\" fill=\"currentColor\" aria-hidden=\"true\">\n          <rect x=\"0\" y=\"8\" width=\"3\" height=\"4\" rx=\"1\"/>\n          <rect x=\"5\" y=\"5.5\" width=\"3\" height=\"6.5\" rx=\"1\"/>\n          <rect x=\"10\" y=\"3\" width=\"3\" height=\"9\" rx=\"1\"/>\n          <rect x=\"15\" y=\"0\" width=\"3\" height=\"12\" rx=\"1\"/>\n        </svg>\n        <svg width=\"17\" height=\"12\" viewBox=\"0 0 17 12\" fill=\"currentColor\" aria-hidden=\"true\">\n          <path d=\"M8.5 11.6 6.3 9.1a3.3 3.3 0 0 1 4.4 0l-2.2 2.5zM4.4 7 2.9 5.3a8.4 8.4 0 0 1 11.2 0L12.6 7a6.2 6.2 0 0 0-8.2 0zM1.2 3.4-.2 1.8a12.7 12.7 0 0 1 17.4 0l-1.4 1.6a10.6 10.6 0 0 0-14.6 0z\"/>\n        </svg>\n        <svg width=\"26\" height=\"13\" viewBox=\"0 0 26 13\" aria-hidden=\"true\">\n          <rect x=\"0.6\" y=\"0.6\" width=\"21.5\" height=\"11.8\" rx=\"3.6\" fill=\"none\" stroke=\"currentColor\" stroke-opacity=\".38\" stroke-width=\"1.1\"/>\n          <rect x=\"2.2\" y=\"2.2\" width=\"18.3\" height=\"8.6\" rx=\"2.3\" fill=\"currentColor\"/>\n          <path d=\"M23.6 4.3c1.3.4 1.3 4 0 4.4V4.3z\" fill=\"currentColor\" fill-opacity=\".45\"/>\n        </svg>\n      </div>\n    </div>\n\n    <!-- app bar -->\n    <header class=\"appbar\">\n      <div class=\"avatar\">\n        <img src=\"https://images.pexels.com/photos/20051635/pexels-photo-20051635.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=200\" alt=\"Portrait by Thanh Xuan Nguyen Ly on Pexels\" width=\"200\" height=\"200\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n      </div>\n      <h1>Overview</h1>\n      <div class=\"appbar-actions\">\n        <button class=\"icon-btn\" aria-label=\"Add a session\">\n          <svg width=\"27\" height=\"27\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"9.2\"/><path d=\"M12 7.6v8.8M7.6 12h8.8\"/>\n          </svg>\n        </button>\n        <button class=\"icon-btn\" aria-label=\"Settings\">\n          <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\">\n            <path d=\"M12 15.1a3.1 3.1 0 1 0 0-6.2 3.1 3.1 0 0 0 0 6.2z\"/>\n            <path d=\"m19.5 13.6.1-1.6-.1-1.6 1.7-1.3-1.6-2.8-2 .7-2.7-1.6L14.5 3h-3.2l-.4 2.4-2.7 1.6-2-.7-1.6 2.8 1.7 1.3-.1 1.6.1 1.6-1.7 1.3 1.6 2.8 2-.7 2.7 1.6.4 2.4h3.2l.4-2.4 2.7-1.6 2 .7 1.6-2.8-1.7-1.3z\"/>\n          </svg>\n        </button>\n      </div>\n    </header>\n\n    <!-- tabs -->\n    <nav class=\"tabs\">\n      <button class=\"tab is-active\">Progress</button>\n      <button class=\"tab\">Sessions</button>\n    </nav>\n\n    <!-- content -->\n    <main class=\"screen\">\n\n      <section class=\"focus\">\n        <div class=\"focus-top\">\n          <div>\n            <div class=\"focus-label\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                <path d=\"M4 3.2h16v11.1c0 3-2.9 4.6-8 6.5-5.1-1.9-8-3.5-8-6.5V3.2z\" fill=\"var(--accent)\"/>\n                <path d=\"M13.4 6.6 9 13.1h2.9l-1.3 4.6 4.4-6.7h-2.9l1.3-4.4z\" fill=\"#fff\"/>\n              </svg>\n              Your focus\n            </div>\n            <h2>Move daily</h2>\n          </div>\n          <button class=\"icon-btn\" aria-label=\"Edit focus\">\n            <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\">\n              <path d=\"m15.4 4.6 4 4L8.9 19.1l-5 1 1-5L15.4 4.6z\"/>\n            </svg>\n          </button>\n        </div>\n        <div class=\"track\" role=\"presentation\"></div>\n        <div class=\"focus-meta\">\n          <span class=\"left\">7 months left</span>\n          <span class=\"right\">Dec 31, 2026</span>\n        </div>\n      </section>\n\n      <section class=\"recap\">\n        <svg class=\"recap-art\" viewBox=\"0 0 382 96\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n          <defs>\n            <linearGradient id=\"ribbonA\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0\" stop-color=\"#0e7f64\"/>\n              <stop offset=\"1\" stop-color=\"#35dcaa\"/>\n            </linearGradient>\n            <linearGradient id=\"ribbonB\" x1=\"0\" y1=\"1\" x2=\"1\" y2=\"0\">\n              <stop offset=\"0\" stop-color=\"#0a5c4a\"/>\n              <stop offset=\"1\" stop-color=\"#1cb98c\"/>\n            </linearGradient>\n          </defs>\n          <rect width=\"382\" height=\"96\" fill=\"#053225\"/>\n          <path d=\"M92 -46 C 214 -6, 150 74, 268 140\" stroke=\"url(#ribbonA)\" stroke-width=\"66\" fill=\"none\" stroke-linecap=\"round\"/>\n          <path d=\"M188 -34 C 292 12, 244 66, 400 46\" stroke=\"url(#ribbonB)\" stroke-width=\"40\" fill=\"none\" stroke-linecap=\"round\" opacity=\".92\"/>\n          <path d=\"M250 108 C 300 62, 330 44, 402 26\" stroke=\"#3ff0bb\" stroke-width=\"15\" fill=\"none\" stroke-linecap=\"round\" opacity=\".55\"/>\n          <path d=\"M148 -20 C 206 22, 178 60, 226 118\" stroke=\"#04302a\" stroke-width=\"10\" fill=\"none\" opacity=\".5\"/>\n        </svg>\n        <span class=\"recap-veil\"></span>\n        <div class=\"recap-copy\">\n          <h3>Season Recap</h3>\n          <p>May 2026 · Preview</p>\n        </div>\n        <button class=\"play\" aria-label=\"Play your season recap\">\n          <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n            <path d=\"M7.5 4.6v14.8L20 12 7.5 4.6z\"/>\n          </svg>\n        </button>\n      </section>\n\n      <div class=\"chip-row\">\n        <button class=\"chip\">\n          <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n            <path d=\"M2.8 18.4h17.4a1 1 0 0 0 1-1v-.5c0-.8-.6-1.5-1.4-1.6a13.4 13.4 0 0 1-5.5-1.8l-3.1-1.9-2.6 1.9H4.6a1.8 1.8 0 0 0-1.8 1.8z\"/>\n            <path d=\"M7.9 13.5 9.4 15M10.5 11.5 12 13.1\"/>\n          </svg>\n          Run\n        </button>\n      </div>\n\n      <h2 class=\"week-title\">This week</h2>\n      <dl class=\"stats\">\n        <div class=\"stat\"><dt>Distance</dt><dd>3.42 km</dd></div>\n        <div class=\"stat\"><dt>Time</dt><dd>19m 47s</dd></div>\n        <div class=\"stat\"><dt>Elev gain</dt><dd>28 m</dd></div>\n      </dl>\n\n      <p class=\"chart-label\">Past 12 weeks</p>\n      <svg class=\"chart\" viewBox=\"0 0 382 132\" role=\"img\" aria-label=\"Weekly distance over the past 12 weeks, rising to 3.42 kilometres this week\">\n        <line class=\"grid-line\" x1=\"0\" y1=\"14\" x2=\"316\" y2=\"14\"/>\n        <line class=\"grid-line\" x1=\"0\" y1=\"57\" x2=\"316\" y2=\"57\"/>\n        <line class=\"axis-line\" x1=\"0\" y1=\"100\" x2=\"316\" y2=\"100\"/>\n\n        <path class=\"series-fill\" d=\"M288 100 L316 26.5 L316 100 Z\"/>\n        <path class=\"series\" d=\"M8 100 H288 L316 26.5\"/>\n        <line class=\"now-line\" x1=\"316\" y1=\"8\" x2=\"316\" y2=\"100\"/>\n\n        <circle class=\"dot\" cx=\"8\" cy=\"100\" r=\"4.2\"/>\n        <circle class=\"dot\" cx=\"36\" cy=\"100\" r=\"4.2\"/>\n        <circle class=\"dot\" cx=\"64\" cy=\"100\" r=\"4.2\"/>\n        <circle class=\"dot\" cx=\"92\" cy=\"100\" r=\"4.2\"/>\n        <circle class=\"dot\" cx=\"120\" cy=\"100\" r=\"4.2\"/>\n        <circle class=\"dot\" cx=\"148\" cy=\"100\" r=\"4.2\"/>\n        <circle class=\"dot\" cx=\"176\" cy=\"100\" r=\"4.2\"/>\n        <circle class=\"dot\" cx=\"204\" cy=\"100\" r=\"4.2\"/>\n        <circle class=\"dot\" cx=\"232\" cy=\"100\" r=\"4.2\"/>\n        <circle class=\"dot\" cx=\"260\" cy=\"100\" r=\"4.2\"/>\n        <circle class=\"dot\" cx=\"288\" cy=\"100\" r=\"4.2\"/>\n        <circle class=\"dot-now-halo\" cx=\"316\" cy=\"26.5\" r=\"10\"/>\n        <circle class=\"dot-now\" cx=\"316\" cy=\"26.5\" r=\"5.4\"/>\n\n        <text class=\"y-label\" x=\"330\" y=\"18\">4 km</text>\n        <text class=\"y-label\" x=\"330\" y=\"61\">2 km</text>\n        <text class=\"y-label\" x=\"330\" y=\"104\">0 km</text>\n\n        <text class=\"x-label\" x=\"59\" y=\"126\" text-anchor=\"middle\">APR</text>\n        <text class=\"x-label\" x=\"161\" y=\"126\" text-anchor=\"middle\">MAY</text>\n        <text class=\"x-label\" x=\"263\" y=\"126\" text-anchor=\"middle\">JUN</text>\n      </svg>\n\n      <button class=\"cta\">See your full progress</button>\n    </main>\n\n    <!-- tab bar -->\n    <nav class=\"tabbar\">\n      <button class=\"nav\">\n        <span class=\"nav-ico\">\n          <svg width=\"25\" height=\"25\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\">\n            <path d=\"M3.4 10.4 12 3.6l8.6 6.8V20a.9.9 0 0 1-.9.9h-4.4v-6h-6.6v6H4.3a.9.9 0 0 1-.9-.9v-9.6z\"/>\n          </svg>\n          <span class=\"badge\">4</span>\n        </span>\n        Home\n      </button>\n      <button class=\"nav\">\n        <span class=\"nav-ico\">\n          <svg width=\"25\" height=\"25\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\">\n            <path d=\"M2.8 6.4 9 3.6l6 2.8 6.2-2.8v14L15 20.4l-6-2.8-6.2 2.8v-14z\"/>\n            <path d=\"M9 3.6v14M15 6.4v14\"/>\n          </svg>\n        </span>\n        Routes\n      </button>\n      <button class=\"nav\">\n        <span class=\"nav-ico\">\n          <svg width=\"27\" height=\"27\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\">\n            <circle cx=\"12\" cy=\"12\" r=\"9.2\"/><circle cx=\"12\" cy=\"12\" r=\"5\" fill=\"currentColor\" stroke=\"none\"/>\n          </svg>\n        </span>\n        Record\n      </button>\n      <button class=\"nav\">\n        <span class=\"nav-ico\">\n          <svg width=\"25\" height=\"25\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\">\n            <path d=\"M8.4 4.6 12 8.2l-3.6 3.6L4.8 8.2l3.6-3.6z\"/>\n            <path d=\"M15.6 4.6 19.2 8.2l-3.6 3.6L12 8.2l3.6-3.6z\"/>\n            <path d=\"M12 12.2l3.6 3.6-3.6 3.6-3.6-3.6 3.6-3.6z\"/>\n          </svg>\n        </span>\n        Clubs\n      </button>\n      <button class=\"nav is-active\">\n        <span class=\"nav-ico\">\n          <svg width=\"25\" height=\"25\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n            <rect x=\"4.2\" y=\"3.6\" width=\"15.6\" height=\"3.2\" rx=\"1.1\"/>\n            <rect x=\"5.6\" y=\"8.6\" width=\"12.8\" height=\"11.8\" rx=\"1.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/>\n            <rect x=\"8.6\" y=\"13.4\" width=\"2.4\" height=\"4.2\" rx=\"1\"/>\n            <rect x=\"13\" y=\"11.2\" width=\"2.4\" height=\"6.4\" rx=\"1\"/>\n          </svg>\n        </span>\n        You\n      </button>\n    </nav>\n    <div class=\"home-indicator\"><span></span></div>\n  </div>\n",
      "created": "2026-09-09T05:22:43.360Z",
      "modified": "2026-09-09T05:22:43.360Z",
      "comments": [],
      "overrides": {
        "htmlAttrs": " lang=\"en\"",
        "head": "<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Kestrel — Overview</title>"
      }
    },
    "var_620cd3eb3540": {
      "type": "variant",
      "label": "kestrel_progress_trackside_redesign",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 530,
        "y": 0,
        "w": 430,
        "h": 1027
      },
      "html": "<style>\n    .kestrel-redesign {\n    --page: #F9FCFB;\n    --surface: #FFFFFF;\n    --ink: #0F211A;\n    --ink-2: #385248;\n    --muted: #53695F;\n    --line: #D3DEDA;\n    --accent: #0F8A6A;\n    --action: #08735A;\n    --moss: #A7BDB1;\n    --moss-deep: #78988A;\n    --focus-ring: #08735A;\n    width: 100%;\n    max-width: 430px;\n    min-height: 0;\n    margin: 0 auto;\n    background: var(--page);\n    color: var(--ink);\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"SF Pro Display\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    font-synthesis: none;\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  .kestrel-redesign button {\n    font: inherit;\n    color: inherit;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .kestrel-redesign button:focus-visible,\n  .kestrel-redesign [role=\"tab\"]:focus-visible,\n  .kestrel-redesign [role=\"option\"]:focus-visible {\n    outline: 2px solid var(--focus-ring);\n    outline-offset: 3px;\n  }\n\n  .kestrel-status {\n    min-height: 52px;\n    padding: env(safe-area-inset-top, 0px) 20px 0;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    color: var(--ink);\n    font-size: 17px;\n    font-weight: 650;\n    letter-spacing: -0.2px;\n  }\n\n  .kestrel-status-right {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n  }\n\n  .kestrel-appbar {\n    display: grid;\n    grid-template-columns: 52px minmax(0, 1fr) 52px;\n    align-items: center;\n    padding: 5px 14px 5px;\n  }\n\n  .kestrel-avatar-button,\n  .kestrel-icon-button {\n    width: 44px;\n    height: 44px;\n    min-width: 44px;\n    min-height: 44px;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    display: grid;\n    place-items: center;\n    cursor: pointer;\n    border-radius: 10px;\n  }\n\n  .kestrel-avatar {\n    width: 36px;\n    height: 36px;\n    position: relative;\n    overflow: hidden;\n    display: grid;\n    place-items: center;\n    border-radius: 11px;\n    background: #D3DEDA;\n    color: var(--ink-2);\n    font-size: 12px;\n    font-weight: 750;\n    letter-spacing: -0.2px;\n  }\n\n  .kestrel-avatar img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  .kestrel-app-title {\n    margin: 0;\n    text-align: center;\n    font-size: 21px;\n    line-height: 1.1;\n    font-weight: 720;\n    letter-spacing: -0.45px;\n  }\n\n  .kestrel-tabs {\n    height: 56px;\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    border-bottom: 1px solid var(--line);\n  }\n\n  .kestrel-tab {\n    position: relative;\n    min-height: 56px;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    color: var(--ink-2);\n    cursor: pointer;\n    font-size: 17px;\n    font-weight: 620;\n    letter-spacing: -0.25px;\n  }\n\n  .kestrel-tab[aria-selected=\"true\"] {\n    color: var(--ink);\n    font-weight: 720;\n  }\n\n  .kestrel-tab[aria-selected=\"true\"]::after {\n    content: \"\";\n    position: absolute;\n    left: 24px;\n    right: 24px;\n    bottom: -1px;\n    height: 3px;\n    border-radius: 3px 3px 0 0;\n    background: var(--accent);\n  }\n\n  .kestrel-main {\n    padding: 20px 20px 0;\n  }\n\n  .kestrel-focus {\n    border: 1px solid var(--line);\n    border-radius: 12px;\n    background: var(--surface);\n    padding: 16px;\n    transition: border-color 160ms ease;\n  }\n\n  .kestrel-focus.is-editing {\n    border-color: var(--accent);\n  }\n\n  .kestrel-focus-heading {\n    min-width: 0;\n  }\n\n  .kestrel-section-label {\n    margin: 0;\n    color: var(--ink-2);\n    font-size: 13px;\n    line-height: 1.25;\n    font-weight: 680;\n    letter-spacing: 0.05px;\n  }\n\n  .kestrel-focus-title {\n    margin: 4px 0 0;\n    font-size: 25px;\n    line-height: 1.1;\n    font-weight: 760;\n    letter-spacing: -0.7px;\n  }\n\n  .kestrel-edit-button {\n    flex: 0 0 44px;\n    width: 44px;\n    height: 44px;\n    min-width: 44px;\n    min-height: 44px;\n    margin: -8px -8px 0 0;\n    padding: 0;\n    border: 0;\n    border-radius: 10px;\n    background: transparent;\n    display: grid;\n    place-items: center;\n    cursor: pointer;\n    color: var(--ink-2);\n  }\n\n  .kestrel-focus-meta {\n    display: flex;\n    align-items: baseline;\n    justify-content: space-between;\n    gap: 12px;\n    margin-top: 14px;\n    color: var(--muted);\n    font-size: 14px;\n    line-height: 1.3;\n    letter-spacing: -0.1px;\n  }\n\n  .kestrel-focus-meta strong {\n    color: var(--ink);\n    font-weight: 680;\n  }\n\n  .kestrel-deadline-rail {\n    position: relative;\n    margin-top: 17px;\n    padding: 0 1px;\n  }\n\n  .kestrel-rail-line {\n    position: absolute;\n    left: 9px;\n    right: 9px;\n    top: 7px;\n    height: 2px;\n    background: var(--line);\n  }\n\n  .kestrel-rail-points {\n    position: relative;\n    display: grid;\n    grid-template-columns: repeat(8, minmax(0, 1fr));\n    gap: 0;\n  }\n\n  .kestrel-rail-point {\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 6px;\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 650;\n    letter-spacing: -0.25px;\n  }\n\n  .kestrel-rail-point i {\n    width: 15px;\n    height: 15px;\n    border: 2px solid var(--line);\n    border-radius: 999px;\n    background: var(--surface);\n    display: block;\n  }\n\n  .kestrel-rail-point.is-current {\n    color: var(--ink);\n  }\n\n  .kestrel-rail-point.is-current i {\n    border-color: var(--accent);\n    background: var(--accent);\n  }\n\n  .kestrel-week {\n    margin-top: 32px;\n  }\n\n  .kestrel-week-heading {\n    min-height: 44px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n  }\n\n  .kestrel-module-title {\n    margin: 0;\n    color: var(--ink);\n    font-size: 22px;\n    line-height: 1.15;\n    font-weight: 730;\n    letter-spacing: -0.55px;\n  }\n\n  .kestrel-activity-wrap {\n    position: relative;\n    flex: 0 0 auto;\n  }\n\n  .kestrel-activity-button {\n    min-width: 44px;\n    min-height: 44px;\n    padding: 0 11px;\n    border: 1px solid var(--line);\n    border-radius: 8px;\n    background: var(--surface);\n    color: var(--ink);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n    cursor: pointer;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 680;\n    letter-spacing: -0.15px;\n  }\n\n  .kestrel-activity-button[aria-pressed=\"true\"] {\n    border-color: var(--ink-2);\n  }\n\n  .kestrel-activity-menu {\n    position: absolute;\n    z-index: 3;\n    top: calc(100% + 8px);\n    right: 0;\n    min-width: 152px;\n    padding: 5px;\n    border: 1px solid var(--line);\n    border-radius: 8px;\n    background: var(--surface);\n    box-shadow: 0 8px 18px rgba(15, 33, 26, 0.12);\n  }\n\n  .kestrel-activity-option {\n    width: 100%;\n    min-height: 44px;\n    padding: 0 10px;\n    border: 0;\n    border-radius: 6px;\n    background: transparent;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    color: var(--ink);\n    cursor: pointer;\n    font-size: 14px;\n    font-weight: 650;\n    text-align: left;\n  }\n\n  .kestrel-activity-option[aria-selected=\"true\"] {\n    background: #EAF5F1;\n  }\n\n  .kestrel-lead-label,\n  .kestrel-support-label,\n  .kestrel-chart-helper {\n    color: var(--muted);\n    font-size: 13px;\n    line-height: 1.25;\n    font-weight: 650;\n    letter-spacing: -0.05px;\n  }\n\n  .kestrel-lead-label {\n    margin-top: 16px;\n  }\n\n  .kestrel-lead-value,\n  .kestrel-support-value {\n    font-variant-numeric: tabular-nums lining-nums;\n  }\n\n  .kestrel-lead-value {\n    margin-top: 4px;\n    color: var(--ink);\n    font-size: 36px;\n    line-height: 1.05;\n    font-weight: 760;\n    letter-spacing: -1.4px;\n  }\n\n  .kestrel-support-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 24px;\n    margin-top: 19px;\n  }\n\n  .kestrel-support-value {\n    margin-top: 4px;\n    color: var(--ink);\n    font-size: 21px;\n    line-height: 1.1;\n    font-weight: 720;\n    letter-spacing: -0.45px;\n  }\n\n  .kestrel-history {\n    margin-top: 32px;\n    margin-left: -8px;\n    margin-right: -8px;\n  }\n\n  .kestrel-history-heading {\n    padding: 0 8px;\n  }\n\n  .kestrel-chart-helper {\n    margin: 5px 0 0;\n  }\n\n  .kestrel-chart-figure {\n    position: relative;\n    height: 235px;\n    margin-top: 13px;\n    padding-left: 43px;\n    padding-right: 8px;\n  }\n\n  .kestrel-chart-y-labels {\n    position: absolute;\n    left: 8px;\n    top: 34px;\n    height: 160px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace;\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 650;\n    white-space: nowrap;\n  }\n\n  .kestrel-chart-plot {\n    position: relative;\n    height: 235px;\n  }\n\n  .kestrel-chart-note {\n    position: absolute;\n    top: 0;\n    left: 50%;\n    right: auto;\n    transform: translateX(-50%);\n    color: var(--accent);\n    font-size: 12px;\n    line-height: 1.2;\n    font-weight: 720;\n    letter-spacing: -0.15px;\n    white-space: nowrap;\n  }\n\n  .kestrel-chart-lines {\n    position: absolute;\n    top: 34px;\n    left: 0;\n    right: 0;\n    height: 160px;\n  }\n\n  .kestrel-chart-lines span {\n    position: absolute;\n    left: 0;\n    right: 0;\n    height: 1px;\n    background: var(--line);\n  }\n\n  .kestrel-chart-lines .line-top { top: 0; }\n  .kestrel-chart-lines .line-mid { top: 80px; }\n  .kestrel-chart-lines .line-bottom { bottom: 0; background: var(--line); }\n\n  .kestrel-chart-bars {\n    position: absolute;\n    top: 34px;\n    left: 0;\n    right: 0;\n    height: 160px;\n    display: grid;\n    grid-template-columns: repeat(12, minmax(0, 1fr));\n    align-items: end;\n    gap: 5px;\n  }\n\n  .kestrel-chart-bar {\n    position: relative;\n    width: 100%;\n    height: 160px;\n    min-height: 44px;\n    padding: 0 1px;\n    border: 0;\n    border-radius: 0;\n    background: transparent;\n    cursor: pointer;\n  }\n\n  .kestrel-chart-bar::after {\n    content: \"\";\n    position: absolute;\n    left: 2px;\n    right: 2px;\n    bottom: 0;\n    height: var(--bar-height);\n    min-height: 4px;\n    border-radius: 3px 3px 0 0;\n    background: var(--moss);\n  }\n\n  .kestrel-chart-bar.is-current::after {\n    background: var(--accent);\n  }\n\n  .kestrel-chart-bar.is-selected::after {\n    box-shadow: 0 0 0 2px var(--ink-2);\n  }\n\n  .kestrel-chart-bar.is-current.is-selected::after {\n    box-shadow: 0 0 0 2px var(--action);\n  }\n\n  .kestrel-chart-months {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 8px;\n    display: grid;\n    grid-template-columns: repeat(12, minmax(0, 1fr));\n    color: var(--muted);\n    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 650;\n    letter-spacing: 0.75px;\n    text-align: center;\n  }\n\n  .kestrel-chart-months .apr { grid-column: 2 / span 3; }\n  .kestrel-chart-months .may { grid-column: 5 / span 4; }\n  .kestrel-chart-months .jun { grid-column: 9 / span 4; }\n\n  .kestrel-bottom-nav {\n    margin-top: 32px;\n    border-top: 1px solid var(--line);\n    padding: 0 6px max(8px, env(safe-area-inset-bottom, 8px));\n    display: grid;\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n    background: var(--page);\n  }\n\n  .kestrel-nav-item {\n    position: relative;\n    min-width: 0;\n    min-height: 71px;\n    padding: 7px 2px 0;\n    border: 0;\n    background: transparent;\n    color: var(--ink-2);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-start;\n    gap: 4px;\n    cursor: pointer;\n    font-size: 12px;\n    line-height: 1.1;\n    font-weight: 650;\n    letter-spacing: -0.05px;\n  }\n\n  .kestrel-nav-item.is-current {\n    color: var(--accent);\n  }\n\n  .kestrel-nav-item.is-current::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    width: 22px;\n    height: 3px;\n    border-radius: 0 0 3px 3px;\n    background: var(--accent);\n  }\n\n  .kestrel-nav-icon {\n    width: 44px;\n    height: 44px;\n    display: grid;\n    place-items: center;\n  }\n\n  .kestrel-nav-item.is-record {\n    color: var(--ink);\n  }\n\n  .kestrel-record-icon {\n    width: 44px;\n    height: 44px;\n    border-radius: 999px;\n    background: var(--action);\n    color: #FFFFFF;\n    display: grid;\n    place-items: center;\n  }\n\n  .kestrel-safe-footer {\n    height: 24px;\n    display: grid;\n    place-items: end center;\n    padding-bottom: max(7px, env(safe-area-inset-bottom, 7px));\n    background: var(--page);\n  }\n\n  .kestrel-home-indicator {\n    width: 122px;\n    height: 5px;\n    border-radius: 999px;\n    background: var(--ink);\n  }\n\n  .kestrel-sessions-panel {\n    padding: 32px 0 80px;\n  }\n\n  .kestrel-sessions-panel p {\n    max-width: 300px;\n    margin: 10px 0 0;\n    color: var(--muted);\n    font-size: 15px;\n    line-height: 1.45;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .kestrel-focus { transition: none; }\n  }\n</style>\n<div aria-label=\"Kestrel trackside lap board redesign\" class=\"kestrel-redesign\" data-kid=\"1\" data-name=\"page layout container\" data-variant=\"kestrel-progress-trackside-redesign\">\n    <!-- Kestrel variant: Trackside lap board redesign -->\n    <div aria-label=\"Status bar\" class=\"kestrel-status\" data-kid=\"1-1\" data-name=\"status bar\">\n        <span data-kid=\"1-