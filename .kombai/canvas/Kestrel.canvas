upporting weekly metrics\" class=\"kestrel-support-grid\" data-kid=\"1-4-1-2-4\" data-name=\"weekly metrics grid\">\n                    <div data-kid=\"1-4-1-2-4-1\" data-name=\"weekly time metric container\">\n                        <div class=\"kestrel-support-label\" data-kid=\"1-4-1-2-4-1-1\" data-name=\"weekly time metric label\">\n                            Time\n                        </div>\n                        <div class=\"kestrel-support-value\" data-kid=\"1-4-1-2-4-1-2\" data-name=\"weekly time metric value\">\n                            19m 47s\n                        </div>\n                    </div>\n                    <div data-kid=\"1-4-1-2-4-2\" data-name=\"weekly elevation metric container\">\n                        <div class=\"kestrel-support-label\" data-kid=\"1-4-1-2-4-2-1\" data-name=\"weekly elevation metric label\">\n                            Elev gain\n                        </div>\n                        <div class=\"kestrel-support-value\" data-kid=\"1-4-1-2-4-2-2\" data-name=\"weekly elevation metric value\">\n                            28 m\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section aria-labelledby=\"history-title\" class=\"kestrel-history\" data-kid=\"1-4-1-3\" data-name=\"weekly distance history section\">\n                <div class=\"kestrel-history-heading\" data-kid=\"1-4-1-3-1\" data-name=\"history section heading\">\n                    <h2 class=\"kestrel-module-title\" data-kid=\"1-4-1-3-1-1\" data-name=\"history section title\" id=\"history-title\">\n                        Weekly distance\n                    </h2>\n                    <p class=\"kestrel-chart-helper\" data-kid=\"1-4-1-3-1-2\" data-name=\"history helper text\">\n                        12 weeks · km\n                    </p>\n                </div>\n                <p class=\"sr-only\" data-kid=\"1-4-1-3-2\" data-name=\"chart accessibility description\" id=\"weekly-distance-summary\">\n                    Weekly distance for the last 12 weeks. Weeks 1 through 11 are 0 kilometres; this week is 3.42 kilometres. The chart scale is 0 to 4 kilometres. Select a bar to hear its week and distance.\n                </p>\n                <ol aria-label=\"Weekly distance data\" class=\"sr-only\" data-kid=\"1-4-1-3-3\" data-name=\"chart data list\">\n                    <li data-kid=\"1-4-1-3-3-1\" data-name=\"week 1 data point\">\n                        Week 1: 0 kilometres\n                    </li>\n                    <li data-kid=\"1-4-1-3-3-2\" data-name=\"week 2 data point\">\n                        Week 2: 0 kilometres\n                    </li>\n                    <li data-kid=\"1-4-1-3-3-3\" data-name=\"week 3 data point\">\n                        Week 3: 0 kilometres\n                    </li>\n                    <li data-kid=\"1-4-1-3-3-4\" data-name=\"week 4 data point\">\n                        Week 4: 0 kilometres\n                    </li>\n                    <li data-kid=\"1-4-1-3-3-5\" data-name=\"week 5 data point\">\n                        Week 5: 0 kilometres\n                    </li>\n                    <li data-kid=\"1-4-1-3-3-6\" data-name=\"week 6 data point\">\n                        Week 6: 0 kilometres\n                    </li>\n                    <li data-kid=\"1-4-1-3-3-7\" data-name=\"week 7 data point\">\n                        Week 7: 0 kilometres\n                    </li>\n                    <li data-kid=\"1-4-1-3-3-8\" data-name=\"week 8 data point\">\n                        Week 8: 0 kilometres\n                    </li>\n                    <li data-kid=\"1-4-1-3-3-9\" data-name=\"week 9 data point\">\n                        Week 9: 0 kilometres\n                    </li>\n                    <li data-kid=\"1-4-1-3-3-10\" data-name=\"week 10 data point\">\n                        Week 10: 0 kilometres\n                    </li>\n                    <li data-kid=\"1-4-1-3-3-11\" data-name=\"week 11 data point\">\n                        Week 11: 0 kilometres\n                    </li>\n                    <li data-kid=\"1-4-1-3-3-12\" data-name=\"week 12 data point\">\n                        This week: 3.42 kilometres\n                    </li>\n                </ol>\n                <div aria-describedby=\"weekly-distance-summary\" aria-labelledby=\"history-title\" class=\"kestrel-chart-figure\" data-kid=\"1-4-1-3-4\" data-name=\"chart figure container\" role=\"figure\">\n                    <div aria-hidden=\"true\" class=\"kestrel-chart-y-labels\" data-kid=\"1-4-1-3-4-1\" data-name=\"chart Y axis labels container\">\n                        <span data-kid=\"1-4-1-3-4-1-1\" data-name=\"Y axis 4km label\">\n                            4 km\n                        </span>\n                        <span data-kid=\"1-4-1-3-4-1-2\" data-name=\"Y axis 2km label\">\n                            2 km\n                        </span>\n                        <span data-kid=\"1-4-1-3-4-1-3\" data-name=\"Y axis 0km label\">\n                            0 km\n                        </span>\n                    </div>\n                    <div class=\"kestrel-chart-plot\" data-kid=\"1-4-1-3-4-2\" data-name=\"chart plot area\">\n                        <div aria-live=\"polite\" class=\"kestrel-chart-note\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-1\" data-name=\"chart tooltip note\" data-reason=\"text and positioning updated by script\" id=\"chart-note\">\n                            This week · 3.42 km\n                        </div>\n                        <div aria-hidden=\"true\" class=\"kestrel-chart-lines\" data-kid=\"1-4-1-3-4-2-2\" data-name=\"chart background lines container\">\n                            <span class=\"line-top\" data-kid=\"1-4-1-3-4-2-2-1\" data-name=\"chart top horizontal line\">\n                            </span>\n                            <span class=\"line-mid\" data-kid=\"1-4-1-3-4-2-2-2\" data-name=\"chart middle horizontal line\">\n                            </span>\n                            <span class=\"line-bottom\" data-kid=\"1-4-1-3-4-2-2-3\" data-name=\"chart bottom horizontal line\">\n                            </span>\n                        </div>\n                        <div aria-label=\"Selectable weekly distances\" class=\"kestrel-chart-bars\" data-kid=\"1-4-1-3-4-2-3\" data-name=\"chart bars container\" role=\"group\">\n                            <button aria-label=\"Week 1, 0 kilometres\" class=\"kestrel-chart-bar\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-1\" data-name=\"week 1 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"0 km\" data-week=\"Week 1\" style=\"--bar-height: 4px\" type=\"button\">\n                            </button>\n                            <button aria-label=\"Week 2, 0 kilometres\" class=\"kestrel-chart-bar\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-2\" data-name=\"week 2 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"0 km\" data-week=\"Week 2\" style=\"--bar-height: 4px\" type=\"button\">\n                            </button>\n                            <button aria-label=\"Week 3, 0 kilometres\" class=\"kestrel-chart-bar\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-3\" data-name=\"week 3 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"0 km\" data-week=\"Week 3\" style=\"--bar-height: 4px\" type=\"button\">\n                            </button>\n                            <button aria-label=\"Week 4, 0 kilometres\" class=\"kestrel-chart-bar\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-4\" data-name=\"week 4 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"0 km\" data-week=\"Week 4\" style=\"--bar-height: 4px\" type=\"button\">\n                            </button>\n                            <button aria-label=\"Week 5, 0 kilometres\" class=\"kestrel-chart-bar\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-5\" data-name=\"week 5 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"0 km\" data-week=\"Week 5\" style=\"--bar-height: 4px\" type=\"button\">\n                            </button>\n                            <button aria-label=\"Week 6, 0 kilometres\" class=\"kestrel-chart-bar\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-6\" data-name=\"week 6 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"0 km\" data-week=\"Week 6\" style=\"--bar-height: 4px\" type=\"button\">\n                            </button>\n                            <button aria-label=\"Week 7, 0 kilometres\" class=\"kestrel-chart-bar\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-7\" data-name=\"week 7 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"0 km\" data-week=\"Week 7\" style=\"--bar-height: 4px\" type=\"button\">\n                            </button>\n                            <button aria-label=\"Week 8, 0 kilometres\" class=\"kestrel-chart-bar\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-8\" data-name=\"week 8 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"0 km\" data-week=\"Week 8\" style=\"--bar-height: 4px\" type=\"button\">\n                            </button>\n                            <button aria-label=\"Week 9, 0 kilometres\" class=\"kestrel-chart-bar\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-9\" data-name=\"week 9 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"0 km\" data-week=\"Week 9\" style=\"--bar-height: 4px\" type=\"button\">\n                            </button>\n                            <button aria-label=\"Week 10, 0 kilometres\" class=\"kestrel-chart-bar\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-10\" data-name=\"week 10 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"0 km\" data-week=\"Week 10\" style=\"--bar-height: 4px\" type=\"button\">\n                            </button>\n                            <button aria-label=\"Week 11, 0 kilometres\" class=\"kestrel-chart-bar\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-11\" data-name=\"week 11 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"0 km\" data-week=\"Week 11\" style=\"--bar-height: 4px\" type=\"button\">\n                            </button>\n                            <button aria-label=\"This week, 3.42 kilometres\" aria-pressed=\"true\" class=\"kestrel-chart-bar is-current is-selected\" data-dynamic=\"true\" data-kid=\"1-4-1-3-4-2-3-12\" data-name=\"week 12 chart bar\" data-reason=\"aria-pressed and is-selected class toggled by script\" data-value=\"3.42 km\" data-week=\"This week\" style=\"--bar-height: 137px\" type=\"button\">\n                            </button>\n                        </div>\n                        <div aria-hidden=\"true\" class=\"kestrel-chart-months\" data-kid=\"1-4-1-3-4-2-4\" data-name=\"chart months row\">\n                            <span class=\"apr\" data-kid=\"1-4-1-3-4-2-4-1\" data-name=\"April label\">\n                                APR\n                            </span>\n                            <span class=\"may\" data-kid=\"1-4-1-3-4-2-4-2\" data-name=\"May label\">\n                                MAY\n                            </span>\n                            <span class=\"jun\" data-kid=\"1-4-1-3-4-2-4-3\" data-name=\"June label\">\n                                JUN\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </section>\n        <section aria-labelledby=\"sessions-tab\" class=\"kestrel-sessions-panel\" data-dynamic=\"true\" data-kid=\"1-4-2\" data-name=\"sessions panel\" data-reason=\"hidden state toggled by script\" hidden=\"\" id=\"sessions-panel\" role=\"tabpanel\">\n            <h2 class=\"kestrel-module-title\" data-kid=\"1-4-2-1\" data-name=\"sessions title\">\n                Sessions\n            </h2>\n            <p data-kid=\"1-4-2-2\" data-name=\"sessions empty state text\">\n                Your recorded sessions will appear here.\n            </p>\n        </section>\n    </main>\n    <nav aria-label=\"Primary navigation\" class=\"kestrel-bottom-nav\" data-kid=\"1-5\" data-name=\"bottom navigation bar\">\n        <button aria-label=\"Home\" class=\"kestrel-nav-item\" data-kid=\"1-5-1\" data-name=\"home nav button\" type=\"button\">\n            <span aria-hidden=\"true\" class=\"kestrel-nav-icon\" data-kid=\"1-5-1-1\" data-name=\"home icon container\">\n                <svg data-kid=\"1-5-1-1-1\" data-name=\"home icon\" fill=\"none\" height=\"23\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"23\">\n                    <path d=\"m3.5 10.4 8.5-6.8 8.5 6.8V20a1 1 0 0 1-1 1h-4.4v-6.2H8.9V21H4.5a1 1 0 0 1-1-1v-9.6Z\">\n                    </path>\n                </svg>\n            </span>\n            <span data-kid=\"1-5-1-2\" data-name=\"home label\">\n                Home\n            </span>\n        </button>\n        <button aria-label=\"Routes\" class=\"kestrel-nav-item\" data-kid=\"1-5-2\" data-name=\"routes nav button\" type=\"button\">\n            <span aria-hidden=\"true\" class=\"kestrel-nav-icon\" data-kid=\"1-5-2-1\" data-name=\"routes icon container\">\n                <svg data-kid=\"1-5-2-1-1\" data-name=\"routes icon\" fill=\"none\" height=\"23\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\" width=\"23\">\n                    <path d=\"m3 6.6 6.1-2.8 5.8 2.8L21 3.8v13.6l-6.1 2.8L9.1 17.4 3 20.2V6.6Z\">\n                    </path>\n                    <path d=\"M9.1 3.8v13.6M14.9 6.6v13.6\">\n                    </path>\n                </svg>\n            </span>\n            <span data-kid=\"1-5-2-2\" data-name=\"routes label\">\n                Routes\n            </span>\n        </button>\n        <button aria-label=\"Record\" class=\"kestrel-nav-item kestrel-nav-item is-record\" data-kid=\"1-5-3\" data-name=\"record nav button\" type=\"button\">\n            <span class=\"kestrel-nav-icon\" data-kid=\"1-5-3-1\" data-name=\"record icon container\">\n                <span aria-hidden=\"true\" class=\"kestrel-record-icon\" data-kid=\"1-5-3-1-1\" data-name=\"record central button visual\">\n                    <svg data-kid=\"1-5-3-1-1-1\" data-name=\"record icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"24\">\n                        <circle cx=\"12\" cy=\"12\" r=\"8.5\">\n                        </circle>\n                        <circle cx=\"12\" cy=\"12\" fill=\"currentColor\" r=\"4.1\" stroke=\"none\">\n                        </circle>\n                    </svg>\n                </span>\n            </span>\n            <span data-kid=\"1-5-3-2\" data-name=\"record label\">\n                Record\n            </span>\n        </button>\n        <button aria-label=\"Clubs\" class=\"kestrel-nav-item\" data-kid=\"1-5-4\" data-name=\"clubs nav button\" type=\"button\">\n            <span aria-hidden=\"true\" class=\"kestrel-nav-icon\" data-kid=\"1-5-4-1\" data-name=\"clubs icon container\">\n                <svg data-kid=\"1-5-4-1-1\" data-name=\"clubs icon\" fill=\"none\" height=\"23\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\" width=\"23\">\n                    <path d=\"m8.4 4.5 3.6 3.6-3.6 3.6-3.6-3.6 3.6-3.6Z\">\n                    </path>\n                    <path d=\"m15.6 4.5 3.6 3.6-3.6 3.6L12 8.1l3.6-3.6Z\">\n                    </path>\n                    <path d=\"m12 12.2 3.6 3.6-3.6 3.6-3.6-3.6 3.6-3.6Z\">\n                    </path>\n                </svg>\n            </span>\n            <span data-kid=\"1-5-4-2\" data-name=\"clubs label\">\n                Clubs\n            </span>\n        </button>\n        <button aria-current=\"page\" aria-label=\"You\" class=\"kestrel-nav-item is-current\" data-kid=\"1-5-5\" data-name=\"you nav button\" type=\"button\">\n            <span aria-hidden=\"true\" class=\"kestrel-nav-icon\" data-kid=\"1-5-5-1\" data-name=\"you icon container\">\n                <svg data-kid=\"1-5-5-1-1\" data-name=\"you icon\" fill=\"none\" height=\"23\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\" width=\"23\">\n                    <rect height=\"11.8\" rx=\"1.5\" width=\"13.6\" x=\"5.2\" y=\"8.1\">\n                    </rect>\n                    <path d=\"M8.2 5.1h7.6\">\n                    </path>\n                    <path d=\"M9 13.4v3.3M12 11.6v5.1M15 14v2.7\">\n                    </path>\n                </svg>\n            </span>\n            <span data-kid=\"1-5-5-2\" data-name=\"you label\">\n                You\n            </span>\n        </button>\n    </nav>\n    <div aria-hidden=\"true\" class=\"kestrel-safe-footer\" data-kid=\"1-6\" data-name=\"footer area\">\n        <span class=\"kestrel-home-indicator\" data-kid=\"1-6-1\" data-name=\"home indicator\">\n        </span>\n    </div>\n</div>\n<script>\n    (() => {\n    const root = document.querySelector('.kestrel-redesign');\n    if (!root) return;\n\n    const tabs = Array.from(root.querySelectorAll('[role=\"tab\"]'));\n    const panels = Array.from(root.querySelectorAll('[role=\"tabpanel\"]'));\n    const activateTab = (tab) => {\n      tabs.forEach((item) => {\n        const active = item === tab;\n        item.setAttribute('aria-selected', String(active));\n        item.tabIndex = active ? 0 : -1;\n      });\n      panels.forEach((panel) => {\n        panel.hidden = panel.id !== tab.getAttribute('aria-controls');\n      });\n    };\n    tabs.forEach((tab, index) => {\n      tab.addEventListener('click', () => activateTab(tab));\n      tab.addEventListener('keydown', (event) => {\n        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;\n        event.preventDefault();\n        const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : (index - 1 + tabs.length) % tabs.length;\n        tabs[next].focus();\n        activateTab(tabs[next]);\n      });\n    });\n\n    const focusModule = root.querySelector('#focus-module');\n    const editButton = root.querySelector('#edit-focus');\n    editButton?.addEventListener('click', () => {\n      const editing = editButton.getAttribute('aria-pressed') !== 'true';\n      editButton.setAttribute('aria-pressed', String(editing));\n      focusModule?.classList.toggle('is-editing', editing);\n    });\n\n    const activityButton = root.querySelector('#activity-button');\n    const activityMenu = root.querySelector('#activity-menu');\n    const activityOption = root.querySelector('.kestrel-activity-option');\n    const closeActivity = () => {\n      if (!activityButton || !activityMenu) return;\n      activityButton.setAttribute('aria-expanded', 'false');\n      activityMenu.hidden = true;\n    };\n    activityButton?.addEventListener('click', (event) => {\n      event.stopPropagation();\n      const open = activityButton.getAttribute('aria-expanded') === 'true';\n      activityButton.setAttribute('aria-expanded', String(!open));\n      if (activityMenu) activityMenu.hidden = open;\n    });\n    activityOption?.addEventListener('click', () => {\n      activityButton?.setAttribute('aria-pressed', 'true');\n      closeActivity();\n    });\n    document.addEventListener('click', (event) => {\n      if (activityMenu && !activityMenu.contains(event.target) && event.target !== activityButton) closeActivity();\n    });\n\n    const note = root.querySelector('#chart-note');\n    const chartPlot = root.querySelector('.kestrel-chart-plot');\n    const bars = Array.from(root.querySelectorAll('.kestrel-chart-bar'));\n    const positionNote = (bar) => {\n      if (!note || !chartPlot || !bar) return;\n      const plotRect = chartPlot.getBoundingClientRect();\n      const barRect = bar.getBoundingClientRect();\n      const halfNote = note.offsetWidth / 2;\n      const barCenter = barRect.left - plotRect.left + (barRect.width / 2);\n      const safeCenter = Math.max(halfNote + 2, Math.min(plotRect.width - halfNote - 2, barCenter));\n      note.style.left = `${safeCenter}px`;\n      note.style.right = 'auto';\n      note.style.transform = 'translateX(-50%)';\n    };\n    bars.forEach((bar) => {\n      bar.addEventListener('click', () => {\n        bars.forEach((item) => {\n          item.classList.remove('is-selected');\n          item.removeAttribute('aria-pressed');\n        });\n        bar.classList.add('is-selected');\n        bar.setAttribute('aria-pressed', 'true');\n        if (note) note.textContent = `${bar.dataset.week} · ${bar.dataset.value}`;\n        positionNote(bar);\n      });\n    });\n    const initialBar = bars.find((bar) => bar.classList.contains('is-selected'));\n    if (initialBar) requestAnimationFrame(() => positionNote(initialBar));\n  })();\n</script>\n",
